<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.Core.Function</PackageId>
    <Description>Fuaran.Core.Function — the artifact-function protocol (Phase 181): generic signature / apply / curry / compose over a domain-witness record, under the three laws — totality (bounded iteration only), hygiene (lexical hole-addressing, capture-avoiding), and a mandatory two-axis effect/determinism signature joined componentwise through composition. FSharp.Core only.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Function.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.Core.Tree\Fuaran.Core.Tree.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Ops\Fuaran.Core.Ops.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Wire\Fuaran.Core.Wire.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
