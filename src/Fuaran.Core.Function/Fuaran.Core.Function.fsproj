<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.Core.Function</PackageId>
    <Description>Fuaran.Core.Function — the artifact-function protocol (Phase 181): generic signature / apply / curry / compose over a domain-witness record, under the three laws — totality (bounded iteration only), hygiene (lexical hole-addressing, capture-avoiding), and a mandatory two-axis effect/determinism signature joined componentwise through composition. FSharp.Core only.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Effect.fs" />
    <Compile Include="SeamCodec.fs" />
    <Compile Include="Space.fs" />
    <Compile Include="Function.fs" />
    <Compile Include="Deferred.fs" />
    <Compile Include="Policy.fs" />
    <Compile Include="KeyedRegistry.fs" />
    <Compile Include="Capability.fs" />
    <Compile Include="FunctionRegistry.fs" />
    <Compile Include="ContentPack.fs" />
    <Compile Include="CapabilityPipeline.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Phase 316: the query registry sits behind the same internal keyed-registry helper
         (`KeyedRegistry`) as the two registries in this package. -->
    <InternalsVisibleTo Include="Fuaran.Core.Query" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.Core.Tree\Fuaran.Core.Tree.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Ops\Fuaran.Core.Ops.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Wire\Fuaran.Core.Wire.fsproj" />
    <!-- Phase 318: the seams' capturing dispatch journals through the keyed capture journal. -->
    <ProjectReference Include="..\Fuaran.Core.OpStream\Fuaran.Core.OpStream.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
