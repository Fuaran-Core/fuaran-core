<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.Core.Unit</PackageId>
    <Description>Fuaran.Core.Unit — a unit is a value: the runtime dimension algebra over a stated subset of UCUM (the SI base units and the gram, the SI prefixes, the SI derived units, a stated set of non-SI units) and ISO 4217 currencies, each currency a dimension of its own. One canonical text per unit, typed parse refusals naming the token and its position, `mul`/`div`/`pow`, `compatible`, and the exact conversion factor between compatible units as a rational. No project references; FSharp.Core only, Fable-clean.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Unit.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
