<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.Core.Wire</PackageId>
    <Description>Fuaran.Core.Wire — the "kind"-tag / camelCase wire-envelope discipline, Fable-clean encode helpers + portable decode combinators (one parser and one decode layer on .NET and Fable, with typed refusals), and the conformance-corpus tooling (manifest + round-trip/reject runner + coverage gate). Per-kind cases stay domain-side. FSharp.Core only.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="JVal.fs" />
    <Compile Include="FloatLayout.fs" />
    <Compile Include="Json.fs" />
    <Compile Include="DecodePath.fs" />
    <Compile Include="DecodeError.fs" />
    <Compile Include="Decoder.fs" />
    <Compile Include="Canonical.fs" />
    <Compile Include="Versioning.fs" />
    <Compile Include="Corpus.fs" />
    <Compile Include="CodecDeclarationFault.fs" />
    <Compile Include="Codec.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Phase 531: the escape, the UTF-8 and UTF-16 rules, the string-token and number grammar the
         scanner reads by, the encoding profiles and the xorshift32 kernel `Corpus.genJVal` draws from
         live in the text kernel below this package (DECISIONS.md D2 as amended). -->
    <ProjectReference Include="..\Fuaran.Core.Text\Fuaran.Core.Text.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The wire fuzz generator's sample (`Corpus.genJVal`) is internal, and the conformance kit's
         `fuzz/*` parity rows read it (Phase 495), from a `NoInlining` function (D129). -->
    <InternalsVisibleTo Include="Fuaran.Core.Conformance" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <!-- Fable-compile-only (no-op on .NET); powers the `FloatLayout` `[<Emit>]`. -->
    <PackageReference Include="Fable.Core" />
  </ItemGroup>
</Project>
