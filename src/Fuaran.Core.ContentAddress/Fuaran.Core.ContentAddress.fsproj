<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.Core.ContentAddress</PackageId>
    <Description>Fuaran.Core.ContentAddress — the content address of a wire value: the typed `Digest` (from Fuaran.Core.Tree) of a value's canonical text under a NAMED encoding profile (Fuaran.Core.Wire's `Canonical`), and of stored text only when it is canonical under that profile. The one package that references both the renderer and the hash, so neither has to reference the other. FSharp.Core only, Fable-clean.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ContentAddress.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- DECISIONS.md D122 (route B): the renderer and the hash live in two packages D2 keeps apart;
         this package is the edge between them, and `Tree` grants it `Digest`'s internal constructor. -->
    <ProjectReference Include="..\Fuaran.Core.Tree\Fuaran.Core.Tree.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Wire\Fuaran.Core.Wire.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
