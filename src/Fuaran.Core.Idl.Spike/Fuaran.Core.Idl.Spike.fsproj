<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Spike-stage (Phase 316): the mini UI IDL + authored corpus trees. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Generated.fs is emitted by Fuaran.Core.Idl.Gen (Phase 317 increment 2). Compiling it
         here is the proof that the generated F# is valid; a drift guard keeps it in sync. -->
    <Compile Include="Generated.fs" />
    <Compile Include="Spike.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.Core.Idl\Fuaran.Core.Idl.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Wire\Fuaran.Core.Wire.fsproj" />
    <!-- Phase 317 increment 5 — the generated `nodeWitness` is a `NodeWitness<Node, string>`
         (defined in Fuaran.Core.Tree), so the generated module needs Tree in scope. -->
    <ProjectReference Include="..\Fuaran.Core.Tree\Fuaran.Core.Tree.fsproj" />
    <!-- Phase 317 increment 6 — the generated `runValidator` scaffold wires Fuaran.Core.Validator. -->
    <ProjectReference Include="..\Fuaran.Core.Validator\Fuaran.Core.Validator.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
