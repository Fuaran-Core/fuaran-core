<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.Core.Conformance</PackageId>
    <Description>Fuaran.Core.Conformance — a property-based law kit a domain runs against its own witness to certify it conforms to the Fuaran.Core op algebra + op-stream: apply totality, canApply≡apply, apply∘invert=identity, verifyChain, and replay determinism. FSharp.Core only (a deterministic uint32 xorshift32 generator, no FsCheck), Fable-clean.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Phase 297 — the verdict and adequacy types (`LawResult`, `CaseCount`, `AdequacyClass`),
         moved out of SampleAdequacy.fs unchanged, FIRST; then the law-family roster, which
         declares each family's adequacy class and refusal verdict on the family's own record and
         carries strings, not laws, so it depends on nothing but those types; then the guard,
         whose census is a projection of the roster. The roster sat LAST until this phase, where
         appending kept it clear of every family; it moved because the guard reads it, and it
         still depends on no family. -->
    <Compile Include="LawResult.fs" />
    <Compile Include="Families.fs" />
    <!-- Phase 121 — the sample-adequacy guard. Ahead of every family, because every family
         declares its demands through it, and it deliberately depends on no family it guards. -->
    <Compile Include="SampleAdequacy.fs" />
    <!-- Phase 297 — the kit is split by topic behind a facade. `ConfRng` (the generator) and the
         witness records come first because every family reads them; `LawKit` (the runner —
         internal) next; then the eight topic modules, each internal, in an order that is free
         except where one family runs another (`SurfaceLaws` last of them only by habit); and
         `Conformance.fs` LAST — the public facade of one-line forwards plus `certify` /
         `certifyStream`, whose bodies the suite reads to derive which families are base-run. -->
    <Compile Include="ConfRng.fs" />
    <Compile Include="ConformanceWitnesses.fs" />
    <Compile Include="LawKit.fs" />
    <Compile Include="TreeLaws.fs" />
    <Compile Include="KeyedApplyLaws.fs" />
    <Compile Include="StreamLaws.fs" />
    <Compile Include="IntegrityLaws.fs" />
    <Compile Include="ConcurrencyLaws.fs" />
    <Compile Include="SeamLaws.fs" />
    <Compile Include="FunctionLaws.fs" />
    <Compile Include="PropagationLaws.fs" />
    <Compile Include="SurfaceLaws.fs" />
    <Compile Include="Conformance.fs" />
    <!-- Phase 102 — the null-tolerant read family. Independent of the op-algebra law kit
         above (it drives Fuaran.Core.Wire's parser only), so it is appended at the end. -->
    <Compile Include="WireNullTolerance.fs" />
    <!-- Phase 100 — the fold-confluence pack (N-lane arrival-order invariance). After
         Conformance.fs: it reads `ConfRng` and `ConformanceReport` from there, and `LawResult`
         plus the adequacy guard from SampleAdequacy.fs above.
         Independent of the null-tolerance family beside it; the order between those two is
         free, so each simply keeps the position it arrived in. -->
    <Compile Include="FoldConfluence.fs" />
    <!-- Phase 99's incremental-evaluation family (IncrementalDelta.fs) ships from
         Fuaran.Core.DataFrame.Conformance since Phase 257 (DECISIONS.md D68), with every other
         family that reads the dataframe layer; that package is produced by the compute
         repository since Phase 258 (D66). -->
    <!-- Phase 217 — the cross-pipeline VALUE table, public. It lived in the repository's own Fable
         smoke until the Fable compiler left this repository; a consumer that owns a Fable toolchain
         now compiles it from this package's `fable/` sources and diffs `ParityVectors.lines ()`
         between the two pipelines. Here, not in a test project, because the transpiled side has to
         COMPUTE the vectors and sees this repository only as packages. It reads `ConfRng` from
         Conformance.fs and carries no law, so it sits before the roster and depends on nothing
         after it. -->
    <Compile Include="ParityVectors.fs" />
    <!-- Phase 287 — the string-escape vector family: pins the D2 copies of `Wire.Json.escape` in
         OpStream and OpStream.Dag byte-identical to the original. A vector family with a runner
         (the WireNullTolerance shape), not a `LawResult` family, so it carries no roster row. -->
    <Compile Include="StringEscapeVectors.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.Core.Tree\Fuaran.Core.Tree.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Ops\Fuaran.Core.Ops.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.OpStream\Fuaran.Core.OpStream.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.OpStream.Dag\Fuaran.Core.OpStream.Dag.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Column\Fuaran.Core.Column.fsproj" />
    <!-- Phase 257 — no reference to Fuaran.Core.DataFrame or Fuaran.Core.Column.Ops. The families
         over them ship from Fuaran.Core.DataFrame.Conformance, produced by the compute repository
         since Phase 258, and the boundary test in tests/Fuaran.Core.Tests refuses either reference
         here (DECISIONS.md D66, D68). -->
    <ProjectReference Include="..\Fuaran.Core.Query\Fuaran.Core.Query.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Function\Fuaran.Core.Function.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Validator\Fuaran.Core.Validator.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Projection\Fuaran.Core.Projection.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.AiSurface\Fuaran.Core.AiSurface.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Propagation\Fuaran.Core.Propagation.fsproj" />
    <!-- Phase 102 — declared explicitly for WireNullTolerance.fs. It already arrived
         transitively (via Column); a family that drives the parser directly should not
         depend on another project's reference list to keep doing so. -->
    <ProjectReference Include="..\Fuaran.Core.Wire\Fuaran.Core.Wire.fsproj" />
    <!-- Phase 291 — for ParityVectors.sanitiseSweep alone: the IDL's sanitisation floor is the one
         Fable-surface package whose VALUES the cross-pipeline table did not reach, and the table is
         the only place a value divergence under Fable is caught (DECISIONS.md D55). Idl depends on
         Wire alone, which is already here, so this adds one package to the kit's closure. -->
    <ProjectReference Include="..\Fuaran.Core.Idl\Fuaran.Core.Idl.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
