<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.Core.Conformance</PackageId>
    <Description>Fuaran.Core.Conformance — a property-based law kit a domain runs against its own witness to certify it conforms to the Fuaran.Core op algebra + op-stream: apply totality, canApply≡apply, apply∘invert=identity, verifyChain, and replay determinism. FSharp.Core only (a deterministic uint32-LCG generator, no FsCheck), Fable-clean.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Conformance.fs" />
    <!-- Phase 102 — the null-tolerant read family. Independent of the op-algebra law kit
         above (it drives Fuaran.Core.Wire's parser only), so it is appended at the end. -->
    <Compile Include="WireNullTolerance.fs" />
    <!-- Phase 100 — the fold-confluence pack (N-lane arrival-order invariance). After
         Conformance.fs: it reads `ConfRng`, `LawResult` and `ConformanceReport` from there.
         Independent of the null-tolerance family beside it; the order between those two is
         free, so each simply keeps the position it arrived in. -->
    <Compile Include="FoldConfluence.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.Core.Tree\Fuaran.Core.Tree.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Ops\Fuaran.Core.Ops.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.OpStream\Fuaran.Core.OpStream.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.OpStream.Dag\Fuaran.Core.OpStream.Dag.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Column\Fuaran.Core.Column.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.DataFrame\Fuaran.Core.DataFrame.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Column.Ops\Fuaran.Core.Column.Ops.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Query\Fuaran.Core.Query.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Function\Fuaran.Core.Function.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Validator\Fuaran.Core.Validator.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Projection\Fuaran.Core.Projection.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.AiSurface\Fuaran.Core.AiSurface.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Propagation\Fuaran.Core.Propagation.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Lease\Fuaran.Core.Lease.fsproj" />
    <!-- Phase 102 — declared explicitly for WireNullTolerance.fs. It already arrived
         transitively (via Column); a family that drives the parser directly should not
         depend on another project's reference list to keep doing so. -->
    <ProjectReference Include="..\Fuaran.Core.Wire\Fuaran.Core.Wire.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
