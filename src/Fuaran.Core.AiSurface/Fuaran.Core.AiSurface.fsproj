<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.Core.AiSurface</PackageId>
    <Description>Fuaran.Core.AiSurface — the generic AI-surface seam: a per-domain witness bundling read tools, the mutation-op emission catalogue (JSON schema per op kind), an NL→op pattern bank with a deterministic fast-path resolver, a proposals/approval flow with agent-readable rejection guidance, and proposal arbitration (which subset of N op-script proposals can land together against one base tree — batch canApply + greedy footprint independence, a deterministic total partition with typed rejections). All read-tool logic, pattern content, and policy rules stay domain-side; the core owns only the shapes. FSharp.Core + Fuaran.Core.Wire + Fuaran.Core.Ops only, Fable-clean.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AiSurface.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.Core.Wire\Fuaran.Core.Wire.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Ops\Fuaran.Core.Ops.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
