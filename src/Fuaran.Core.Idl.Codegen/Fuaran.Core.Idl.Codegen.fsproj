<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Split out of Fuaran.Core.Idl at 0.8.0 (Phase 97, DECISIONS.md D17). Packable,
         because D14 shipped the generator deliberately and named `Gen.fsharpModuleWith`
         as the call a second domain makes; un-publishing it here would withdraw that a
         day after it was granted. What the split changes is that a consumer now CHOOSES
         the generator rather than inheriting it with the model. -->
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.Core.Idl.Codegen</PackageId>
    <Description>Fuaran.Core.Idl.Codegen — the generation half of the IDL engine: the F# structural-layer emitter with its declared-support channel (docs, splices, host projections), the TypeScript encoder backend, the JSON-schema emitter, the scaffold writer, the codegen trust boundary (allowlisted `Custom` resolution, sanitisation applied before emission), and the stability diff classifier over two `idl.json` revisions. Build-time only and .NET-only — it emits source, so its contract is the shape of what it emits; the model, codec and sampler it reads ship separately as Fuaran.Core.Idl. FSharp.Core + Fuaran.Core.Idl + Fuaran.Core.Wire only.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- No Fable source distribution. The packable-project convention in
         Directory.Build.props ships every `.fs` under `fable/` so a Fable consumer compiles
         from source; that is exactly the promise this half cannot keep — `StringBuilder` and
         `CultureInfo.InvariantCulture` serve the TypeScript backend — and shipping the
         source anyway would offer a portability the smoke gate does not certify. -->
    <Content Remove="$(MSBuildProjectFile)" />
    <Content Remove="*.fs" />
    <Content Remove="Emit/*.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Phase 293 - the emitters, split behind the `Gen` facade: internal modules in dependency
         order, the facade last so it can forward to all of them and declare the published
         support types. -->
    <!-- Phase 402 - the one boundary this package reads Fuaran.Core.Idl's internals through, each
         lookup NoInlining (DECISIONS.md D129); first, so every emitter can call it. -->
    <Compile Include="Lookup.fs" />
    <Compile Include="Emit/Core.fs" />
    <Compile Include="Emit/Reach.fs" />
    <Compile Include="Emit/Annotations.fs" />
    <Compile Include="Emit/FSharpTypes.fs" />
    <Compile Include="Emit/FSharpDefaults.fs" />
    <Compile Include="Emit/FSharpDerive.fs" />
    <Compile Include="Emit/FSharpCodec.fs" />
    <Compile Include="Emit/JsonSchema.fs" />
    <Compile Include="Emit/TypeScriptCodec.fs" />
    <Compile Include="Emit/TypeScriptDeclarations.fs" />
    <Compile Include="Emit/TypeScriptDerived.fs" />
    <Compile Include="Emit/Scaffold.fs" />
    <Compile Include="Gen.fs" />
    <!-- Phase 114 - the declared-support record + host-prelude declaration as a
         canonical data document (`support.json`), so the second and third members of
         the regeneration triple travel with the vocabulary instead of existing only as
         F# source in whichever repo compiled the generator. Reads Gen.GenSupport, so
         after Codegen.fs, and AHEAD of Diff.fs since Phase 293, which reads a support
         document into the stability classifier's snapshot. -->
    <Compile Include="SupportArtifact.fs" />
    <Compile Include="Diff.fs" />
    <Compile Include="Trust.fs" />
    <!-- Phase 150 - the F* PROOF-MODEL target: the vocabulary's types, encoder and
         tag-dispatch decoder emitted as an F* module over the wire model the proof leg
         checks, together with the round-trip theorems over exactly those definitions.
         Reads the shared CodegenError channel declared in Codegen.fs, so after it;
         appended last (append-only registration). It emits nothing any host builds. -->
    <Compile Include="FStar.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.Core.Idl\Fuaran.Core.Idl.fsproj" />
    <ProjectReference Include="..\Fuaran.Core.Wire\Fuaran.Core.Wire.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
