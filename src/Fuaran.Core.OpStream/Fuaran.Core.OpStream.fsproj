<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.Core.OpStream</PackageId>
    <Description>Fuaran.Core.OpStream — append-only hash-chained op stream + deterministic replay + JSONL persistence, generic over an (apply, encode, decode) witness. The highest-genericity core layer; the linear spine the branching-DAG generalisation builds on. FSharp.Core only; Fable-clean on encode and decode alike - the one JSONL scanner (OpStream.Jsonl) is self-contained and runs under both pipelines.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Phase 296: one file per concern; Phase 332: each concern file also holds its members' bodies
         (an internal module), and OpStream.fs is the forwarding facade, compiled last. Jsonl.fs comes
         before the readers built on its scanner. The public surface is unchanged. -->
    <Compile Include="Actor.fs" />
    <Compile Include="Chain.fs" />
    <Compile Include="Jsonl.fs" />
    <Compile Include="Snapshot.fs" />
    <Compile Include="Capture.fs" />
    <Compile Include="Attributed.fs" />
    <Compile Include="OpStream.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
