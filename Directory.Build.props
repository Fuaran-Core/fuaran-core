<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Phase 294: an incomplete match over a closed union is an ERROR. The repository's promise rests
         on closed unions with exhaustive matching, and FS0025 was a warning nobody read twice
         (Phase 135's `Incremental.reasonString`, Phase 266's `(_, Anti)`). Escalated by number rather
         than by TreatWarningsAsErrors, which would turn every other warning into a gate the day a
         toolchain adds one. The extracted proof oracle switches FS0025 OFF in its own project file,
         with the reason beside it.
         FS0049 and FS0026 join it (DECISIONS.md D88): an uppercase identifier in a pattern that is
         not a case in scope binds a VARIABLE, so the arm is a silent catch-all that matches every
         value (`FoldConfluence.shapeTag` rendered all three conflict shapes as one once its union
         became `[<RequireQualifiedAccess>]`); and a rule that can never be matched is dead code,
         usually the arm that catch-all swallowed. Both were warnings a green build printed and
         nobody read. The oracle needs no exception for either: the extracted code raises neither. -->
    <WarningsAsErrors>$(WarningsAsErrors);FS0025;FS0049;FS0026</WarningsAsErrors>
    <WarnOn>3390;$(WarnOn)</WarnOn>
    <!-- What each version changed, and the class it was cut as, is the release ledger:
         docs/releases/<version>.md, one file per slot, indexed by docs/releases/README.md. -->
    <Version>0.36.0</Version>
    <Authors>Andrew J. Willshire</Authors>
    <Company>Diametrical Ltd</Company>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Copyright>Copyright 2026 Diametrical Ltd</Copyright>
    <PackageProjectUrl>https://github.com/Fuaran-Core/fuaran-core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Fuaran-Core/fuaran-core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>fuaran;typed-tree;ops;op-stream;conformance;fsharp;fable</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Phase 392: the stability record of the <Version> above, declared beside it so a downstream
         version check can read each heading against the tags: a heading whose next word after the
         version is DRAFT (the default marker) over a tagged version is reported there, as the
         `Release record` test family reports it here (STABILITY.md "Versioning policy"). Since
         Phase 397 the record is the ledger's index, which carries every slot's heading word for
         word; the `PackageRoster` family holds the index to the slot files. -->
    <FuaranStabilityRecord>docs/releases/README.md</FuaranStabilityRecord>
  </PropertyGroup>

  <!-- Phase 294: a package that can be checked and traced. `Deterministic` is the SDK default and is
       stated so a later edit cannot lose it quietly; `ContinuousIntegrationBuild` (CI only, never a
       local build, where it would hide real source paths from the debugger) normalises embedded source
       paths, which is the last of the three inputs DECISIONS.md D29 named for assembly byte-identity
       that a property can pin. SourceLink ships with the SDK for a GitHub `RepositoryUrl`; the symbols
       travel as a snupkg, so a consumer steps into Core from the registry's symbol server. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <!-- Unconditional: a property condition here would read IsPackable before the project body sets it,
       and the symbols only matter at pack time, which a non-packable project never reaches. -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <!-- Phase 254: every package carries its XML documentation file, so a consumer restoring from the
       registry reads the doc comments in the editor rather than only in this repository's sources.
       Without it the comments reached a consumer only through the `fable/` source copy, which an
       editor does not read for a referenced assembly. Scoped by the project's FOLDER, `src/`, for the
       reason the symbols group above is unconditional: `IsPackable` is not yet set when this file is
       read. The two scopes are one set because `PackageRosterTests` refuses a packable project
       outside `src/`, and `PackageDocsTests` refuses a package whose built assembly has no `.xml`
       beside it. -->
  <PropertyGroup Condition="'$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($(MSBuildProjectDirectory)))))' == 'src'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Fable source distribution. Every packable
       Core project ships its F# source + .fsproj under `fable/` in the package, so a
       Fable-compiled consumer (the Fuaran.UI client) compiles Core from source — alongside
       the `lib/` DLL for .NET. The standard dual-pack convention (Feliz / Thoth). The internal
       ProjectReferences become nuspec dependencies on pack; the dependency packages ship their
       own `fable/` source, so Fable resolves the whole Core graph transitively. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true' And '$(MSBuildProjectExtension)' == '.fsproj'">
    <Content Include="$(MSBuildProjectFile)" PackagePath="fable\" />
    <Content Include="*.fs" PackagePath="fable\" />
  </ItemGroup>
</Project>
