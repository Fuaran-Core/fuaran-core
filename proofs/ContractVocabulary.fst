module ContractVocabulary

open WireDecode

#set-options "--ext context_pruning"

(* ======================================================================================
   1. The closed string sets (`TEnum`) — a bare wire string, not an object.
   ====================================================================================== *)

type e_status =
  | C__e_status__Open
  | C__e_status__Closed

let enc_e_status (#num #flt: eqtype) (x: e_status) : Tot (jval num flt) =
  match x with
  | C__e_status__Open -> JStr "Open"
  | C__e_status__Closed -> JStr "Closed"

let dec_e_status (#num #flt: eqtype) (el: jval num flt) : Tot (outcome e_status) =
  match as_string el with
  | Error e -> Error e
  | Ok s ->
    if s = "Open" then Ok C__e_status__Open else
    if s = "Closed" then Ok C__e_status__Closed else
    Error ("unknown Status: " ^ s)

(* ======================================================================================
   1b. The wider data universe's leaves — a string-borne exact scalar (its string refined
       by its one canonical spelling) and a tuple of leaf slots (a JSON array). A set is
       its wire array and a keyed map its array of [key, value] tuples: the model carries
       the items in the encoder's order, and their canonical order over canonical bytes is
       the hosts' rule, which a model whose numbers are opaque cannot compute.
   ====================================================================================== *)

(* Phase 639 — the canonical spellings of the string-borne exact scalars (fuaran-core D251), read off
   a string's characters: the grammar every host reads, so the model's decoder refuses what theirs
   refuse. Each predicate is total and decides one spelling per value. *)
let txt_digit (c: FStar.Char.char) : bool =
  let n = FStar.Char.int_of_char c in
  48 <= n && n <= 57

let rec txt_all_digits (l: list FStar.Char.char) : bool =
  match l with
  | [] -> true
  | c :: t -> txt_digit c && txt_all_digits t

let txt_natural (l: list FStar.Char.char) : bool =
  match l with
  | [] -> false
  | [c] -> txt_digit c
  | c :: t -> txt_digit c && FStar.Char.int_of_char c <> 48 && txt_all_digits t

let rec txt_value (acc: nat) (l: list FStar.Char.char) : Tot nat (decreases l) =
  match l with
  | [] -> acc
  | c :: t ->
    let n = FStar.Char.int_of_char c in
    txt_value (acc * 10 + (if 48 <= n && n <= 57 then n - 48 else 0)) t

let rec txt_last_nonzero (l: list FStar.Char.char) : bool =
  match l with
  | [] -> false
  | [c] -> txt_digit c && FStar.Char.int_of_char c <> 48
  | _ :: t -> txt_last_nonzero t

let txt_fraction (most: nat) (l: list FStar.Char.char) : bool =
  List.Tot.length l <= most && txt_all_digits l && txt_last_nonzero l

let rec txt_split (l: list FStar.Char.char) : Tot (list FStar.Char.char & option (list FStar.Char.char)) =
  match l with
  | [] -> ([], None)
  | c :: t ->
    if FStar.Char.int_of_char c = 46 then ([], Some t)
    else (let (a, b) = txt_split t in (c :: a, b))

let txt_unsigned (l: list FStar.Char.char) : Tot (bool & list FStar.Char.char) =
  match l with
  | c :: t -> if FStar.Char.int_of_char c = 45 then (true, t) else (false, l)
  | [] -> (false, [])

let rec txt_pow10 (n: int) : Tot nat (decreases (if n <= 0 then 0 else n)) =
  if n <= 0 then 1 else 10 * txt_pow10 (n - 1)

let txt_bound (negative: bool) : nat =
  if negative then 9223372036854775808 else 9223372036854775807

let is_t_int64 (s: string) : bool =
  let (neg, body) = txt_unsigned (FStar.String.list_of_string s) in
  txt_natural body && not (neg && txt_value 0 body = 0) && txt_value 0 body <= txt_bound neg

let is_t_decimal (s: string) : bool =
  let (neg, body) = txt_unsigned (FStar.String.list_of_string s) in
  match txt_split body with
  | (ip, None) -> txt_natural ip && not (neg && txt_value 0 ip = 0)
  | (ip, Some fp) -> txt_natural ip && txt_all_digits fp && txt_last_nonzero fp

let txt_b64 (c: FStar.Char.char) : int =
  let n = FStar.Char.int_of_char c in
  if 65 <= n && n <= 90 then n - 65
  else if 97 <= n && n <= 122 then n - 71
  else if 48 <= n && n <= 57 then n + 4
  else if n = 43 then 62
  else if n = 47 then 63
  else -1

let txt_pad (c: FStar.Char.char) : bool = FStar.Char.int_of_char c = 61

let rec txt_base64 (l: list FStar.Char.char) : bool =
  match l with
  | [] -> true
  | [a; b; c; d] ->
    txt_b64 a >= 0 && txt_b64 b >= 0
    && (if txt_pad c then txt_pad d && txt_b64 b % 16 = 0
        else txt_b64 c >= 0 && (if txt_pad d then txt_b64 c % 4 = 0 else txt_b64 d >= 0))
  | a :: b :: c :: d :: rest ->
    txt_b64 a >= 0 && txt_b64 b >= 0 && txt_b64 c >= 0 && txt_b64 d >= 0 && txt_base64 rest
  | _ -> false

let is_t_bytes (s: string) : bool = txt_base64 (FStar.String.list_of_string s)

let txt_two (a b: FStar.Char.char) (most: int) : bool =
  txt_digit a && txt_digit b
  && (FStar.Char.int_of_char a - 48) * 10 + (FStar.Char.int_of_char b - 48) <= most

let is_t_time_of_day (s: string) : bool =
  match FStar.String.list_of_string s with
  | h1 :: h2 :: c1 :: m1 :: m2 :: c2 :: s1 :: s2 :: rest ->
    FStar.Char.int_of_char c1 = 58 && FStar.Char.int_of_char c2 = 58
    && txt_two h1 h2 23 && txt_two m1 m2 59 && txt_two s1 s2 59
    && (match rest with
        | [] -> true
        | d :: fp -> FStar.Char.int_of_char d = 46 && txt_fraction 7 fp)
  | _ -> false

let txt_strip_s (l: list FStar.Char.char) : option (list FStar.Char.char) =
  match List.Tot.rev l with
  | c :: t -> if FStar.Char.int_of_char c = 115 then Some (List.Tot.rev t) else None
  | [] -> None

let is_t_duration (s: string) : bool =
  match txt_strip_s (FStar.String.list_of_string s) with
  | None -> false
  | Some l ->
    let (neg, body) = txt_unsigned l in
    (match txt_split body with
     | (ip, None) ->
       txt_natural ip && not (neg && txt_value 0 ip = 0) && txt_value 0 ip * 10000000 <= txt_bound neg
     | (ip, Some fp) ->
       txt_natural ip && txt_fraction 7 fp
       && txt_value 0 ip * 10000000 + txt_value 0 fp * txt_pow10 (7 - List.Tot.length fp) <= txt_bound neg)

type t_decimal = s:string{is_t_decimal s}

let enc_t_decimal (#num #flt: eqtype) (x: t_decimal) : Tot (jval num flt) = JStr x

let dec_t_decimal (#num #flt: eqtype) (el: jval num flt) : Tot (outcome t_decimal) =
  match as_string el with
  | Error e -> Error e
  | Ok s -> if is_t_decimal s then Ok s else Error ("not a canonical t_decimal: " ^ s)

type t_bytes = s:string{is_t_bytes s}

let enc_t_bytes (#num #flt: eqtype) (x: t_bytes) : Tot (jval num flt) = JStr x

let dec_t_bytes (#num #flt: eqtype) (el: jval num flt) : Tot (outcome t_bytes) =
  match as_string el with
  | Error e -> Error e
  | Ok s -> if is_t_bytes s then Ok s else Error ("not a canonical t_bytes: " ^ s)

(* ======================================================================================
   2. The vocabulary's types — one mutual group, because a record may hold a union, a
      union a node, and a node a list of nodes. Records are single-constructor types
      rather than F* records so that two objects declaring a `label` cannot collide.
   ====================================================================================== *)

type node (num flt: eqtype) =
  | C__node__Node : id:string -> k:(vkind num flt) -> node num flt

and vkind (num flt: eqtype) =
  | C__vkind__GetArguments : id:(string) -> vkind num flt
  | C__vkind__GetResult : result:(r_order num flt) -> vkind num flt
  | C__vkind__ListResult : result:(list (r_order num flt)) -> vkind num flt
  | C__vkind__PlaceArguments : note:(option (string)) -> order:(r_order num flt) -> vkind num flt
  | C__vkind__PlaceResult : result:(string) -> vkind num flt
  | C__vkind__CancelArguments : id:(string) -> vkind num flt
  | C__vkind__WatchArguments : filter:(u_filter num flt) -> vkind num flt
  | C__vkind__WatchResult : result:(r_order num flt) -> vkind num flt
  | C__vkind__ExportArguments : vkind num flt
  | C__vkind__ExportResult : result:(t_bytes) -> vkind num flt

and r_order (num flt: eqtype) =
  | C__r_order__Mk : id:(string) -> total_:(t_decimal) -> r_order num flt

and u_filter (num flt: eqtype) =
  | C__u_filter__ByStatus : status:(e_status) -> u_filter num flt
  | C__u_filter__All : u_filter num flt

(* ======================================================================================
   3. The encoder — the discriminated envelope, keys in the vocabulary's canonical
      order. The model has no render step, so the object LITERAL is the canonical form.
      Recursion is on the MODEL value, where F*'s subterm order spans the whole family.
   ====================================================================================== *)

let rec enc_node (#num #flt: eqtype) (x: node num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__node__Node i k  ->
    JObj (("id", JStr i) :: ("kind", enc_vkind k) :: [])

and enc_vkind (#num #flt: eqtype) (x: vkind num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__vkind__GetArguments f0 ->
    JObj (("$type", JStr "GetArguments") :: ("id", JStr f0) :: [])
  | C__vkind__GetResult f0 ->
    JObj (("$type", JStr "GetResult") :: ("result", enc_r_order f0) :: [])
  | C__vkind__ListResult f0 ->
    JObj (("$type", JStr "ListResult") :: ("result", JArr (enc_items_l_r_order f0)) :: [])
  | C__vkind__PlaceArguments f0 f1 ->
    JObj (("$type", JStr "PlaceArguments") :: (match f0 with | None -> ("order", enc_r_order f1) :: [] | Some w -> ("note", JStr w) :: ("order", enc_r_order f1) :: []))
  | C__vkind__PlaceResult f0 ->
    JObj (("$type", JStr "PlaceResult") :: ("result", JStr f0) :: [])
  | C__vkind__CancelArguments f0 ->
    JObj (("$type", JStr "CancelArguments") :: ("id", JStr f0) :: [])
  | C__vkind__WatchArguments f0 ->
    JObj (("$type", JStr "WatchArguments") :: ("filter", enc_u_filter f0) :: [])
  | C__vkind__WatchResult f0 ->
    JObj (("$type", JStr "WatchResult") :: ("result", enc_r_order f0) :: [])
  | C__vkind__ExportArguments  ->
    JObj (("$type", JStr "ExportArguments") :: [])
  | C__vkind__ExportResult f0 ->
    JObj (("$type", JStr "ExportResult") :: ("result", enc_t_bytes f0) :: [])

and enc_r_order (#num #flt: eqtype) (x: r_order num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__r_order__Mk f0 f1 -> JObj (("id", JStr f0) :: ("total", enc_t_decimal f1) :: [])

and enc_u_filter (#num #flt: eqtype) (x: u_filter num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__u_filter__ByStatus f0 ->
    JObj (("$type", JStr "ByStatus") :: ("status", enc_e_status f0) :: [])
  | C__u_filter__All  ->
    JObj (("$type", JStr "All") :: [])

and enc_items_l_r_order (#num #flt: eqtype) (xs: list (r_order num flt)) : Tot (list (jval num flt)) (decreases xs) =
  match xs with
  | [] -> []
  | y :: t -> enc_r_order y :: enc_items_l_r_order t

(* ======================================================================================
   4. The tag-dispatch decoder. Every cross-type call goes through `get_prop`, whose
      RETURN-TYPE refinement (`jsize (Ok?.v r) < jsize el`) is the termination argument:
      a decoder that descends by NAME into a value it looked up has no syntactic one.
      Value decoders sit at tier 0 on `jsize`, walkers at tier 1 on `jsizes` / `fsize`.
   ====================================================================================== *)

let rec dec_node (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (node num flt)) (decreases %[(jsize el <: nat); 0]) =
  let oid : outcome string = str_field "id" el in
  let ok : outcome (vkind num flt) = (match get_prop "kind" el with | Error e -> Error e | Ok v -> dec_vkind v) in
  (match oid with | Error e -> Error e | Ok i -> (match ok with | Error e -> Error e | Ok k -> Ok (C__node__Node i k)))

and dec_vkind (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (vkind num flt)) (decreases %[(jsize el <: nat); 0]) =
  match str_field "$type" el with
  | Error e -> Error e
  | Ok tag ->
    if tag = "GetArguments" then
      let o0 : outcome (string) = (match get_prop "id" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__vkind__GetArguments f0))
    else
    if tag = "GetResult" then
      let o0 : outcome (r_order num flt) = (match get_prop "result" el with | Error e -> Error e | Ok v -> (match dec_r_order v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__vkind__GetResult f0))
    else
    if tag = "ListResult" then
      let o0 : outcome (list (r_order num flt)) = (match get_prop "result" el with | Error e -> Error e | Ok v -> (match v with | JArr ys -> (match dec_items_l_r_order [] ys with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected array, got " ^ kind_name other))) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__vkind__ListResult f0))
    else
    if tag = "PlaceArguments" then
      let o0 : outcome (option (string)) = (match get_prop "note" el with | Error _ -> Ok None | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok (Some w))) in
      let o1 : outcome (r_order num flt) = (match get_prop "order" el with | Error e -> Error e | Ok v -> (match dec_r_order v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__vkind__PlaceArguments f0 f1)))
    else
    if tag = "PlaceResult" then
      let o0 : outcome (string) = (match get_prop "result" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__vkind__PlaceResult f0))
    else
    if tag = "CancelArguments" then
      let o0 : outcome (string) = (match get_prop "id" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__vkind__CancelArguments f0))
    else
    if tag = "WatchArguments" then
      let o0 : outcome (u_filter num flt) = (match get_prop "filter" el with | Error e -> Error e | Ok v -> (match dec_u_filter v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__vkind__WatchArguments f0))
    else
    if tag = "WatchResult" then
      let o0 : outcome (r_order num flt) = (match get_prop "result" el with | Error e -> Error e | Ok v -> (match dec_r_order v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__vkind__WatchResult f0))
    else
    if tag = "ExportArguments" then
      Ok C__vkind__ExportArguments
    else
    if tag = "ExportResult" then
      let o0 : outcome (t_bytes) = (match get_prop "result" el with | Error e -> Error e | Ok v -> (match dec_t_bytes v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__vkind__ExportResult f0))
    else
    Error ("unknown kind: " ^ tag)

and dec_r_order (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (r_order num flt)) (decreases %[(jsize el <: nat); 0]) =
  let o0 : outcome (string) = (match get_prop "id" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
  let o1 : outcome (t_decimal) = (match get_prop "total" el with | Error e -> Error e | Ok v -> (match dec_t_decimal v with | Error e -> Error e | Ok w -> Ok w)) in
  (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__r_order__Mk f0 f1)))

and dec_u_filter (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (u_filter num flt)) (decreases %[(jsize el <: nat); 0]) =
  match str_field "$type" el with
  | Error e -> Error e
  | Ok tag ->
    if tag = "ByStatus" then
      let o0 : outcome (e_status) = (match get_prop "status" el with | Error e -> Error e | Ok v -> (match dec_e_status v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__u_filter__ByStatus f0))
    else
    if tag = "All" then
      Ok C__u_filter__All
    else
    Error ("unknown u_filter case: " ^ tag)

and dec_items_l_r_order (#num #flt: eqtype) (acc: list (r_order num flt)) (ys: list (jval num flt)) : Tot (outcome (list (r_order num flt))) (decreases %[(jsizes ys <: nat); 1]) =
  match ys with
  | [] -> Ok (rev acc)
  | y :: rest ->
    (match dec_r_order y with
     | Ok w -> dec_items_l_r_order (w :: acc) rest
     | Error e -> Error e)

