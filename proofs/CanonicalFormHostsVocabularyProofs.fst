  reveal_opaque (`%rd_node__Label__tip) (rd_node__Label__tip #num #flt (enc_node #num #flt x));
  match x with
  | C__node__Label i f0 f1 f2 -> (match f2 with | None -> lk_node__Label__tip__absent #num #flt x | Some _ -> lk_node__Label__tip__present #num #flt x)
  | _ -> ()

