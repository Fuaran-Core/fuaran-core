(* rv_r_spot__Mk__s — the value of `rd_r_spot__Mk__s` off the encoded object *)
let rv_r_spot__Mk__s (#num #flt: eqtype) (x: r_spot num flt) : Lemma (ensures (match x with | C__r_spot__Mk f0 f1 -> rd_r_spot__Mk__s #num #flt (enc_r_spot #num #flt x) == Ok f0)) =
  reveal_opaque (`%rd_r_spot__Mk__s) (rd_r_spot__Mk__s #num #flt (enc_r_spot #num #flt x));
  match x with
  | C__r_spot__Mk f0 f1 -> (match f0 with | None -> lk_r_spot__Mk__s__absent #num #flt x | Some _ -> lk_r_spot__Mk__s__present #num #flt x)

(* rv_r_spot__Mk__t — the value of `rd_r_spot__Mk__t` off the encoded object *)
let rv_r_spot__Mk__t (#num #flt: eqtype) (x: r_spot num flt) : Lemma (ensures (match x with | C__r_spot__Mk f0 f1 -> rd_r_spot__Mk__t #num #flt (enc_r_spot #num #flt x) == Ok f1)) =
  reveal_opaque (`%rd_r_spot__Mk__t) (rd_r_spot__Mk__t #num #flt (enc_r_spot #num #flt x));
  match x with
  | C__r_spot__Mk f0 f1 -> (match f1 with | None -> lk_r_spot__Mk__t__absent #num #flt x | Some _ -> lk_r_spot__Mk__t__present #num #flt x)

(* ======================================================================================
   3. THE ROUND TRIP. One mutual induction over the whole family, recursing on the MODEL
      value — F*'s subterm order spans a mutual inductive family, so each case needs only
      the sub-lemmas of the members it carries. ONE LEMMA PER CONSTRUCTOR: a wide one is
      proved by citing section 2's lookups, a member at a time, rather than by carrying
      its object shapes into this query.
   ====================================================================================== *)

let rec rt_node (#num #flt: eqtype) (x: node num flt) : Lemma (ensures dec_node (enc_node #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__node__Gate _ _ _ _ _ _ _ _ _ _ _ _ -> rt_node__Gate #num #flt x
  | C__node__Place _ _ _ _ _ _ -> rt_node__Place #num #flt x
  | C__node__Link__NoSource _ _ _ _ _ -> rt_node__Link__NoSource #num #flt x
  | C__node__Link__ByUrl _ _ _ _ _ _ -> rt_node__Link__ByUrl #num #flt x
  | C__node__Link__ByRef _ _ _ _ _ _ -> rt_node__Link__ByRef #num #flt x
  | C__node__Label _ _ _ _ -> rt_node__Label #num #flt x

and rt_node__Gate (#num #flt: eqtype) (x: node num flt) : Lemma (requires (C__node__Gate? x)) (ensures dec_node (enc_node #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__node__Gate i f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 ->
    rv_node__Gate__unit #num #flt x;
    rv_node__Gate__count #num #flt x;
    rv_node__Gate__open #num #flt x;
    rv_node__Gate__note #num #flt x;
    rv_node__Gate__fallback #num #flt x;
    (match f5 with | None -> (lk_node__Gate__tags__absent #num #flt x; lk_node__Gate__tags__as_labels #num #flt x) | Some _ -> lk_node__Gate__tags__present #num #flt x);
    rv_node__Gate__level #num #flt x;
    rv_node__Gate__alert #num #flt x;
    rv_node__Gate__mode #num #flt x;
    rv_node__Gate__hidden #num #flt x;
    rv_node__Gate__tip #num #flt x;
    (match f5 with | None -> () | Some w -> rt_items_l_str #num #flt [] w); rt_e_tone #num #flt f6

and rt_node__Place (#num #flt: eqtype) (x: node num flt) : Lemma (requires (C__node__Place? x)) (ensures dec_node (enc_node #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__node__Place i f0 f1 f2 f3 f4 ->
    (match f0 with | None -> (lk_node__Place__at__absent #num #flt x; lk_node__Place__at__as_position #num #flt x) | Some _ -> lk_node__Place__at__present #num #flt x);
    (match f1 with | None -> lk_node__Place__mark__absent #num #flt x | Some _ -> lk_node__Place__mark__present #num #flt x);
    (if f2 = (C__r_spot__Mk (Some "a") (Some "b")) then lk_node__Place__spot__absent #num #flt x else lk_node__Place__spot__present #num #flt x);
    rv_node__Place__hidden #num #flt x;
    rv_node__Place__tip #num #flt x;
    (match f0 with | None -> () | Some w -> rt_r_point #num #flt w); (match f1 with | None -> () | Some w -> rt_u_mark #num #flt w); rt_r_spot #num #flt f2

and rt_node__Link__NoSource (#num #flt: eqtype) (x: node num flt) : Lemma (requires (C__node__Link__NoSource? x)) (ensures dec_node (enc_node #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__node__Link__NoSource i f0 f1 f2 f3 ->
    rv_node__Link__NoSource__title #num #flt x;
    rv_node__Link__NoSource__hint #num #flt x;
    rv_node__Link__NoSource__hidden #num #flt x;
    rv_node__Link__NoSource__tip #num #flt x;
    pk_node__Link__NoSource__source #num #flt x

and rt_node__Link__ByUrl (#num #flt: eqtype) (x: node num flt) : Lemma (requires (C__node__Link__ByUrl? x)) (ensures dec_node (enc_node #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__node__Link__ByUrl i f0 f1 f2 f3 f4 ->
    rv_node__Link__ByUrl__title #num #flt x;
    rv_node__Link__ByUrl__hint #num #flt x;
    lk_node__Link__ByUrl__url #num #flt x;
    rv_node__Link__ByUrl__hidden #num #flt x;
    rv_node__Link__ByUrl__tip #num #flt x;
    pk_node__Link__ByUrl__source #num #flt x

and rt_node__Link__ByRef (#num #flt: eqtype) (x: node num flt) : Lemma (requires (C__node__Link__ByRef? x)) (ensures dec_node (enc_node #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__node__Link__ByRef i f0 f1 f2 f3 f4 ->
    rv_node__Link__ByRef__title #num #flt x;
    rv_node__Link__ByRef__hint #num #flt x;
    lk_node__Link__ByRef__ref #num #flt x;
    rv_node__Link__ByRef__hidden #num #flt x;
    rv_node__Link__ByRef__tip #num #flt x;
    pk_node__Link__ByRef__source #num #flt x

and rt_node__Label (#num #flt: eqtype) (x: node num flt) : Lemma (requires (C__node__Label? x)) (ensures dec_node (enc_node #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__node__Label i f0 f1 f2 ->
    rv_node__Label__hidden #num #flt x;
    rv_node__Label__tip #num #flt x;
    ()

and rt_r_point (#num #flt: eqtype) (x: r_point num flt) : Lemma (ensures dec_r_point (enc_r_point #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__r_point__Mk f0 f1 -> ()

and rt_u_mark (#num #flt: eqtype) (x: u_mark num flt) : Lemma (ensures dec_u_mark (enc_u_mark #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__u_mark__Pin _ _ -> rt_u_mark__Pin #num #flt x
  | C__u_mark__Dot -> rt_u_mark__Dot #num #flt x

and rt_u_mark__Pin (#num #flt: eqtype) (x: u_mark num flt) : Lemma (requires (C__u_mark__Pin? x)) (ensures dec_u_mark (enc_u_mark #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_mark__Pin f0 f1 -> (match f1 with | None -> () | Some w -> rt_r_point #num #flt w)

and rt_u_mark__Dot (#num #flt: eqtype) (x: u_mark num flt) : Lemma (requires (C__u_mark__Dot? x)) (ensures dec_u_mark (enc_u_mark #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_mark__Dot -> ()

and rt_r_spot (#num #flt: eqtype) (x: r_spot num flt) : Lemma (ensures dec_r_spot (enc_r_spot #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__r_spot__Mk f0 f1 ->
    rv_r_spot__Mk__s #num #flt x;
    rv_r_spot__Mk__t #num #flt x;
    ()

and rt_items_l_str (#num #flt: eqtype) (acc: list (string)) (xs: list (string)) : Lemma (ensures dec_items_l_str acc (enc_items_l_str #num #flt xs) == Ok (rev_app acc xs)) (decreases %[xs; 2]) =
  match xs with
  | [] -> ()
  | y :: t -> rt_items_l_str #num #flt (y :: acc) t

(* ======================================================================================
   4. TOTALITY. That the decoders type-check at `Tot` is the termination proof; what the
      lemma adds is that the outcome is exactly one of the two, for EVERY input — the
      failure classification is exhaustive rather than merely non-empty.
   ====================================================================================== *)

let dec_node_total (#num #flt: eqtype) (el: jval num flt)
  : Lemma (ensures (Ok? (dec_node el) \/ Error? (dec_node el)) /\
                   ~(Ok? (dec_node el) /\ Error? (dec_node el)))
  = ()

