let sk_r_spot__Mk__t__hit (#num #flt: eqtype) (e: option (jval num flt)) (rest: list (string & jval num flt)) : Lemma (requires (Some? e)) (ensures (find_field "t" (sfx_r_spot__Mk__t e rest) == Ok (Some?.v e)))
  = reveal_opaque (`%sfx_r_spot__Mk__t) (sfx_r_spot__Mk__t #num #flt e rest)
let sk_r_spot__Mk__t__none (#num #flt: eqtype) (e: option (jval num flt)) (rest: list (string & jval num flt)) : Lemma (requires (None? e)) (ensures (sfx_r_spot__Mk__t e rest == rest))
  = reveal_opaque (`%sfx_r_spot__Mk__t) (sfx_r_spot__Mk__t #num #flt e rest)

