(* rv_node__Label__hidden — the value of `rd_node__Label__hidden` off the encoded object *)
let rv_node__Label__hidden (#num #flt: eqtype) (x: node num flt) : Lemma (requires (C__node__Label? x)) (ensures (match x with | C__node__Label i f0 f1 f2 -> rd_node__Label__hidden #num #flt (enc_node #num #flt x) == Ok f1 | _ -> True)) =
  reveal_opaque (`%rd_node__Label__hidden) (rd_node__Label__hidden #num #flt (enc_node #num #flt x));
  match x with
  | C__node__Label i f0 f1 f2 -> (match f1 with | None -> (lk_node__Label__hidden__absent #num #flt x; lk_node__Label__hidden__as_is_hidden #num #flt x) | Some _ -> lk_node__Label__hidden__present #num #flt x)
  | _ -> ()

