  match x with
  | C__node__Gate i f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 ->
    let s10 = sfx_node__Gate__tip #num #flt (enc_opt_str #num #flt f10) ([]) in
    let s9 = sfx_node__Gate__hidden #num #flt (enc_opt_bool #num #flt f9) (s10) in
    let s8 = sfx_node__Gate__mode #num #flt (enc_dflt_str #num #flt ("auto") f8) (s9) in
    let s7 = sfx_node__Gate__alert #num #flt (enc_opt_str #num #flt f7) (s8) in
    let s6 = sfx_node__Gate__level #num #flt (enc_dflt_e_tone #num #flt (C__e_tone__Default) f6) (s7) in
    let s5 = sfx_node__Gate__tags #num #flt (enc_opt_l_str #num #flt f5) (s6) in
    let s4 = sfx_node__Gate__fallback #num #flt (enc_opt_str #num #flt f4) (s5) in
    let s3 = sfx_node__Gate__note #num #flt (enc_opt_str #num #flt f3) (s4) in
    let s2 = sfx_node__Gate__open #num #flt (enc_opt_bool #num #flt f2) (s3) in
    let s1 = sfx_node__Gate__count #num #flt (enc_opt_int #num #flt f1) (s2) in
    let s0 = sfx_node__Gate__unit #num #flt (enc_opt_str #num #flt f0) (s1) in
    sk_node__Gate__unit__hit #num #flt (enc_opt_str #num #flt f0) (s1)
  | _ -> ()
#pop-options

