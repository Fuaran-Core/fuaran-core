    JObj (("$type", JStr "Text") :: (match f0 with | None -> ("value", JStr f1) :: [] | Some w -> ("placeholder", JStr w) :: ("value", JStr f1) :: []))
  | C__u_field__Check f0 f1 ->
    JObj (("$type", JStr "Check") :: (match f0 with | None -> ("on", JBool f1) :: [] | Some w -> ("label", JStr w) :: ("on", JBool f1) :: []))

and enc_items_l_str (#num #flt: eqtype) (xs: list (string)) : Tot (list (jval num flt)) (decreases xs) =
  match xs with
  | [] -> []
  | y :: t -> JStr y :: enc_items_l_str t

and enc_items_l_l_str (#num #flt: eqtype) (xs: list (list (string))) : Tot (list (jval num flt)) (decreases xs) =
  match xs with
  | [] -> []
  | y :: t -> JArr (enc_items_l_str y) :: enc_items_l_l_str t

and enc_opt_str (#num #flt: eqtype) (o: option (string)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (JStr w)

and enc_opt_int (#num #flt: eqtype) (o: option (num)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (JInt w)

(* ======================================================================================
   4. The tag-dispatch decoder. Every cross-type call goes through `get_prop`, whose
      RETURN-TYPE refinement (`jsize (Ok?.v r) < jsize el`) is the termination argument:
      a decoder that descends by NAME into a value it looked up has no syntactic one.
      Value decoders sit at tier 0 on `jsize`, walkers at tier 1 on `jsizes` / `fsize`.
   ====================================================================================== *)

(* The READING of a presence-keyed union (D220.3): the cases whose key is present, less each
   whose key another present case synthesises. One left is that case; none is no case; two is
   the both-present refusal. A holder's decoder asks it of the holder's own object, and reads
   the picked case's members, and the members that case synthesises, off the same object. *)

type pk_u_row_identity =
  | PK__u_row_identity__RowKey
  | PK__u_row_identity__RowKeyField
  | PN__u_row_identity
  | PB__u_row_identity

[@@"opaque_to_smt"]
let pick_u_row_identity (#num #flt: eqtype) (el: jval num flt) : Tot pk_u_row_identity =
  let p0 = Ok? (get_prop "rowKey" el) in
  let p1 = Ok? (get_prop "rowKeyField" el) in
  let c0 = p0 in
  let c1 = p1 in
  if c0 then (if c1 then PB__u_row_identity else PK__u_row_identity__RowKey) else
  if c1 then PK__u_row_identity__RowKeyField else
  PN__u_row_identity

type pk_u_grid_rows =
  | PK__u_grid_rows__Source
  | PK__u_grid_rows__StaticRows
  | PN__u_grid_rows
  | PB__u_grid_rows

[@@"opaque_to_smt"]
let pick_u_grid_rows (#num #flt: eqtype) (el: jval num flt) : Tot pk_u_grid_rows =
  let p0 = Ok? (get_prop "source" el) in
  let p1 = Ok? (get_prop "staticRows" el) in
  let c0 = p0 && not (p1) in
  let c1 = p1 in
  if c0 then (if c1 then PB__u_grid_rows else PK__u_grid_rows__Source) else
  if c1 then PK__u_grid_rows__StaticRows else
  PN__u_grid_rows

let rec dec_node (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (node num flt)) (decreases %[(jsize el <: nat); 0]) =
  let oid : outcome string = str_field "id" el in
  let ok : outcome (vkind num flt) = (match get_prop "kind" el with | Error e -> Error e | Ok v -> dec_vkind v) in
  (match oid with | Error e -> Error e | Ok i -> (match ok with | Error e -> Error e | Ok k -> Ok (C__node__Node i k)))

and dec_vkind (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (vkind num flt)) (decreases %[(jsize el <: nat); 0]) =
  match str_field "$type" el with
  | Error e -> Error e
  | Ok tag ->
    if tag = "Grid" && pick_u_row_identity #num #flt el = PN__u_row_identity && pick_u_grid_rows #num #flt el = PK__u_grid_rows__Source then
      let o0 : outcome (option (string)) = rd_vkind__Grid__NoRowIdentity__Source__caption #num #flt el in
      let o1 : outcome (list (string)) = (match get_prop "columns" el with | Error e -> Error e | Ok v -> (match v with | JArr ys -> (match dec_items_l_str [] ys with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected array, got " ^ kind_name other))) in
      let o2 : outcome (option (num)) = rd_vkind__Grid__NoRowIdentity__Source__page_size #num #flt el in
      let o3 : outcome (option (string)) = rd_vkind__Grid__NoRowIdentity__Source__page_state_key #num #flt el in
      let o4 : outcome (u_feed num flt) = (match get_prop "source" el with | Error e -> Error e | Ok v -> (match dec_u_feed v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> (match o4 with | Error e -> Error e | Ok f4 -> Ok (C__vkind__Grid__NoRowIdentity__Source f0 f1 f2 f3 f4))))))
    else
    if tag = "Grid" && pick_u_row_identity #num #flt el = PN__u_row_identity && pick_u_grid_rows #num #flt el = PK__u_grid_rows__StaticRows then
      let o0 : outcome (option (string)) = rd_vkind__Grid__NoRowIdentity__StaticRows__caption #num #flt el in
      let o1 : outcome (list (string)) = (match get_prop "columns" el with | Error e -> Error e | Ok v -> (match v with | JArr ys -> (match dec_items_l_str [] ys with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected array, got " ^ kind_name other))) in
      let o2 : outcome (option (num)) = rd_vkind__Grid__NoRowIdentity__StaticRows__page_size #num #flt el in
      let o3 : outcome (option (string)) = rd_vkind__Grid__NoRowIdentity__StaticRows__page_state_key #num #flt el in
      let o4 : outcome (unit) = (match get_prop "source" el with | Error e -> Error e | Ok v -> (if v = (JObj [("$type", (JStr "Static")); ("value", (JArr []))]) then (let w = () in Ok w) else Error "a synthesised member at another value: source")) in
      let o5 : outcome (r_static_table num flt) = (match get_prop "staticRows" el with | Error e -> Error e | Ok v -> (match dec_r_static_table v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> (match o4 with | Error e -> Error e | Ok f4 -> (match o5 with | Error e -> Error e | Ok f5 -> Ok (C__vkind__Grid__NoRowIdentity__StaticRows f0 f1 f2 f3 f4 f5)))))))
    else
    if tag = "Grid" && pick_u_row_identity #num #flt el = PK__u_row_identity__RowKey && pick_u_grid_rows #num #flt el = PK__u_grid_rows__Source then
      let o0 : outcome (option (string)) = rd_vkind__Grid__RowKey__Source__caption #num #flt el in
      let o1 : outcome (list (string)) = (match get_prop "columns" el with | Error e -> Error e | Ok v -> (match v with | JArr ys -> (match dec_items_l_str [] ys with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected array, got " ^ kind_name other))) in
      let o2 : outcome (option (num)) = rd_vkind__Grid__RowKey__Source__page_size #num #flt el in
      let o3 : outcome (option (string)) = rd_vkind__Grid__RowKey__Source__page_state_key #num #flt el in
      let o4 : outcome (unit) = (match get_prop "rowKey" el with | Error e -> Error e | Ok v -> (let _ = v in let w = () in Ok w)) in
      let o5 : outcome (u_feed num flt) = (match get_prop "source" el with | Error e -> Error e | Ok v -> (match dec_u_feed v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> (match o4 with | Error e -> Error e | Ok f4 -> (match o5 with | Error e -> Error e | Ok f5 -> Ok (C__vkind__Grid__RowKey__Source f0 f1 f2 f3 f4 f5)))))))
    else
    if tag = "Grid" && pick_u_row_identity #num #flt el = PK__u_row_identity__RowKey && pick_u_grid_rows #num #flt el = PK__u_grid_rows__StaticRows then
      let o0 : outcome (option (string)) = rd_vkind__Grid__RowKey__StaticRows__caption #num #flt el in
      let o1 : outcome (list (string)) = (match get_prop "columns" el with | Error e -> Error e | Ok v -> (match v with | JArr ys -> (match dec_items_l_str [] ys with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected array, got " ^ kind_name other))) in
      let o2 : outcome (option (num)) = rd_vkind__Grid__RowKey__StaticRows__page_size #num #flt el in
      let o3 : outcome (option (string)) = rd_vkind__Grid__RowKey__StaticRows__page_state_key #num #flt el in
      let o4 : outcome (unit) = (match get_prop "rowKey" el with | Error e -> Error e | Ok v -> (let _ = v in let w = () in Ok w)) in
      let o5 : outcome (unit) = (match get_prop "source" el with | Error e -> Error e | Ok v -> (if v = (JObj [("$type", (JStr "Static")); ("value", (JArr []))]) then (let w = () in Ok w) else Error "a synthesised member at another value: source")) in
      let o6 : outcome (r_static_table num flt) = (match get_prop "staticRows" el with | Error e -> Error e | Ok v -> (match dec_r_static_table v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> (match o4 with | Error e -> Error e | Ok f4 -> (match o5 with | Error e -> Error e | Ok f5 -> (match o6 with | Error e -> Error e | Ok f6 -> Ok (C__vkind__Grid__RowKey__StaticRows f0 f1 f2 f3 f4 f5 f6))))))))
    else
    if tag = "Grid" && pick_u_row_identity #num #flt el = PK__u_row_identity__RowKeyField && pick_u_grid_rows #num #flt el = PK__u_grid_rows__Source then
      let o0 : outcome (option (string)) = rd_vkind__Grid__RowKeyField__Source__caption #num #flt el in
      let o1 : outcome (list (string)) = (match get_prop "columns" el with | Error e -> Error e | Ok v -> (match v with | JArr ys -> (match dec_items_l_str [] ys with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected array, got " ^ kind_name other))) in
      let o2 : outcome (option (num)) = rd_vkind__Grid__RowKeyField__Source__page_size #num #flt el in
      let o3 : outcome (option (string)) = rd_vkind__Grid__RowKeyField__Source__page_state_key #num #flt el in
      let o4 : outcome (string) = (match get_prop "rowKeyField" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      let o5 : outcome (u_feed num flt) = (match get_prop "source" el with | Error e -> Error e | Ok v -> (match dec_u_feed v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> (match o4 with | Error e -> Error e | Ok f4 -> (match o5 with | Error e -> Error e | Ok f5 -> Ok (C__vkind__Grid__RowKeyField__Source f0 f1 f2 f3 f4 f5)))))))
    else
    if tag = "Grid" && pick_u_row_identity #num #flt el = PK__u_row_identity__RowKeyField && pick_u_grid_rows #num #flt el = PK__u_grid_rows__StaticRows then
      let o0 : outcome (option (string)) = rd_vkind__Grid__RowKeyField__StaticRows__caption #num #flt el in
      let o1 : outcome (list (string)) = (match get_prop "columns" el with | Error e -> Error e | Ok v -> (match v with | JArr ys -> (match dec_items_l_str [] ys with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected array, got " ^ kind_name other))) in
      let o2 : outcome (option (num)) = rd_vkind__Grid__RowKeyField__StaticRows__page_size #num #flt el in
      let o3 : outcome (option (string)) = rd_vkind__Grid__RowKeyField__StaticRows__page_state_key #num #flt el in
      let o4 : outcome (string) = (match get_prop "rowKeyField" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      let o5 : outcome (unit) = (match get_prop "source" el with | Error e -> Error e | Ok v -> (if v = (JObj [("$type", (JStr "Static")); ("value", (JArr []))]) then (let w = () in Ok w) else Error "a synthesised member at another value: source")) in
      let o6 : outcome (r_static_table num flt) = (match get_prop "staticRows" el with | Error e -> Error e | Ok v -> (match dec_r_static_table v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> (match o4 with | Error e -> Error e | Ok f4 -> (match o5 with | Error e -> Error e | Ok f5 -> (match o6 with | Error e -> Error e | Ok f6 -> Ok (C__vkind__Grid__RowKeyField__StaticRows f0 f1 f2 f3 f4 f5 f6))))))))
    else
    if tag = "Form" then
      let o0 : outcome (u_field num flt) = (match get_prop "field" el with | Error e -> Error e | Ok v -> (match dec_u_field v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__vkind__Form f0))
    else
    Error ("unknown kind, or no case of a presence-keyed union it holds: " ^ tag)

and dec_u_feed (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (u_feed num flt)) (decreases %[(jsize el <: nat); 0]) =
  match str_field "$type" el with
  | Error e -> Error e
  | Ok tag ->
    if tag = "Static" then
      let o0 : outcome (jval num flt) = (match get_prop "value" el with | Error e -> Error e | Ok v -> (let w = v in Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__u_feed__Static f0))
    else
    if tag = "State" then
      let o0 : outcome (string) = (match get_prop "key" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__u_feed__State f0))
    else
    Error ("unknown u_feed case: " ^ tag)

and dec_r_static_table (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (r_static_table num flt)) (decreases %[(jsize el <: nat); 0]) =
  let o0 : outcome (list (string)) = (match get_prop "headers" el with | Error e -> Error e | Ok v -> (match v with | JArr ys -> (match dec_items_l_str [] ys with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected array, got " ^ kind_name other))) in
  let o1 : outcome (list (list (string))) = (match get_prop "rows" el with | Error e -> Error e | Ok v -> (match v with | JArr ys -> (match dec_items_l_l_str [] ys with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected array, got " ^ kind_name other))) in
  (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__r_static_table__Mk f0 f1)))

and dec_u_field (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (u_field num flt)) (decreases %[(jsize el <: nat); 0]) =
  match str_field "$type" el with
  | Error e -> Error e
  | Ok tag ->
    if tag = "Text" then
      let o0 : outcome (option (string)) = (match get_prop "placeholder" el with | Error _ -> Ok None | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok (Some w))) in
      let o1 : outcome (string) = (match get_prop "value" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__u_field__Text f0 f1)))
    else
    if tag = "Check" then
      let o0 : outcome (option (string)) = (match get_prop "label" el with | Error _ -> Ok None | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok (Some w))) in
      let o1 : outcome (bool) = (match get_prop "on" el with | Error e -> Error e | Ok v -> (match as_bool v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__u_field__Check f0 f1)))
    else
    Error ("unknown u_field case: " ^ tag)

and dec_items_l_str (#num #flt: eqtype) (acc: list (string)) (ys: list (jval num flt)) : Tot (outcome (list (string))) (decreases %[(jsizes ys <: nat); 1]) =
  match ys with
  | [] -> Ok (rev acc)
  | y :: rest ->
    (match as_string y with
     | Ok w -> dec_items_l_str (w :: acc) rest
     | Error e -> Error e)

and dec_items_l_l_str (#num #flt: eqtype) (acc: list (list (string))) (ys: list (jval num flt)) : Tot (outcome (list (list (string)))) (decreases %[(jsizes ys <: nat); 1]) =
  match ys with
  | [] -> Ok (rev acc)
  | y :: rest ->
    (match (match y with | JArr zs -> dec_items_l_str [] zs | other -> Error ("expected array, got " ^ kind_name other)) with
     | Ok w -> dec_items_l_l_str (w :: acc) rest
     | Error e -> Error e)

