  match x with
  | C__vkind__Notify f0 f1 f2 f3 ->
    let s3 = sfx_vkind__Notify__tone #num #flt (enc_dflt_e_tone #num #flt (C__e_tone__Default) f3) ([]) in
    let s2 = sfx_vkind__Notify__payload #num #flt (enc_dflt_json #num #flt ((JObj [])) f2) (s3) in
    let s1 = sfx_vkind__Notify__heading #num #flt (enc_opt_str #num #flt f1) (s2) in
    let s0 = sfx_vkind__Notify__args #num #flt (enc_dflt_m_str #num #flt ([]) f0 (JObj (enc_entries_m_str f0))) (s1) in
    sk_vkind__Notify__args__skip #num #flt "payload" (enc_dflt_m_str #num #flt ([]) f0 (JObj (enc_entries_m_str f0))) (s1);
    sk_vkind__Notify__heading__skip #num #flt "payload" (enc_opt_str #num #flt f1) (s2);
    sk_vkind__Notify__payload__none #num #flt (enc_dflt_json #num #flt ((JObj [])) f2) (s3);
    sk_vkind__Notify__tone__skip #num #flt "payload" (enc_dflt_e_tone #num #flt (C__e_tone__Default) f3) ([])
  | _ -> ()
#pop-options

(* lk_vkind__Notify__tone__present — tone not at its default *)
#push-options "--fuel 8 --ifuel 4"
let lk_vkind__Notify__tone__present (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (match x with | C__vkind__Notify f0 f1 f2 f3 -> not (f3 = C__e_tone__Default) | _ -> false)) (ensures (match x with | C__vkind__Notify f0 f1 f2 f3 -> get_prop "tone" (enc_vkind #num #flt x) == Ok (enc_e_tone f3) | _ -> True)) =
  match x with
  | C__vkind__Notify f0 f1 f2 f3 ->
    let s3 = sfx_vkind__Notify__tone #num #flt (enc_dflt_e_tone #num #flt (C__e_tone__Default) f3) ([]) in
    let s2 = sfx_vkind__Notify__payload #num #flt (enc_dflt_json #num #flt ((JObj [])) f2) (s3) in
    let s1 = sfx_vkind__Notify__heading #num #flt (enc_opt_str #num #flt f1) (s2) in
    let s0 = sfx_vkind__Notify__args #num #flt (enc_dflt_m_str #num #flt ([]) f0 (JObj (enc_entries_m_str f0))) (s1) in
    sk_vkind__Notify__args__skip #num #flt "tone" (enc_dflt_m_str #num #flt ([]) f0 (JObj (enc_entries_m_str f0))) (s1);
    sk_vkind__Notify__heading__skip #num #flt "tone" (enc_opt_str #num #flt f1) (s2);
    sk_vkind__Notify__payload__skip #num #flt "tone" (enc_dflt_json #num #flt ((JObj [])) f2) (s3);
    sk_vkind__Notify__tone__hit #num #flt (enc_dflt_e_tone #num #flt (C__e_tone__Default) f3) ([])
  | _ -> ()
#pop-options

(* lk_vkind__Notify__tone__absent — tone at its default *)
#push-options "--fuel 8 --ifuel 4"
let lk_vkind__Notify__tone__absent (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (match x with | C__vkind__Notify f0 f1 f2 f3 -> f3 = C__e_tone__Default | _ -> false)) (ensures (Error? (get_prop "tone" (enc_vkind #num #flt x)))) =
  match x with
  | C__vkind__Notify f0 f1 f2 f3 ->
    let s3 = sfx_vkind__Notify__tone #num #flt (enc_dflt_e_tone #num #flt (C__e_tone__Default) f3) ([]) in
    let s2 = sfx_vkind__Notify__payload #num #flt (enc_dflt_json #num #flt ((JObj [])) f2) (s3) in
    let s1 = sfx_vkind__Notify__heading #num #flt (enc_opt_str #num #flt f1) (s2) in
    let s0 = sfx_vkind__Notify__args #num #flt (enc_dflt_m_str #num #flt ([]) f0 (JObj (enc_entries_m_str f0))) (s1) in
    sk_vkind__Notify__args__skip #num #flt "tone" (enc_dflt_m_str #num #flt ([]) f0 (JObj (enc_entries_m_str f0))) (s1);
    sk_vkind__Notify__heading__skip #num #flt "tone" (enc_opt_str #num #flt f1) (s2);
    sk_vkind__Notify__payload__skip #num #flt "tone" (enc_dflt_json #num #flt ((JObj [])) f2) (s3);
    sk_vkind__Notify__tone__none #num #flt (enc_dflt_e_tone #num #flt (C__e_tone__Default) f3) ([])
  | _ -> ()
#pop-options

(* rv_vkind__Notify__heading — the value of `rd_vkind__Notify__heading` off the encoded object *)
let rv_vkind__Notify__heading (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__Notify? x)) (ensures (match x with | C__vkind__Notify f0 f1 f2 f3 -> rd_vkind__Notify__heading #num #flt (enc_vkind #num #flt x) == Ok f1 | _ -> True)) =
  reveal_opaque (`%rd_vkind__Notify__heading) (rd_vkind__Notify__heading #num #flt (enc_vkind #num #flt x));
  match x with
  | C__vkind__Notify f0 f1 f2 f3 -> (match f1 with | None -> (lk_vkind__Notify__heading__absent #num #flt x; lk_vkind__Notify__heading__as_title #num #flt x) | Some _ -> lk_vkind__Notify__heading__present #num #flt x)
  | _ -> ()

(* rv_vkind__Notify__payload — the value of `rd_vkind__Notify__payload` off the encoded object *)
let rv_vkind__Notify__payload (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__Notify? x)) (ensures (match x with | C__vkind__Notify f0 f1 f2 f3 -> rd_vkind__Notify__payload #num #flt (enc_vkind #num #flt x) == Ok f2 | _ -> True)) =
  reveal_opaque (`%rd_vkind__Notify__payload) (rd_vkind__Notify__payload #num #flt (enc_vkind #num #flt x));
  match x with
  | C__vkind__Notify f0 f1 f2 f3 -> (if f2 = (JObj []) then lk_vkind__Notify__payload__absent #num #flt x else lk_vkind__Notify__payload__present #num #flt x)
  | _ -> ()

(* rv_vkind__Notify__tone — the value of `rd_vkind__Notify__tone` off the encoded object *)
let rv_vkind__Notify__tone (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__Notify? x)) (ensures (match x with | C__vkind__Notify f0 f1 f2 f3 -> rd_vkind__Notify__tone #num #flt (enc_vkind #num #flt x) == Ok f3 | _ -> True)) =
  reveal_opaque (`%rd_vkind__Notify__tone) (rd_vkind__Notify__tone #num #flt (enc_vkind #num #flt x));
  match x with
  | C__vkind__Notify f0 f1 f2 f3 -> rt_e_tone #num #flt f3; (if f3 = C__e_tone__Default then lk_vkind__Notify__tone__absent #num #flt x else lk_vkind__Notify__tone__present #num #flt x)
  | _ -> ()

(* The suffixes of C__vkind__Place — each revealed once, here, and cited by name below. *)
let sk_vkind__Place__at__skip (#num #flt: eqtype) (n: string) (e: option (jval num flt)) (rest: list (string & jval num flt)) : Lemma (requires (n <> "at")) (ensures (find_field n (sfx_vkind__Place__at e rest) == find_field n rest))
  = reveal_opaque (`%sfx_vkind__Place__at) (sfx_vkind__Place__at #num #flt e rest)
let sk_vkind__Place__at__hit (#num #flt: eqtype) (e: option (jval num flt)) (rest: list (string & jval num flt)) : Lemma (requires (Some? e)) (ensures (find_field "at" (sfx_vkind__Place__at e rest) == Ok (Some?.v e)))
  = reveal_opaque (`%sfx_vkind__Place__at) (sfx_vkind__Place__at #num #flt e rest)
let sk_vkind__Place__at__none (#num #flt: eqtype) (e: option (jval num flt)) (rest: list (string & jval num flt)) : Lemma (requires (None? e)) (ensures (sfx_vkind__Place__at e rest == rest))
  = reveal_opaque (`%sfx_vkind__Place__at) (sfx_vkind__Place__at #num #flt e rest)
let sk_vkind__Place__mark__skip (#num #flt: eqtype) (n: string) (e: option (jval num flt)) (rest: list (string & jval num flt)) : Lemma (requires (n <> "mark")) (ensures (find_field n (sfx_vkind__Place__mark e rest) == find_field n rest))
  = reveal_opaque (`%sfx_vkind__Place__mark) (sfx_vkind__Place__mark #num #flt e rest)
let sk_vkind__Place__mark__hit (#num #flt: eqtype) (e: option (jval num flt)) (rest: list (string & jval num flt)) : Lemma (requires (Some? e)) (ensures (find_field "mark" (sfx_vkind__Place__mark e rest) == Ok (Some?.v e)))
  = reveal_opaque (`%sfx_vkind__Place__mark) (sfx_vkind__Place__mark #num #flt e rest)
let sk_vkind__Place__mark__none (#num #flt: eqtype) (e: option (jval num flt)) (rest: list (string & jval num flt)) : Lemma (requires (None? e)) (ensures (sfx_vkind__Place__mark e rest == rest))
  = reveal_opaque (`%sfx_vkind__Place__mark) (sfx_vkind__Place__mark #num #flt e rest)

(* lk_vkind__Place__at__present — at present *)
#push-options "--fuel 8 --ifuel 4"
let lk_vkind__Place__at__present (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (match x with | C__vkind__Place f0 f1 -> Some? f0 | _ -> false)) (ensures (match x with | C__vkind__Place f0 f1 -> get_prop "at" (enc_vkind #num #flt x) == Ok (enc_r_point (Some?.v f0)) | _ -> True)) =
  match x with
  | C__vkind__Place f0 f1 ->
    let s1 = sfx_vkind__Place__mark #num #flt (enc_opt_u_mark #num #flt f1) ([]) in
    let s0 = sfx_vkind__Place__at #num #flt (enc_opt_r_point #num #flt f0) (s1) in
    sk_vkind__Place__at__hit #num #flt (enc_opt_r_point #num #flt f0) (s1)
  | _ -> ()
#pop-options

(* lk_vkind__Place__at__absent — at absent *)
#push-options "--fuel 8 --ifuel 4"
let lk_vkind__Place__at__absent (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (match x with | C__vkind__Place f0 f1 -> None? f0 | _ -> false)) (ensures (Error? (get_prop "at" (enc_vkind #num #flt x)))) =
  match x with
  | C__vkind__Place f0 f1 ->
    let s1 = sfx_vkind__Place__mark #num #flt (enc_opt_u_mark #num #flt f1) ([]) in
    let s0 = sfx_vkind__Place__at #num #flt (enc_opt_r_point #num #flt f0) (s1) in
    sk_vkind__Place__at__none #num #flt (enc_opt_r_point #num #flt f0) (s1);
    sk_vkind__Place__mark__skip #num #flt "at" (enc_opt_u_mark #num #flt f1) ([])
  | _ -> ()
#pop-options

(* lk_vkind__Place__at__as_position — at read as 'position', a spelling the encoder never writes *)
#push-options "--fuel 8 --ifuel 4"
let lk_vkind__Place__at__as_position (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__Place? x)) (ensures (Error? (get_prop "position" (enc_vkind #num #flt x)))) =
  match x with
  | C__vkind__Place f0 f1 ->
    let s1 = sfx_vkind__Place__mark #num #flt (enc_opt_u_mark #num #flt f1) ([]) in
    let s0 = sfx_vkind__Place__at #num #flt (enc_opt_r_point #num #flt f0) (s1) in
    sk_vkind__Place__at__skip #num #flt "position" (enc_opt_r_point #num #flt f0) (s1);
    sk_vkind__Place__mark__skip #num #flt "position" (enc_opt_u_mark #num #flt f1) ([])
  | _ -> ()
#pop-options

(* lk_vkind__Place__mark__present — mark present *)
#push-options "--fuel 8 --ifuel 4"
let lk_vkind__Place__mark__present (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (match x with | C__vkind__Place f0 f1 -> Some? f1 | _ -> false)) (ensures (match x with | C__vkind__Place f0 f1 -> get_prop "mark" (enc_vkind #num #flt x) == Ok (enc_u_mark (Some?.v f1)) | _ -> True)) =
  match x with
  | C__vkind__Place f0 f1 ->
    let s1 = sfx_vkind__Place__mark #num #flt (enc_opt_u_mark #num #flt f1) ([]) in
    let s0 = sfx_vkind__Place__at #num #flt (enc_opt_r_point #num #flt f0) (s1) in
    sk_vkind__Place__at__skip #num #flt "mark" (enc_opt_r_point #num #flt f0) (s1);
    sk_vkind__Place__mark__hit #num #flt (enc_opt_u_mark #num #flt f1) ([])
  | _ -> ()
#pop-options

(* lk_vkind__Place__mark__absent — mark absent *)
#push-options "--fuel 8 --ifuel 4"
let lk_vkind__Place__mark__absent (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (match x with | C__vkind__Place f0 f1 -> None? f1 | _ -> false)) (ensures (Error? (get_prop "mark" (enc_vkind #num #flt x)))) =
  match x with
  | C__vkind__Place f0 f1 ->
    let s1 = sfx_vkind__Place__mark #num #flt (enc_opt_u_mark #num #flt f1) ([]) in
    let s0 = sfx_vkind__Place__at #num #flt (enc_opt_r_point #num #flt f0) (s1) in
    sk_vkind__Place__at__skip #num #flt "mark" (enc_opt_r_point #num #flt f0) (s1);
    sk_vkind__Place__mark__none #num #flt (enc_opt_u_mark #num #flt f1) ([])
  | _ -> ()
#pop-options

(* ======================================================================================
   3. THE ROUND TRIP. One mutual induction over the whole family, recursing on the MODEL
      value — F*'s subterm order spans a mutual inductive family, so each case needs only
      the sub-lemmas of the members it carries. ONE LEMMA PER CONSTRUCTOR: a wide one is
      proved by citing section 2's lookups, a member at a time, rather than by carrying
      its object shapes into this query.
   ====================================================================================== *)

let rec rt_node (#num #flt: eqtype) (x: node num flt) : Lemma (ensures dec_node (enc_node #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__node__Node i k -> rt_vkind #num #flt k

and rt_vkind (#num #flt: eqtype) (x: vkind num flt) : Lemma (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__vkind__Grid _ _ -> rt_vkind__Grid #num #flt x
  | C__vkind__Select _ _ _ _ -> rt_vkind__Select #num #flt x
  | C__vkind__Notify _ _ _ _ -> rt_vkind__Notify #num #flt x
  | C__vkind__Place _ _ -> rt_vkind__Place #num #flt x

and rt_vkind__Grid (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__Grid? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__Grid f0 f1 ->
    rv_vkind__Grid__cols #num #flt x;
    rv_vkind__Grid__template #num #flt x;
    ()

and rt_vkind__Select (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__Select? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__Select f0 f1 f2 f3 ->
    rv_vkind__Select__multiple #num #flt x;
    (if f1 = [] then (lk_vkind__Select__options__absent #num #flt x; lk_vkind__Select__options__as_source #num #flt x; lk_vkind__Select__options__as_suggestions #num #flt x) else lk_vkind__Select__options__present #num #flt x);
    rv_vkind__Select__value #num #flt x;
    (match f3 with | None -> lk_vkind__Select__values__absent #num #flt x | Some _ -> lk_vkind__Select__values__present #num #flt x);
    rt_items_l_str #num #flt [] f1; (match f3 with | None -> () | Some w -> rt_items_l_str #num #flt [] w)

and rt_vkind__Notify (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__Notify? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__Notify f0 f1 f2 f3 ->
    (if f0 = [] then lk_vkind__Notify__args__absent #num #flt x else lk_vkind__Notify__args__present #num #flt x);
    rv_vkind__Notify__heading #num #flt x;
    rv_vkind__Notify__payload #num #flt x;
    rv_vkind__Notify__tone #num #flt x;
    rt_entries_m_str #num #flt [] f0; rt_e_tone #num #flt f3

and rt_vkind__Place (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__Place? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__Place f0 f1 ->
    (match f0 with | None -> (lk_vkind__Place__at__absent #num #flt x; lk_vkind__Place__at__as_position #num #flt x) | Some _ -> lk_vkind__Place__at__present #num #flt x);
    (match f1 with | None -> lk_vkind__Place__mark__absent #num #flt x | Some _ -> lk_vkind__Place__mark__present #num #flt x);
    (match f0 with | None -> () | Some w -> rt_r_point #num #flt w); (match f1 with | None -> () | Some w -> rt_u_mark #num #flt w)

and rt_r_point (#num #flt: eqtype) (x: r_point num flt) : Lemma (ensures dec_r_point (enc_r_point #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__r_point__Mk f0 f1 -> ()

and rt_u_mark (#num #flt: eqtype) (x: u_mark num flt) : Lemma (ensures dec_u_mark (enc_u_mark #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__u_mark__Pin _ _ -> rt_u_mark__Pin #num #flt x
  | C__u_mark__Dot -> rt_u_mark__Dot #num #flt x

and rt_u_mark__Pin (#num #flt: eqtype) (x: u_mark num flt) : Lemma (requires (C__u_mark__Pin? x)) (ensures dec_u_mark (enc_u_mark #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_mark__Pin f0 f1 -> (match f0 with | None -> () | Some w -> rt_r_point #num #flt w)

and rt_u_mark__Dot (#num #flt: eqtype) (x: u_mark num flt) : Lemma (requires (C__u_mark__Dot? x)) (ensures dec_u_mark (enc_u_mark #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_mark__Dot -> ()

and rt_items_l_str (#num #flt: eqtype) (acc: list (string)) (xs: list (string)) : Lemma (ensures dec_items_l_str acc (enc_items_l_str #num #flt xs) == Ok (rev_app acc xs)) (decreases %[xs; 2]) =
  match xs with
  | [] -> ()
  | y :: t -> rt_items_l_str #num #flt (y :: acc) t

and rt_entries_m_str (#num #flt: eqtype) (acc: list (string & string)) (es: list (string & string)) : Lemma (ensures dec_entries_m_str acc (enc_entries_m_str #num #flt es) == Ok (rev_app acc es)) (decreases %[es; 2]) =
  match es with
  | [] -> ()
  | (k, v) :: t -> rt_entries_m_str #num #flt ((k, v) :: acc) t

(* ======================================================================================
   4. TOTALITY. That the decoders type-check at `Tot` is the termination proof; what the
      lemma adds is that the outcome is exactly one of the two, for EVERY input — the
      failure classification is exhaustive rather than merely non-empty.
   ====================================================================================== *)

let dec_node_total (#num #flt: eqtype) (el: jval num flt)
  : Lemma (ensures (Ok? (dec_node el) \/ Error? (dec_node el)) /\
                   ~(Ok? (dec_node el) /\ Error? (dec_node el)))
  = ()

