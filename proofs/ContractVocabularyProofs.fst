(*
   ContractVocabularyProofs — generated from the same walk that
   emits `ContractVocabulary.fst`, over
   the CONTRACT fixture — `tests/Fuaran.Core.Tests.Fixtures/ContractsIdl.fs`, the `orders`
   contract as `FStarTarget.contractTypes` derives its vocabulary: a kind of each
   method's arguments and a kind of each result (fuaran-core Phase 644).
   DO NOT EDIT: `dotnet run --project tools/Fuaran.Core.Tools -- render fstar` regenerates
   it, and the `Proofs.Vocabulary` family holds this file to a fresh generation from that
   source — a vocabulary that moves without a regeneration is VOCABULARY DRIFT, and
   `proofs/check.ps1` names it.

   WHAT IS PROVED, and why it is GENERATED rather than written.

   Phase 135 proved `decode (encode n) == Ok n` for a hand-written four-case REFERENCE
   vocabulary, and was explicit about the boundary: a theorem about a reference vocabulary
   is not a theorem about the one a host actually decodes. The real vocabulary has dozens
   of kinds — 10 of this one's 11 are modelled — and it grows. A HAND-WRITTEN proof over
   it would be a theorem about the vocabulary as it stood on the day it was written, which
   is the same defect one release later. So the proof script is emitted by the walk that
   emits the model: a kind added to the IDL re-proves itself at the next `check.ps1`, and a
   kind whose encoder and decoder disagree fails it.

     - `rt_node` and the family beside it — THE ROUND TRIP. For every value of every
       modelled type, decoding its encoding returns that value: `dec_node (enc_node x) ==
       Ok x`, at every depth, through every list, map, optional member and omit-default.
     - `dec_node_total` — TOTALITY, and the exclusivity of the outcome. That the decoders
       type-check at `Tot` is the termination proof; the lemma states that every input
       reaches exactly one of `Ok` / `Error` and never both.

   THE SHAPE — one lemma per constructor, and the presence split LINEAR in the conditional
   members (fuaran-core Phase 182, replacing Phase 168's per-pattern split).
   A constructor with k conditional members (optional, or omitted at its default) encodes
   to 2^k object shapes, and a lemma over the whole constructor puts all of them in ONE
   query. Measured at a twenty-kind vocabulary whose node envelope carried five optional
   members (Phase 150): the node lemma's 65-goal query failed a `--quake` seed at the leg's
   rlimit, the widest kind's arm failed outright, and raising the rlimit turned failing into
   grinding. `--split_queries` is not settable as a pragma on the pinned prover, so the
   isolation is in the emitted shape instead. `rt_<T>` is the round trip over a type — for a
   type with several constructors, a CASE SPLIT whose arms cite `rt_<T>__<Ctor>`, one
   constructor's arm alone under `C__<T>__<Ctor>? x`. A constructor with
   2 or more conditional members is proved from its members' LOOKUPS instead of in one
   query: `lk_<T>__<Ctor>__<member>` reads one key off the encoded object with every OTHER
   conditional member left free — one lemma for a member that is always emitted, two for a
   conditional one — and the constructor's lemma cites them a member at a time. That is
   2k + r' lemmas where Phase 168 emitted 2^k, and it is why a sixteen-conditional kind
   costs thirty-odd lemmas rather than 65,536 (`fuaran#1754` measured 71,722 of them in a
   114 MB script at the UI vocabulary). The family is still one mutual induction — a kind's
   children reach `rt_node` — on the lexicographic measure `%[x; tier]`; the lookups are
   NOT in it, since they recurse on nothing, which is what lets each carry the scoped
   `--fuel` its own walk needs. The rlimit precedent Phase 150 took (`--z3rlimit 200` in
   this file) stays retired: the leg's own rlimit is what these are checked under, and a
   query that wants more is a query the split has failed to isolate.

   WHAT IS NOT PROVED HERE, and why. The `wf` CHARACTERISATION — `Ok? (dec el) == wf el`,
   which Phase 135 carries for its hand-written reference vocabulary — is not restated over
   the generated vocabulary. The only predicate this emitter could generate from the same
   walk is the decoder's own accept set restated clause for clause, and `Ok? (dec el) ==
   (that predicate) el` is then a theorem about two renderings of one definition — true,
   and empty. A characterisation worth the name needs an INDEPENDENT statement of the
   accept set (a schema-shaped predicate), which is a model-sized artefact of its own;
   Fuaran.Core's `vocabulary-round-trip` row records the halt. The round trip covers one direction
   (everything the encoder can produce is read back exactly); the characterisation of what
   ELSE is accepted is not covered, and is named here rather than left to be assumed.

   ONE COST OPTION IS PART OF THE ARTEFACT: `--ext context_pruning` is set below for the
   reason the model module's header gives at greater length — a mutual induction over the
   whole family would otherwise carry the whole family in every query. If this module is
   ever slow enough to want investigating, check it is still in force first.

   Apache-2.0, like everything beside it.
*)
module ContractVocabularyProofs

open WireDecode
open ContractVocabulary

#set-options "--ext context_pruning"

(* ======================================================================================
   1. The closed string sets. Each is a finite match on distinct literals, so its round
      trip is definitional — stated anyway, because the family below calls it by name.
   ====================================================================================== *)

let rt_e_status (#num #flt: eqtype) (x: e_status) : Lemma (ensures dec_e_status (enc_e_status #num #flt x) == Ok x) = ()
let rt_t_decimal (#num #flt: eqtype) (x: t_decimal) : Lemma (ensures dec_t_decimal #num #flt (enc_t_decimal #num #flt x) == Ok x) = ()
let rt_t_bytes (#num #flt: eqtype) (x: t_bytes) : Lemma (ensures dec_t_bytes #num #flt (enc_t_bytes #num #flt x) == Ok x) = ()

(* ======================================================================================
   2. THE PRESENCE LOOKUPS. One member's key read off the encoded object, with every
      conditional member other than that one left FREE — so a constructor with k of them
      costs 2k + r' lemmas rather than 2^k, and no query has to hold more than one key's
      walk. Each carries its own scoped fuel: `find_field` pushes through a key it is not
      looking for, and the default two unfoldings do not reach past the second. Emitted
      only for a constructor at or above the split threshold, and only from its first
      conditional member on — everything before that is reached without a branch.
   ====================================================================================== *)

(* ======================================================================================
   3. THE ROUND TRIP. One mutual induction over the whole family, recursing on the MODEL
      value — F*'s subterm order spans a mutual inductive family, so each case needs only
      the sub-lemmas of the members it carries. ONE LEMMA PER CONSTRUCTOR: a wide one is
      proved by citing section 2's lookups, a member at a time, rather than by carrying
      its object shapes into this query.
   ====================================================================================== *)

let rec rt_node (#num #flt: eqtype) (x: node num flt) : Lemma (ensures dec_node (enc_node #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__node__Node i k -> rt_vkind #num #flt k

and rt_vkind (#num #flt: eqtype) (x: vkind num flt) : Lemma (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__vkind__GetArguments _ -> rt_vkind__GetArguments #num #flt x
  | C__vkind__GetResult _ -> rt_vkind__GetResult #num #flt x
  | C__vkind__ListResult _ -> rt_vkind__ListResult #num #flt x
  | C__vkind__PlaceArguments _ _ -> rt_vkind__PlaceArguments #num #flt x
  | C__vkind__PlaceResult _ -> rt_vkind__PlaceResult #num #flt x
  | C__vkind__CancelArguments _ -> rt_vkind__CancelArguments #num #flt x
  | C__vkind__WatchArguments _ -> rt_vkind__WatchArguments #num #flt x
  | C__vkind__WatchResult _ -> rt_vkind__WatchResult #num #flt x
  | C__vkind__ExportArguments -> rt_vkind__ExportArguments #num #flt x
  | C__vkind__ExportResult _ -> rt_vkind__ExportResult #num #flt x

and rt_vkind__GetArguments (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__GetArguments? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__GetArguments f0 -> ()

and rt_vkind__GetResult (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__GetResult? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__GetResult f0 -> rt_r_order #num #flt f0

and rt_vkind__ListResult (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__ListResult? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__ListResult f0 -> rt_items_l_r_order #num #flt [] f0

and rt_vkind__PlaceArguments (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__PlaceArguments? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__PlaceArguments f0 f1 -> rt_r_order #num #flt f1

and rt_vkind__PlaceResult (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__PlaceResult? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__PlaceResult f0 -> ()

and rt_vkind__CancelArguments (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__CancelArguments? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__CancelArguments f0 -> ()

and rt_vkind__WatchArguments (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__WatchArguments? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__WatchArguments f0 -> rt_u_filter #num #flt f0

and rt_vkind__WatchResult (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__WatchResult? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__WatchResult f0 -> rt_r_order #num #flt f0

and rt_vkind__ExportArguments (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__ExportArguments? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__ExportArguments -> ()

and rt_vkind__ExportResult (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__ExportResult? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__ExportResult f0 -> rt_t_bytes #num #flt f0

and rt_r_order (#num #flt: eqtype) (x: r_order num flt) : Lemma (ensures dec_r_order (enc_r_order #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__r_order__Mk f0 f1 -> rt_t_decimal #num #flt f1

and rt_u_filter (#num #flt: eqtype) (x: u_filter num flt) : Lemma (ensures dec_u_filter (enc_u_filter #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__u_filter__ByStatus _ -> rt_u_filter__ByStatus #num #flt x
  | C__u_filter__All -> rt_u_filter__All #num #flt x

and rt_u_filter__ByStatus (#num #flt: eqtype) (x: u_filter num flt) : Lemma (requires (C__u_filter__ByStatus? x)) (ensures dec_u_filter (enc_u_filter #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_filter__ByStatus f0 -> rt_e_status #num #flt f0

and rt_u_filter__All (#num #flt: eqtype) (x: u_filter num flt) : Lemma (requires (C__u_filter__All? x)) (ensures dec_u_filter (enc_u_filter #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_filter__All -> ()

and rt_items_l_r_order (#num #flt: eqtype) (acc: list (r_order num flt)) (xs: list (r_order num flt)) : Lemma (ensures dec_items_l_r_order acc (enc_items_l_r_order #num #flt xs) == Ok (rev_app acc xs)) (decreases %[xs; 2]) =
  match xs with
  | [] -> ()
  | y :: t -> rt_r_order #num #flt y; rt_items_l_r_order #num #flt (y :: acc) t

(* ======================================================================================
   4. TOTALITY. That the decoders type-check at `Tot` is the termination proof; what the
      lemma adds is that the outcome is exactly one of the two, for EVERY input — the
      failure classification is exhaustive rather than merely non-empty.
   ====================================================================================== *)

let dec_node_total (#num #flt: eqtype) (el: jval num flt)
  : Lemma (ensures (Ok? (dec_node el) \/ Error? (dec_node el)) /\
                   ~(Ok? (dec_node el) /\ Error? (dec_node el)))
  = ()

