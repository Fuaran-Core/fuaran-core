let rec enc_node (#num #flt: eqtype) (x: node num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__node__Slider i f0 f1 f2 f3 ->
    JObj ((let s1 = sfx_node__Slider__shape #num #flt (enc_opt_u_shape #num #flt f3) ([]) in let s0 = sfx_node__Slider__marks #num #flt (enc_opt_l_r_labelled__flt #num #flt f1) (("binding", enc_u_binding__flt f2) :: s1) in ("kind", JStr "Slider") :: ("id", JStr i) :: ("range", enc_r_ranged__flt f0) :: s0))
  | C__node__Stepper i f0 f1 f2 ->
    JObj ((let s1 = sfx_node__Stepper__binding #num #flt (enc_opt_u_binding__int #num #flt f2) ([]) in let s0 = sfx_node__Stepper__window #num #flt (enc_opt_r_labelled__r_ranged__int #num #flt f1) (s1) in ("kind", JStr "Stepper") :: ("id", JStr i) :: ("range", enc_r_ranged__int f0) :: s0))
  | C__node__Grid i f0 f1 f2 f3 f4 ->
    JObj ((let s3 = sfx_node__Grid__sort #num #flt (enc_opt_r_entry__str__e_direction #num #flt f4) ([]) in let s2 = sfx_node__Grid__series #num #flt (enc_opt_r_series__flt #num #flt f3) (s3) in let s1 = sfx_node__Grid__title #num #flt (enc_opt_r_labelled__str #num #flt f2) (s2) in let s0 = sfx_node__Grid__cursor #num #flt (enc_opt_str #num #flt f1) (s1) in ("kind", JStr "Grid") :: ("id", JStr i) :: ("pageSize", JInt f0) :: s0))
  | C__node__Outline i f0 f1 ->
    JObj (("kind", JStr "Outline") :: ("id", JStr i) :: ("tree", enc_u_tree f0) :: (if f1 = (C__r_tagged__str__Mk ("") ([]) None) then [] else ("trail", enc_r_tagged__str f1) :: []))
  | C__node__Frame i f0 f1 f2 ->
    JObj (("kind", JStr "Frame") :: ("id", JStr i) :: ("panel", enc_r_panel__str f0) :: ("rest", JArr (enc_items_l_node f1)) :: ("onOpen", JStr "<closure>") :: [])

and enc_r_ranged__flt (#num #flt: eqtype) (x: r_ranged__flt num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__r_ranged__flt__Mk f0 f1 f2 -> JObj (("low", JFloat f0) :: ("high", JFloat f1) :: (match f2 with | None -> [] | Some w -> ("steps", JArr (enc_items_l_flt w)) :: []))

and enc_r_labelled__flt (#num #flt: eqtype) (x: r_labelled__flt num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__r_labelled__flt__Mk f0 f1 -> JObj (("label", JStr f0) :: ("value", JFloat f1) :: [])

and enc_u_binding__flt (#num #flt: eqtype) (x: u_binding__flt num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__u_binding__flt__Static f0 ->
    JObj (("kind", JStr "Static") :: ("value", JFloat f0) :: [])
  | C__u_binding__flt__Local f0 f1 ->
    JObj (("kind", JStr "Local") :: ("initial", JFloat f0) :: ("stateKey", JStr f1) :: [])
  | C__u_binding__flt__Bounded f0 ->
    JObj (("kind", JStr "Bounded") :: ("range", enc_r_ranged__flt f0) :: [])

and enc_u_shape (#num #flt: eqtype) (x: u_shape num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__u_shape__Span f0 ->
    JObj (("kind", JStr "Span") :: ("extent", enc_r_ranged__flt f0) :: [])
  | C__u_shape__Point  ->
    JObj (("kind", JStr "Point") :: [])

and enc_r_ranged__int (#num #flt: eqtype) (x: r_ranged__int num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__r_ranged__int__Mk f0 f1 f2 -> JObj (("low", JInt f0) :: ("high", JInt f1) :: (match f2 with | None -> [] | Some w -> ("steps", JArr (enc_items_l_int w)) :: []))

and enc_r_labelled__r_ranged__int (#num #flt: eqtype) (x: r_labelled__r_ranged__int num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__r_labelled__r_ranged__int__Mk f0 f1 -> JObj (("label", JStr f0) :: ("value", enc_r_ranged__int f1) :: [])

and enc_u_binding__int (#num #flt: eqtype) (x: u_binding__int num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__u_binding__int__Static f0 ->
    JObj (("kind", JStr "Static") :: ("value", JInt f0) :: [])
  | C__u_binding__int__Local f0 f1 ->
    JObj (("kind", JStr "Local") :: ("initial", JInt f0) :: ("stateKey", JStr f1) :: [])
  | C__u_binding__int__Bounded f0 ->
    JObj (("kind", JStr "Bounded") :: ("range", enc_r_ranged__int f0) :: [])

and enc_r_labelled__str (#num #flt: eqtype) (x: r_labelled__str num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__r_labelled__str__Mk f0 f1 -> JObj (("label", JStr f0) :: ("value", JStr f1) :: [])

and enc_r_series__flt (#num #flt: eqtype) (x: r_series__flt num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__r_series__flt__Mk f0 -> JObj (("points", JArr (enc_items_l_r_labelled__flt f0)) :: [])

and enc_r_entry__str__e_direction (#num #flt: eqtype) (x: r_entry__str__e_direction num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__r_entry__str__e_direction__Mk f0 f1 -> JObj (("key", JStr f0) :: (match f1 with | None -> [] | Some w -> ("value", enc_e_direction w) :: []))

and enc_u_tree (#num #flt: eqtype) (x: u_tree num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__u_tree__Leaf f0 ->
    JObj (("kind", JStr "Leaf") :: ("n", JInt f0) :: [])
  | C__u_tree__Branch f0 f1 ->
    JObj (("kind", JStr "Branch") :: ("kids", JArr (enc_items_l_r_kid__u_tree f0)) :: (match f1 with | None -> [] | Some w -> ("spare", enc_r_tagged__u_tree w) :: []))

and enc_r_kid__u_tree (#num #flt: eqtype) (x: r_kid__u_tree num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__r_kid__u_tree__Mk f0 f1 -> JObj (("name", JStr f0) :: ("child", enc_u_tree f1) :: [])

and enc_r_tagged__u_tree (#num #flt: eqtype) (x: r_tagged__u_tree num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__r_tagged__u_tree__Mk f0 f1 f2 -> JObj ((let s2 = sfx_r_tagged__u_tree__Mk__note #num #flt (enc_opt_str #num #flt f2) ([]) in let s1 = sfx_r_tagged__u_tree__Mk__items #num #flt (enc_dflt_l_u_tree #num #flt ([]) f1 (JArr (enc_items_l_u_tree f1))) (s2) in let s0 = sfx_r_tagged__u_tree__Mk__tag #num #flt (enc_dflt_str #num #flt ("") f0) (s1) in s0))

and enc_r_tagged__str (#num #flt: eqtype) (x: r_tagged__str num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__r_tagged__str__Mk f0 f1 f2 -> JObj ((let s2 = sfx_r_tagged__str__Mk__note #num #flt (enc_opt_str #num #flt f2) ([]) in let s1 = sfx_r_tagged__str__Mk__items #num #flt (enc_dflt_l_str #num #flt ([]) f1 (JArr (enc_items_l_str f1))) (s2) in let s0 = sfx_r_tagged__str__Mk__tag #num #flt (enc_dflt_str #num #flt ("") f0) (s1) in s0))

and enc_r_panel__str (#num #flt: eqtype) (x: r_panel__str num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__r_panel__str__Mk f0 f1 -> JObj (("body", enc_node f0) :: ("meta", JStr f1) :: [])

and enc_items_l_flt (#num #flt: eqtype) (xs: list (flt)) : Tot (list (jval num flt)) (decreases xs) =
  match xs with
  | [] -> []
  | y :: t -> JFloat y :: enc_items_l_flt t

and enc_items_l_r_labelled__flt (#num #flt: eqtype) (xs: list (r_labelled__flt num flt)) : Tot (list (jval num flt)) (decreases xs) =
  match xs with
  | [] -> []
  | y :: t -> enc_r_labelled__flt y :: enc_items_l_r_labelled__flt t

and enc_items_l_int (#num #flt: eqtype) (xs: list (num)) : Tot (list (jval num flt)) (decreases xs) =
  match xs with
  | [] -> []
  | y :: t -> JInt y :: enc_items_l_int t

and enc_items_l_r_kid__u_tree (#num #flt: eqtype) (xs: list (r_kid__u_tree num flt)) : Tot (list (jval num flt)) (decreases xs) =
  match xs with
  | [] -> []
  | y :: t -> enc_r_kid__u_tree y :: enc_items_l_r_kid__u_tree t

and enc_items_l_u_tree (#num #flt: eqtype) (xs: list (u_tree num flt)) : Tot (list (jval num flt)) (decreases xs) =
  match xs with
  | [] -> []
  | y :: t -> enc_u_tree y :: enc_items_l_u_tree t

and enc_items_l_str (#num #flt: eqtype) (xs: list (string)) : Tot (list (jval num flt)) (decreases xs) =
  match xs with
  | [] -> []
  | y :: t -> JStr y :: enc_items_l_str t

and enc_items_l_node (#num #flt: eqtype) (xs: list (node num flt)) : Tot (list (jval num flt)) (decreases xs) =
  match xs with
  | [] -> []
  | y :: t -> enc_node y :: enc_items_l_node t

and enc_opt_l_r_labelled__flt (#num #flt: eqtype) (o: option (list (r_labelled__flt num flt))) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (JArr (enc_items_l_r_labelled__flt w))

and enc_opt_u_shape (#num #flt: eqtype) (o: option (u_shape num flt)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (enc_u_shape w)

and enc_opt_r_labelled__r_ranged__int (#num #flt: eqtype) (o: option (r_labelled__r_ranged__int num flt)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (enc_r_labelled__r_ranged__int w)

and enc_opt_u_binding__int (#num #flt: eqtype) (o: option (u_binding__int num flt)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (enc_u_binding__int w)

and enc_opt_str (#num #flt: eqtype) (o: option (string)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (JStr w)

and enc_opt_r_labelled__str (#num #flt: eqtype) (o: option (r_labelled__str num flt)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (enc_r_labelled__str w)

and enc_opt_r_series__flt (#num #flt: eqtype) (o: option (r_series__flt num flt)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (enc_r_series__flt w)

and enc_opt_r_entry__str__e_direction (#num #flt: eqtype) (o: option (r_entry__str__e_direction num flt)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (enc_r_entry__str__e_direction w)

and enc_dflt_str (#num #flt: eqtype) (d: string) (v: string) : Tot (option (jval num flt)) (decreases v) =
  if v = d then None else Some (JStr v)

and enc_dflt_l_u_tree (#num #flt: eqtype) (d: list (u_tree num flt)) (v: list (u_tree num flt)) (e: jval num flt) : Tot (option (jval num flt)) (decreases v) =
  if v = d then None else Some e

and enc_dflt_l_str (#num #flt: eqtype) (d: list (string)) (v: list (string)) (e: jval num flt) : Tot (option (jval num flt)) (decreases v) =
  if v = d then None else Some e

(* ======================================================================================
   4. The tag-dispatch decoder. Every cross-type call goes through `get_prop`, whose
      RETURN-TYPE refinement (`jsize (Ok?.v r) < jsize el`) is the termination argument:
      a decoder that descends by NAME into a value it looked up has no syntactic one.
      Value decoders sit at tier 0 on `jsize`, walkers at tier 1 on `jsizes` / `fsize`.
   ====================================================================================== *)

let rec dec_node (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (node num flt)) (decreases %[(jsize el <: nat); 0]) =
  let oid : outcome string = str_field "id" el in
  match str_field "kind" el with
  | Error e -> Error e
  | Ok tag ->
    if tag = "Slider" then
      let o0 : outcome (r_ranged__flt num flt) = (match get_prop "range" el with | Error e -> Error e | Ok v -> (match dec_r_ranged__flt v with | Error e -> Error e | Ok w -> Ok w)) in
      let o1 : outcome (option (list (r_labelled__flt num flt))) = (match get_prop "marks" el with | Error _ -> Ok None | Ok v -> (match v with | JArr ys -> (match dec_items_l_r_labelled__flt [] ys with | Error e -> Error e | Ok w -> Ok (Some w)) | other -> Error ("expected array, got " ^ kind_name other))) in
      let o2 : outcome (u_binding__flt num flt) = (match get_prop "binding" el with | Error e -> Error e | Ok v -> (match dec_u_binding__flt v with | Error e -> Error e | Ok w -> Ok w)) in
      let o3 : outcome (option (u_shape num flt)) = (match get_prop "shape" el with | Error _ -> Ok None | Ok v -> (match dec_u_shape v with | Error e -> Error e | Ok w -> Ok (Some w))) in
      (match oid with | Error e -> Error e | Ok i -> (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> Ok (C__node__Slider i f0 f1 f2 f3))))))
    else
    if tag = "Stepper" then
      let o0 : outcome (r_ranged__int num flt) = (match get_prop "range" el with | Error e -> Error e | Ok v -> (match dec_r_ranged__int v with | Error e -> Error e | Ok w -> Ok w)) in
      let o1 : outcome (option (r_labelled__r_ranged__int num flt)) = (match get_prop "window" el with | Error _ -> Ok None | Ok v -> (match dec_r_labelled__r_ranged__int v with | Error e -> Error e | Ok w -> Ok (Some w))) in
      let o2 : outcome (option (u_binding__int num flt)) = (match get_prop "binding" el with | Error _ -> Ok None | Ok v -> (match dec_u_binding__int v with | Error e -> Error e | Ok w -> Ok (Some w))) in
      (match oid with | Error e -> Error e | Ok i -> (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> Ok (C__node__Stepper i f0 f1 f2)))))
    else
    if tag = "Grid" then
      let o0 : outcome (num) = (match get_prop "pageSize" el with | Error e -> Error e | Ok v -> (match as_int v with | Error e -> Error e | Ok w -> Ok w)) in
      let o1 : outcome (option (string)) = rd_node__Grid__cursor #num #flt el in
      let o2 : outcome (option (r_labelled__str num flt)) = (match get_prop "title" el with | Error _ -> Ok None | Ok v -> (match dec_r_labelled__str v with | Error e -> Error e | Ok w -> Ok (Some w))) in
      let o3 : outcome (option (r_series__flt num flt)) = (match get_prop "series" el with | Error _ -> Ok None | Ok v -> (match dec_r_series__flt v with | Error e -> Error e | Ok w -> Ok (Some w))) in
      let o4 : outcome (option (r_entry__str__e_direction num flt)) = (match get_prop "sort" el with | Error _ -> Ok None | Ok v -> (match dec_r_entry__str__e_direction v with | Error e -> Error e | Ok w -> Ok (Some w))) in
      (match oid with | Error e -> Error e | Ok i -> (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> (match o4 with | Error e -> Error e | Ok f4 -> Ok (C__node__Grid i f0 f1 f2 f3 f4)))))))
    else
    if tag = "Outline" then
      let o0 : outcome (u_tree num flt) = (match get_prop "tree" el with | Error e -> Error e | Ok v -> (match dec_u_tree v with | Error e -> Error e | Ok w -> Ok w)) in
      let o1 : outcome (r_tagged__str num flt) = (match get_prop "trail" el with | Error _ -> Ok (C__r_tagged__str__Mk ("") ([]) None) | Ok v -> (match dec_r_tagged__str v with | Error e -> Error e | Ok w -> Ok w)) in
      (match oid with | Error e -> Error e | Ok i -> (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__node__Outline i f0 f1))))
    else
    if tag = "Frame" then
      let o0 : outcome (r_panel__str num flt) = (match get_prop "panel" el with | Error e -> Error e | Ok v -> (match dec_r_panel__str v with | Error e -> Error e | Ok w -> Ok w)) in
      let o1 : outcome (list (node num flt)) = (match get_prop "rest" el with | Error e -> Error e | Ok v -> (match v with | JArr ys -> (match dec_items_l_node [] ys with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected array, got " ^ kind_name other))) in
      let o2 : outcome (unit) = (match get_prop "onOpen" el with | Error e -> Error e | Ok v -> (let _ = v in let w = () in Ok w)) in
      (match oid with | Error e -> Error e | Ok i -> (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> Ok (C__node__Frame i f0 f1 f2)))))
    else
    Error ("unknown kind: " ^ tag)

and dec_r_ranged__flt (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (r_ranged__flt num flt)) (decreases %[(jsize el <: nat); 0]) =
  let o0 : outcome (flt) = (match get_prop "low" el with | Error e -> Error e | Ok v -> (match v with | JFloat w -> Ok w | other -> Error ("expected float, got " ^ kind_name other))) in
  let o1 : outcome (flt) = (match get_prop "high" el with | Error e -> Error e | Ok v -> (match v with | JFloat w -> Ok w | other -> Error ("expected float, got " ^ kind_name other))) in
  let o2 : outcome (option (list (flt))) = (match get_prop "steps" el with | Error _ -> Ok None | Ok v -> (match v with | JArr ys -> (match dec_items_l_flt [] ys with | Error e -> Error e | Ok w -> Ok (Some w)) | other -> Error ("expected array, got " ^ kind_name other))) in
  (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> Ok (C__r_ranged__flt__Mk f0 f1 f2))))

and dec_r_labelled__flt (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (r_labelled__flt num flt)) (decreases %[(jsize el <: nat); 0]) =
  let o0 : outcome (string) = (match get_prop "label" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
  let o1 : outcome (flt) = (match get_prop "value" el with | Error e -> Error e | Ok v -> (match v with | JFloat w -> Ok w | other -> Error ("expected float, got " ^ kind_name other))) in
  (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__r_labelled__flt__Mk f0 f1)))

and dec_u_binding__flt (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (u_binding__flt num flt)) (decreases %[(jsize el <: nat); 0]) =
  match str_field "kind" el with
  | Error e -> Error e
  | Ok tag ->
    if tag = "Static" then
      let o0 : outcome (flt) = (match get_prop "value" el with | Error e -> Error e | Ok v -> (match v with | JFloat w -> Ok w | other -> Error ("expected float, got " ^ kind_name other))) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__u_binding__flt__Static f0))
    else
    if tag = "Local" then
      let o0 : outcome (flt) = (match get_prop "initial" el with | Error e -> Error e | Ok v -> (match v with | JFloat w -> Ok w | other -> Error ("expected float, got " ^ kind_name other))) in
      let o1 : outcome (string) = (match get_prop "stateKey" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__u_binding__flt__Local f0 f1)))
    else
    if tag = "Bounded" then
      let o0 : outcome (r_ranged__flt num flt) = (match get_prop "range" el with | Error e -> Error e | Ok v -> (match dec_r_ranged__flt v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__u_binding__flt__Bounded f0))
    else
    Error ("unknown u_binding__flt case: " ^ tag)

and dec_u_shape (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (u_shape num flt)) (decreases %[(jsize el <: nat); 0]) =
  match str_field "kind" el with
  | Error e -> Error e
  | Ok tag ->
    if tag = "Span" then
      let o0 : outcome (r_ranged__flt num flt) = (match get_prop "extent" el with | Error e -> Error e | Ok v -> (match dec_r_ranged__flt v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__u_shape__Span f0))
    else
    if tag = "Point" then
      Ok C__u_shape__Point
    else
    Error ("unknown u_shape case: " ^ tag)

and dec_r_ranged__int (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (r_ranged__int num flt)) (decreases %[(jsize el <: nat); 0]) =
  let o0 : outcome (num) = (match get_prop "low" el with | Error e -> Error e | Ok v -> (match as_int v with | Error e -> Error e | Ok w -> Ok w)) in
  let o1 : outcome (num) = (match get_prop "high" el with | Error e -> Error e | Ok v -> (match as_int v with | Error e -> Error e | Ok w -> Ok w)) in
  let o2 : outcome (option (list (num))) = (match get_prop "steps" el with | Error _ -> Ok None | Ok v -> (match v with | JArr ys -> (match dec_items_l_int [] ys with | Error e -> Error e | Ok w -> Ok (Some w)) | other -> Error ("expected array, got " ^ kind_name other))) in
  (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> Ok (C__r_ranged__int__Mk f0 f1 f2))))

and dec_r_labelled__r_ranged__int (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (r_labelled__r_ranged__int num flt)) (decreases %[(jsize el <: nat); 0]) =
  let o0 : outcome (string) = (match get_prop "label" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
  let o1 : outcome (r_ranged__int num flt) = (match get_prop "value" el with | Error e -> Error e | Ok v -> (match dec_r_ranged__int v with | Error e -> Error e | Ok w -> Ok w)) in
  (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__r_labelled__r_ranged__int__Mk f0 f1)))

and dec_u_binding__int (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (u_binding__int num flt)) (decreases %[(jsize el <: nat); 0]) =
  match str_field "kind" el with
  | Error e -> Error e
  | Ok tag ->
    if tag = "Static" then
      let o0 : outcome (num) = (match get_prop "value" el with | Error e -> Error e | Ok v -> (match as_int v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__u_binding__int__Static f0))
    else
    if tag = "Local" then
      let o0 : outcome (num) = (match get_prop "initial" el with | Error e -> Error e | Ok v -> (match as_int v with | Error e -> Error e | Ok w -> Ok w)) in
      let o1 : outcome (string) = (match get_prop "stateKey" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__u_binding__int__Local f0 f1)))
    else
    if tag = "Bounded" then
      let o0 : outcome (r_ranged__int num flt) = (match get_prop "range" el with | Error e -> Error e | Ok v -> (match dec_r_ranged__int v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__u_binding__int__Bounded f0))
    else
    Error ("unknown u_binding__int case: " ^ tag)

and dec_r_labelled__str (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (r_labelled__str num flt)) (decreases %[(jsize el <: nat); 0]) =
  let o0 : outcome (string) = (match get_prop "label" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
  let o1 : outcome (string) = (match get_prop "value" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
  (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__r_labelled__str__Mk f0 f1)))

and dec_r_series__flt (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (r_series__flt num flt)) (decreases %[(jsize el <: nat); 0]) =
  let o0 : outcome (list (r_labelled__flt num flt)) = (match get_prop "points" el with | Error e -> Error e | Ok v -> (match v with | JArr ys -> (match dec_items_l_r_labelled__flt [] ys with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected array, got " ^ kind_name other))) in
  (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__r_series__flt__Mk f0))

and dec_r_entry__str__e_direction (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (r_entry__str__e_direction num flt)) (decreases %[(jsize el <: nat); 0]) =
  let o0 : outcome (string) = (match get_prop "key" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
  let o1 : outcome (option (e_direction)) = (match get_prop "value" el with | Error _ -> Ok None | Ok v -> (match dec_e_direction v with | Error e -> Error e | Ok w -> Ok (Some w))) in
  (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__r_entry__str__e_direction__Mk f0 f1)))

and dec_u_tree (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (u_tree num flt)) (decreases %[(jsize el <: nat); 0]) =
  match str_field "kind" el with
  | Error e -> Error e
  | Ok tag ->
    if tag = "Leaf" then
      let o0 : outcome (num) = (match get_prop "n" el with | Error e -> Error e | Ok v -> (match as_int v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__u_tree__Leaf f0))
    else
    if tag = "Branch" then
      let o0 : outcome (list (r_kid__u_tree num flt)) = (match get_prop "kids" el with | Error e -> Error e | Ok v -> (match v with | JArr ys -> (match dec_items_l_r_kid__u_tree [] ys with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected array, got " ^ kind_name other))) in
      let o1 : outcome (option (r_tagged__u_tree num flt)) = (match get_prop "spare" el with | Error _ -> Ok None | Ok v -> (match dec_r_tagged__u_tree v with | Error e -> Error e | Ok w -> Ok (Some w))) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__u_tree__Branch f0 f1)))
    else
    Error ("unknown u_tree case: " ^ tag)

and dec_r_kid__u_tree (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (r_kid__u_tree num flt)) (decreases %[(jsize el <: nat); 0]) =
  let o0 : outcome (string) = (match get_prop "name" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
  let o1 : outcome (u_tree num flt) = (match get_prop "child" el with | Error e -> Error e | Ok v -> (match dec_u_tree v with | Error e -> Error e | Ok w -> Ok w)) in
  (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__r_kid__u_tree__Mk f0 f1)))

and dec_r_tagged__u_tree (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (r_tagged__u_tree num flt)) (decreases %[(jsize el <: nat); 0]) =
  let o0 : outcome (string) = rd_r_tagged__u_tree__Mk__tag #num #flt el in
  let o1 : outcome (list (u_tree num flt)) = (match get_prop "items" el with | Error _ -> Ok [] | Ok v -> (match v with | JArr ys -> (match dec_items_l_u_tree [] ys with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected array, got " ^ kind_name other))) in
  let o2 : outcome (option (string)) = rd_r_tagged__u_tree__Mk__note #num #flt el in
  (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> Ok (C__r_tagged__u_tree__Mk f0 f1 f2))))

and dec_r_tagged__str (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (r_tagged__str num flt)) (decreases %[(jsize el <: nat); 0]) =
  let o0 : outcome (string) = rd_r_tagged__str__Mk__tag #num #flt el in
  let o1 : outcome (list (string)) = (match get_prop "items" el with | Error _ -> Ok [] | Ok v -> (match v with | JArr ys -> (match dec_items_l_str [] ys with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected array, got " ^ kind_name other))) in
  let o2 : outcome (option (string)) = rd_r_tagged__str__Mk__note #num #flt el in
  (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> Ok (C__r_tagged__str__Mk f0 f1 f2))))

and dec_r_panel__str (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (r_panel__str num flt)) (decreases %[(jsize el <: nat); 0]) =
  let o0 : outcome (node num flt) = (match get_prop "body" el with | Error e -> Error e | Ok v -> (match dec_node v with | Error e -> Error e | Ok w -> Ok w)) in
  let o1 : outcome (string) = (match get_prop "meta" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
  (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__r_panel__str__Mk f0 f1)))

and dec_items_l_flt (#num #flt: eqtype) (acc: list (flt)) (ys: list (jval num flt)) : Tot (outcome (list (flt))) (decreases %[(jsizes ys <: nat); 1]) =
  match ys with
  | [] -> Ok (rev acc)
  | y :: rest ->
    (match (match y with | JFloat w -> Ok w | other -> Error ("expected float, got " ^ kind_name other)) with
     | Ok w -> dec_items_l_flt (w :: acc) rest
     | Error e -> Error e)

and dec_items_l_r_labelled__flt (#num #flt: eqtype) (acc: list (r_labelled__flt num flt)) (ys: list (jval num flt)) : Tot (outcome (list (r_labelled__flt num flt))) (decreases %[(jsizes ys <: nat); 1]) =
  match ys with
  | [] -> Ok (rev acc)
  | y :: rest ->
    (match dec_r_labelled__flt y with
     | Ok w -> dec_items_l_r_labelled__flt (w :: acc) rest
     | Error e -> Error e)

and dec_items_l_int (#num #flt: eqtype) (acc: list (num)) (ys: list (jval num flt)) : Tot (outcome (list (num))) (decreases %[(jsizes ys <: nat); 1]) =
  match ys with
  | [] -> Ok (rev acc)
  | y :: rest ->
    (match as_int y with
     | Ok w -> dec_items_l_int (w :: acc) rest
     | Error e -> Error e)

and dec_items_l_r_kid__u_tree (#num #flt: eqtype) (acc: list (r_kid__u_tree num flt)) (ys: list (jval num flt)) : Tot (outcome (list (r_kid__u_tree num flt))) (decreases %[(jsizes ys <: nat); 1]) =
  match ys with
  | [] -> Ok (rev acc)
  | y :: rest ->
    (match dec_r_kid__u_tree y with
     | Ok w -> dec_items_l_r_kid__u_tree (w :: acc) rest
     | Error e -> Error e)

and dec_items_l_u_tree (#num #flt: eqtype) (acc: list (u_tree num flt)) (ys: list (jval num flt)) : Tot (outcome (list (u_tree num flt))) (decreases %[(jsizes ys <: nat); 1]) =
  match ys with
  | [] -> Ok (rev acc)
  | y :: rest ->
    (match dec_u_tree y with
     | Ok w -> dec_items_l_u_tree (w :: acc) rest
     | Error e -> Error e)

and dec_items_l_str (#num #flt: eqtype) (acc: list (string)) (ys: list (jval num flt)) : Tot (outcome (list (string))) (decreases %[(jsizes ys <: nat); 1]) =
  match ys with
  | [] -> Ok (rev acc)
  | y :: rest ->
    (match as_string y with
     | Ok w -> dec_items_l_str (w :: acc) rest
     | Error e -> Error e)

and dec_items_l_node (#num #flt: eqtype) (acc: list (node num flt)) (ys: list (jval num flt)) : Tot (outcome (list (node num flt))) (decreases %[(jsizes ys <: nat); 1]) =
  match ys with
  | [] -> Ok (rev acc)
  | y :: rest ->
    (match dec_node y with
     | Ok w -> dec_items_l_node (w :: acc) rest
     | Error e -> Error e)

