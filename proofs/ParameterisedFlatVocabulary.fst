module ParameterisedFlatVocabulary

open WireDecode

#set-options "--ext context_pruning"

(* ======================================================================================
   1. The closed string sets (`TEnum`) — a bare wire string, not an object.
   ====================================================================================== *)

type e_direction =
  | C__e_direction__asc
  | C__e_direction__desc

let enc_e_direction (#num #flt: eqtype) (x: e_direction) : Tot (jval num flt) =
  match x with
  | C__e_direction__asc -> JStr "asc"
  | C__e_direction__desc -> JStr "desc"

let dec_e_direction (#num #flt: eqtype) (el: jval num flt) : Tot (outcome e_direction) =
  match as_string el with
  | Error e -> Error e
  | Ok s ->
    if s = "asc" then Ok C__e_direction__asc else
    if s = "desc" then Ok C__e_direction__desc else
    Error ("unknown Direction: " ^ s)

(* ======================================================================================
   2. The vocabulary's types — one mutual group, because a record may hold a union, a
      union a node, and a node a list of nodes. Records are single-constructor types
      rather than F* records so that two objects declaring a `label` cannot collide.
   ====================================================================================== *)

type node (num flt: eqtype) =
  | C__node__Slider : id:string -> range:(r_ranged__flt num flt) -> marks:(option (list (r_labelled__flt num flt))) -> binding:(u_binding__flt num flt) -> shape:(option (u_shape num flt)) -> node num flt
  | C__node__Stepper : id:string -> range:(r_ranged__int num flt) -> window:(option (r_labelled__r_ranged__int num flt)) -> binding:(option (u_binding__int num flt)) -> node num flt
  | C__node__Grid : id:string -> page_size:(num) -> cursor:(option (string)) -> title:(option (r_labelled__str num flt)) -> series:(option (r_series__flt num flt)) -> sort:(option (r_entry__str__e_direction num flt)) -> node num flt
  | C__node__Outline : id:string -> tree:(u_tree num flt) -> trail:(r_tagged__str num flt) -> node num flt
  | C__node__Frame : id:string -> panel:(r_panel__str num flt) -> rest:(list (node num flt)) -> on_open:(unit) -> node num flt

and r_ranged__flt (num flt: eqtype) =
  | C__r_ranged__flt__Mk : low:(flt) -> high:(flt) -> steps:(option (list (flt))) -> r_ranged__flt num flt

and r_labelled__flt (num flt: eqtype) =
  | C__r_labelled__flt__Mk : label:(string) -> value:(flt) -> r_labelled__flt num flt

and u_binding__flt (num flt: eqtype) =
  | C__u_binding__flt__Static : value:(flt) -> u_binding__flt num flt
  | C__u_binding__flt__Local : initial:(flt) -> state_key:(string) -> u_binding__flt num flt
  | C__u_binding__flt__Bounded : range:(r_ranged__flt num flt) -> u_binding__flt num flt

and u_shape (num flt: eqtype) =
  | C__u_shape__Span : extent:(r_ranged__flt num flt) -> u_shape num flt
  | C__u_shape__Point : u_shape num flt

and r_ranged__int (num flt: eqtype) =
  | C__r_ranged__int__Mk : low:(num) -> high:(num) -> steps:(option (list (num))) -> r_ranged__int num flt

and r_labelled__r_ranged__int (num flt: eqtype) =
  | C__r_labelled__r_ranged__int__Mk : label:(string) -> value:(r_ranged__int num flt) -> r_labelled__r_ranged__int num flt

and u_binding__int (num flt: eqtype) =
  | C__u_binding__int__Static : value:(num) -> u_binding__int num flt
  | C__u_binding__int__Local : initial:(num) -> state_key:(string) -> u_binding__int num flt
  | C__u_binding__int__Bounded : range:(r_ranged__int num flt) -> u_binding__int num flt

and r_labelled__str (num flt: eqtype) =
  | C__r_labelled__str__Mk : label:(string) -> value:(string) -> r_labelled__str num flt

and r_series__flt (num flt: eqtype) =
  | C__r_series__flt__Mk : points:(list (r_labelled__flt num flt)) -> r_series__flt num flt

and r_entry__str__e_direction (num flt: eqtype) =
  | C__r_entry__str__e_direction__Mk : key:(string) -> value:(option (e_direction)) -> r_entry__str__e_direction num flt

and u_tree (num flt: eqtype) =
  | C__u_tree__Leaf : n:(num) -> u_tree num flt
  | C__u_tree__Branch : kids:(list (r_kid__u_tree num flt)) -> spare:(option (r_tagged__u_tree num flt)) -> u_tree num flt

and r_kid__u_tree (num flt: eqtype) =
  | C__r_kid__u_tree__Mk : name:(string) -> child:(u_tree num flt) -> r_kid__u_tree num flt

and r_tagged__u_tree (num flt: eqtype) =
  | C__r_tagged__u_tree__Mk : tag:(string) -> items:(list (u_tree num flt)) -> note:(option (string)) -> r_tagged__u_tree num flt

and r_tagged__str (num flt: eqtype) =
  | C__r_tagged__str__Mk : tag:(string) -> items:(list (string)) -> note:(option (string)) -> r_tagged__str num flt

and r_panel__str (num flt: eqtype) =
  | C__r_panel__str__Mk : body:(node num flt) -> meta:(string) -> r_panel__str num flt

