open WireDecode

#set-options "--ext context_pruning"

(* ======================================================================================
   1. The closed string sets (`TEnum`) — a bare wire string, not an object.
   ====================================================================================== *)

type e_strictness =
  | C__e_strictness__StrictReplay
  | C__e_strictness__AdvisoryWarning

let enc_e_strictness (#num #flt: eqtype) (x: e_strictness) : Tot (jval num flt) =
  match x with
  | C__e_strictness__StrictReplay -> JStr "StrictReplay"
  | C__e_strictness__AdvisoryWarning -> JStr "AdvisoryWarning"

let dec_e_strictness (#num #flt: eqtype) (el: jval num flt) : Tot (outcome e_strictness) =
  match as_string el with
  | Error e -> Error e
  | Ok s ->
    if s = "StrictReplay" then Ok C__e_strictness__StrictReplay else
    if s = "AdvisoryWarning" then Ok C__e_strictness__AdvisoryWarning else
    Error ("unknown Strictness: " ^ s)

type e_layout_kind =
  | C__e_layout_kind__Stack
  | C__e_layout_kind__Row
  | C__e_layout_kind__Grid

let enc_e_layout_kind (#num #flt: eqtype) (x: e_layout_kind) : Tot (jval num flt) =
  match x with
  | C__e_layout_kind__Stack -> JStr "Stack"
  | C__e_layout_kind__Row -> JStr "Row"
  | C__e_layout_kind__Grid -> JStr "Grid"

let dec_e_layout_kind (#num #flt: eqtype) (el: jval num flt) : Tot (outcome e_layout_kind) =
  match as_string el with
  | Error e -> Error e
  | Ok s ->
    if s = "Stack" then Ok C__e_layout_kind__Stack else
    if s = "Row" then Ok C__e_layout_kind__Row else
    if s = "Grid" then Ok C__e_layout_kind__Grid else
    Error ("unknown LayoutKind: " ^ s)

type e_level =
  | C__e_level__Low
  | C__e_level__Medium
  | C__e_level__High

let enc_e_level (#num #flt: eqtype) (x: e_level) : Tot (jval num flt) =
  match x with
  | C__e_level__Low -> JStr "low"
  | C__e_level__Medium -> JStr "medium"
  | C__e_level__High -> JStr "high"

let dec_e_level (#num #flt: eqtype) (el: jval num flt) : Tot (outcome e_level) =
  match as_string el with
  | Error e -> Error e
  | Ok s ->
    if s = "low" then Ok C__e_level__Low else
    if s = "medium" then Ok C__e_level__Medium else
    if s = "high" then Ok C__e_level__High else
    Error ("unknown Level: " ^ s)

(* ======================================================================================
   1b. The wider data universe's leaves — a string-borne exact scalar (its string refined
       by its one canonical spelling) and a tuple of leaf slots (a JSON array). A set is
       its wire array and a keyed map its array of [key, value] tuples: the model carries
       the items in the encoder's order, and their canonical order over canonical bytes is
       the hosts' rule, which a model whose numbers are opaque cannot compute.
   ====================================================================================== *)

(* Phase 639 — the canonical spellings of the string-borne exact scalars (fuaran-core D251), read off
   a string's characters: the grammar every host reads, so the model's decoder refuses what theirs
   refuse. Each predicate is total and decides one spelling per value. *)
let txt_digit (c: FStar.Char.char) : bool =
  let n = FStar.Char.int_of_char c in
  48 <= n && n <= 57

let rec txt_all_digits (l: list FStar.Char.char) : bool =
  match l with
  | [] -> true
  | c :: t -> txt_digit c && txt_all_digits t

let txt_natural (l: list FStar.Char.char) : bool =
  match l with
  | [] -> false
  | [c] -> txt_digit c
  | c :: t -> txt_digit c && FStar.Char.int_of_char c <> 48 && txt_all_digits t

let rec txt_value (acc: nat) (l: list FStar.Char.char) : Tot nat (decreases l) =
  match l with
  | [] -> acc
  | c :: t ->
    let n = FStar.Char.int_of_char c in
    txt_value (acc * 10 + (if 48 <= n && n <= 57 then n - 48 else 0)) t

let rec txt_last_nonzero (l: list FStar.Char.char) : bool =
  match l with
  | [] -> false
  | [c] -> txt_digit c && FStar.Char.int_of_char c <> 48
  | _ :: t -> txt_last_nonzero t

let txt_fraction (most: nat) (l: list FStar.Char.char) : bool =
  List.Tot.length l <= most && txt_all_digits l && txt_last_nonzero l

let rec txt_split (l: list FStar.Char.char) : Tot (list FStar.Char.char & option (list FStar.Char.char)) =
  match l with
  | [] -> ([], None)
  | c :: t ->
    if FStar.Char.int_of_char c = 46 then ([], Some t)
    else (let (a, b) = txt_split t in (c :: a, b))

let txt_unsigned (l: list FStar.Char.char) : Tot (bool & list FStar.Char.char) =
  match l with
  | c :: t -> if FStar.Char.int_of_char c = 45 then (true, t) else (false, l)
  | [] -> (false, [])

let rec txt_pow10 (n: int) : Tot nat (decreases (if n <= 0 then 0 else n)) =
  if n <= 0 then 1 else 10 * txt_pow10 (n - 1)

let txt_bound (negative: bool) : nat =
  if negative then 9223372036854775808 else 9223372036854775807

let is_t_int64 (s: string) : bool =
  let (neg, body) = txt_unsigned (FStar.String.list_of_string s) in
  txt_natural body && not (neg && txt_value 0 body = 0) && txt_value 0 body <= txt_bound neg

let is_t_decimal (s: string) : bool =
  let (neg, body) = txt_unsigned (FStar.String.list_of_string s) in
  match txt_split body with
  | (ip, None) -> txt_natural ip && not (neg && txt_value 0 ip = 0)
  | (ip, Some fp) -> txt_natural ip && txt_all_digits fp && txt_last_nonzero fp

let txt_b64 (c: FStar.Char.char) : int =
  let n = FStar.Char.int_of_char c in
  if 65 <= n && n <= 90 then n - 65
  else if 97 <= n && n <= 122 then n - 71
  else if 48 <= n && n <= 57 then n + 4
  else if n = 43 then 62
  else if n = 47 then 63
  else -1

let txt_pad (c: FStar.Char.char) : bool = FStar.Char.int_of_char c = 61

let rec txt_base64 (l: list FStar.Char.char) : bool =
  match l with
  | [] -> true
  | [a; b; c; d] ->
    txt_b64 a >= 0 && txt_b64 b >= 0
    && (if txt_pad c then txt_pad d && txt_b64 b % 16 = 0
        else txt_b64 c >= 0 && (if txt_pad d then txt_b64 c % 4 = 0 else txt_b64 d >= 0))
  | a :: b :: c :: d :: rest ->
    txt_b64 a >= 0 && txt_b64 b >= 0 && txt_b64 c >= 0 && txt_b64 d >= 0 && txt_base64 rest
  | _ -> false

let is_t_bytes (s: string) : bool = txt_base64 (FStar.String.list_of_string s)

let txt_two (a b: FStar.Char.char) (most: int) : bool =
  txt_digit a && txt_digit b
  && (FStar.Char.int_of_char a - 48) * 10 + (FStar.Char.int_of_char b - 48) <= most

let is_t_time_of_day (s: string) : bool =
  match FStar.String.list_of_string s with
  | h1 :: h2 :: c1 :: m1 :: m2 :: c2 :: s1 :: s2 :: rest ->
    FStar.Char.int_of_char c1 = 58 && FStar.Char.int_of_char c2 = 58
    && txt_two h1 h2 23 && txt_two m1 m2 59 && txt_two s1 s2 59
    && (match rest with
        | [] -> true
        | d :: fp -> FStar.Char.int_of_char d = 46 && txt_fraction 7 fp)
  | _ -> false

let txt_strip_s (l: list FStar.Char.char) : option (list FStar.Char.char) =
  match List.Tot.rev l with
  | c :: t -> if FStar.Char.int_of_char c = 115 then Some (List.Tot.rev t) else None
  | [] -> None

let is_t_duration (s: string) : bool =
  match txt_strip_s (FStar.String.list_of_string s) with
  | None -> false
  | Some l ->
    let (neg, body) = txt_unsigned l in
    (match txt_split body with
     | (ip, None) ->
       txt_natural ip && not (neg && txt_value 0 ip = 0) && txt_value 0 ip * 10000000 <= txt_bound neg
     | (ip, Some fp) ->
       txt_natural ip && txt_fraction 7 fp
       && txt_value 0 ip * 10000000 + txt_value 0 fp * txt_pow10 (7 - List.Tot.length fp) <= txt_bound neg)

type t_decimal = s:string{is_t_decimal s}

let enc_t_decimal (#num #flt: eqtype) (x: t_decimal) : Tot (jval num flt) = JStr x

let dec_t_decimal (#num #flt: eqtype) (el: jval num flt) : Tot (outcome t_decimal) =
  match as_string el with
  | Error e -> Error e
  | Ok s -> if is_t_decimal s then Ok s else Error ("not a canonical t_decimal: " ^ s)

type t_time_of_day = s:string{is_t_time_of_day s}

let enc_t_time_of_day (#num #flt: eqtype) (x: t_time_of_day) : Tot (jval num flt) = JStr x

let dec_t_time_of_day (#num #flt: eqtype) (el: jval num flt) : Tot (outcome t_time_of_day) =
  match as_string el with
  | Error e -> Error e
  | Ok s -> if is_t_time_of_day s then Ok s else Error ("not a canonical t_time_of_day: " ^ s)

type t_int64 = s:string{is_t_int64 s}

let enc_t_int64 (#num #flt: eqtype) (x: t_int64) : Tot (jval num flt) = JStr x

let dec_t_int64 (#num #flt: eqtype) (el: jval num flt) : Tot (outcome t_int64) =
  match as_string el with
  | Error e -> Error e
  | Ok s -> if is_t_int64 s then Ok s else Error ("not a canonical t_int64: " ^ s)

type t_bytes = s:string{is_t_bytes s}

let enc_t_bytes (#num #flt: eqtype) (x: t_bytes) : Tot (jval num flt) = JStr x

let dec_t_bytes (#num #flt: eqtype) (el: jval num flt) : Tot (outcome t_bytes) =
  match as_string el with
  | Error e -> Error e
  | Ok s -> if is_t_bytes s then Ok s else Error ("not a canonical t_bytes: " ^ s)

let enc_tp2_int_bool (#num #flt: eqtype) (x: (num & bool)) : Tot (jval num flt) =
  match x with
  | (x0, x1) -> JArr [JInt x0; JBool x1]

let dec_tp2_int_bool (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (num & bool)) =
  match el with
  | JArr [y0; y1] -> (match as_int y0 with | Error e -> Error e | Ok w0 -> (match as_bool y1 with | Error e -> Error e | Ok w1 -> Ok (w0, w1)))
  | other -> Error ("expected an array of 2 items, got " ^ kind_name other)

let enc_tp2_tp2_int_bool_str (#num #flt: eqtype) (x: ((num & bool) & string)) : Tot (jval num flt) =
  match x with
  | (x0, x1) -> JArr [enc_tp2_int_bool x0; JStr x1]

let dec_tp2_tp2_int_bool_str (#num #flt: eqtype) (el: jval num flt) : Tot (outcome ((num & bool) & string)) =
  match el with
  | JArr [y0; y1] -> (match dec_tp2_int_bool y0 with | Error e -> Error e | Ok w0 -> (match as_string y1 with | Error e -> Error e | Ok w1 -> Ok (w0, w1)))
  | other -> Error ("expected an array of 2 items, got " ^ kind_name other)

type t_duration = s:string{is_t_duration s}

let enc_t_duration (#num #flt: eqtype) (x: t_duration) : Tot (jval num flt) = JStr x

let dec_t_duration (#num #flt: eqtype) (el: jval num flt) : Tot (outcome t_duration) =
  match as_string el with
  | Error e -> Error e
  | Ok s -> if is_t_duration s then Ok s else Error ("not a canonical t_duration: " ^ s)

let enc_tp2_e_level_t_duration (#num #flt: eqtype) (x: (e_level & t_duration)) : Tot (jval num flt) =
  match x with
  | (x0, x1) -> JArr [enc_e_level x0; enc_t_duration x1]

let dec_tp2_e_level_t_duration (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (e_level & t_duration)) =
  match el with
  | JArr [y0; y1] -> (match dec_e_level y0 with | Error e -> Error e | Ok w0 -> (match dec_t_duration y1 with | Error e -> Error e | Ok w1 -> Ok (w0, w1)))
  | other -> Error ("expected an array of 2 items, got " ^ kind_name other)

let enc_tp2_str_flt (#num #flt: eqtype) (x: (string & flt)) : Tot (jval num flt) =
  match x with
  | (x0, x1) -> JArr [JStr x0; JFloat x1]

let dec_tp2_str_flt (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (string & flt)) =
  match el with
  | JArr [y0; y1] -> (match as_string y0 with | Error e -> Error e | Ok w0 -> (match (match y1 with | JFloat w -> Ok w | other -> Error ("expected float, got " ^ kind_name other)) with | Error e -> Error e | Ok w1 -> Ok (w0, w1)))
  | other -> Error ("expected an array of 2 items, got " ^ kind_name other)

let enc_tp2_t_int64_tp2_str_flt (#num #flt: eqtype) (x: (t_int64 & (string & flt))) : Tot (jval num flt) =
  match x with
  | (x0, x1) -> JArr [enc_t_int64 x0; enc_tp2_str_flt x1]

let dec_tp2_t_int64_tp2_str_flt (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (t_int64 & (string & flt))) =
  match el with
  | JArr [y0; y1] -> (match dec_t_int64 y0 with | Error e -> Error e | Ok w0 -> (match dec_tp2_str_flt y1 with | Error e -> Error e | Ok w1 -> Ok (w0, w1)))
  | other -> Error ("expected an array of 2 items, got " ^ kind_name other)

(* ======================================================================================
   2. The vocabulary's types — one mutual group, because a record may hold a union, a
      union a node, and a node a list of nodes. Records are single-constructor types
      rather than F* records so that two objects declaring a `label` cannot collide.
   ====================================================================================== *)

type node (num flt: eqtype) =
  | C__node__Node : id:string -> k:(vkind num flt) -> hidden:(option (bool)) -> label:(option (string)) -> node num flt

and vkind (num flt: eqtype) =
  | C__vkind__Embed : component_id:(string) -> content_hash:(option (r_content_hash num flt)) -> module_id:(string) -> props:(option (list (string & jval num flt))) -> vkind num flt
  | C__vkind__Group : children:(list (node num flt)) -> layout:(e_layout_kind) -> on_select:(unit) -> vkind num flt
  | C__vkind__Link : href:(u_slot__str num flt) -> label:(u_text num flt) -> on_click:(unit) -> vkind num flt
  | C__vkind__Note : body:(u_text num flt) -> vkind num flt
  | C__vkind__Tally : amount:(t_decimal) -> at:(option (t_time_of_day)) -> count:(t_int64) -> digest:(option (t_bytes)) -> grid:(list (((num & bool) & string))) -> levels:(list ((e_level & t_duration))) -> pair:((t_int64 & (string & flt))) -> span:(t_duration) -> tags:(list (string)) -> vkind num flt

and r_content_hash (num flt: eqtype) =
  | C__r_content_hash__Mk : hash:(string) -> strictness:(e_strictness) -> r_content_hash num flt

and u_slot__str (num flt: eqtype) =
  | C__u_slot__str__Fixed : value:(string) -> u_slot__str num flt
  | C__u_slot__str__Ref : name:(string) -> u_slot__str num flt

and u_text (num flt: eqtype) =
  | C__u_text__Inline : text:(string) -> u_text num flt
  | C__u_text__Lookup : args:(option (list (string & string))) -> key:(string) -> u_text num flt

(* ======================================================================================
   3. The encoder — the discriminated envelope, keys in the vocabulary's canonical
      order. The model has no render step, so the object LITERAL is the canonical form.
      Recursion is on the MODEL value, where F*'s subterm order spans the whole family.
   ====================================================================================== *)

(* The member-list SUFFIXES — one per conditional member of a constructor carrying two or
   more, bound once by the encoder below rather than written into both arms of a test.
   Opaque to the solver: only the per-suffix lemmas of the proof script look inside. *)

[@@"opaque_to_smt"]
let sfx_node__Node__hidden (#num #flt: eqtype) (e: option (jval num flt)) (rest: list (string & jval num flt)) : Tot (list (string & jval num flt)) =
  match e with | None -> rest | Some v -> ("hidden", v) :: rest

[@@"opaque_to_smt"]
let sfx_node__Node__label (#num #flt: eqtype) (e: option (jval num flt)) (rest: list (string & jval num flt)) : Tot (list (string & jval num flt)) =
  match e with | None -> rest | Some v -> ("label", v) :: rest

[@@"opaque_to_smt"]
let sfx_vkind__Embed__content_hash (#num #flt: eqtype) (e: option (jval num flt)) (rest: list (string & jval num flt)) : Tot (list (string & jval num flt)) =
  match e with | None -> rest | Some v -> ("contentHash", v) :: rest

[@@"opaque_to_smt"]
let sfx_vkind__Embed__props (#num #flt: eqtype) (e: option (jval num flt)) (rest: list (string & jval num flt)) : Tot (list (string & jval num flt)) =
  match e with | None -> rest | Some v -> ("props", v) :: rest

[@@"opaque_to_smt"]
let sfx_vkind__Tally__at (#num #flt: eqtype) (e: option (jval num flt)) (rest: list (string & jval num flt)) : Tot (list (string & jval num flt)) =
  match e with | None -> rest | Some v -> ("at", v) :: rest

[@@"opaque_to_smt"]
let sfx_vkind__Tally__digest (#num #flt: eqtype) (e: option (jval num flt)) (rest: list (string & jval num flt)) : Tot (list (string & jval num flt)) =
  match e with | None -> rest | Some v -> ("digest", v) :: rest

(* The member READERS — one per conditional member of a suffixed constructor whose read calls
   nothing in the decoder family, applied by the decoder below rather than inlined into it.
   Opaque to the solver: only the per-reader value lemmas of the proof script look inside. *)

[@@"opaque_to_smt"]
let rd_node__Node__hidden (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (option (bool))) =
  (match get_prop "hidden" el with | Error _ -> Ok None | Ok v -> (match as_bool v with | Error e -> Error e | Ok w -> Ok (Some w)))

[@@"opaque_to_smt"]
let rd_node__Node__label (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (option (string))) =
  (match get_prop "label" el with | Error _ -> Ok None | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok (Some w)))

[@@"opaque_to_smt"]
let rd_vkind__Tally__at (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (option (t_time_of_day))) =
  (match get_prop "at" el with | Error _ -> Ok None | Ok v -> (match dec_t_time_of_day v with | Error e -> Error e | Ok w -> Ok (Some w)))

[@@"opaque_to_smt"]
let rd_vkind__Tally__digest (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (option (t_bytes))) =
  (match get_prop "digest" el with | Error _ -> Ok None | Ok v -> (match dec_t_bytes v with | Error e -> Error e | Ok w -> Ok (Some w)))

let rec enc_node (#num #flt: eqtype) (x: node num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__node__Node i k e0 e1 ->
    JObj ((let s1 = sfx_node__Node__label #num #flt (enc_opt_str #num #flt e1) ([]) in let s0 = sfx_node__Node__hidden #num #flt (enc_opt_bool #num #flt e0) (("id", JStr i) :: ("kind", enc_vkind k) :: s1) in s0))

and enc_vkind (#num #flt: eqtype) (x: vkind num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__vkind__Embed f0 f1 f2 f3 ->
    JObj ((let s1 = sfx_vkind__Embed__props #num #flt (enc_opt_m_json #num #flt f3) ([]) in let s0 = sfx_vkind__Embed__content_hash #num #flt (enc_opt_r_content_hash #num #flt f1) (("moduleId", JStr f2) :: s1) in ("$type", JStr "Embed") :: ("componentId", JStr f0) :: s0))
  | C__vkind__Group f0 f1 f2 ->
    JObj (("$type", JStr "Group") :: ("children", JArr (enc_items_l_node f0)) :: (if f1 = C__e_layout_kind__Stack then ("onSelect", JStr "<closure>") :: [] else ("layout", enc_e_layout_kind f1) :: ("onSelect", JStr "<closure>") :: []))
  | C__vkind__Link f0 f1 f2 ->
    JObj (("$type", JStr "Link") :: ("href", enc_u_slot__str f0) :: ("label", enc_u_text f1) :: ("onClick", JStr "<closure>") :: [])
  | C__vkind__Note f0 ->
    JObj (("$type", JStr "Note") :: ("body", enc_u_text f0) :: [])
  | C__vkind__Tally f0 f1 f2 f3 f4 f5 f6 f7 f8 ->
    JObj ((let s1 = sfx_vkind__Tally__digest #num #flt (enc_opt_t_bytes #num #flt f3) (("grid", JArr (enc_items_l_tp2_tp2_int_bool_str f4)) :: ("levels", JArr (enc_items_l_tp2_e_level_t_duration f5)) :: ("pair", enc_tp2_t_int64_tp2_str_flt f6) :: ("span", enc_t_duration f7) :: ("tags", JArr (enc_items_l_str f8)) :: []) in let s0 = sfx_vkind__Tally__at #num #flt (enc_opt_t_time_of_day #num #flt f1) (("count", enc_t_int64 f2) :: s1) in ("$type", JStr "Tally") :: ("amount", enc_t_decimal f0) :: s0))

and enc_r_content_hash (#num #flt: eqtype) (x: r_content_hash num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__r_content_hash__Mk f0 f1 -> JObj (("hash", JStr f0) :: ("strictness", enc_e_strictness f1) :: [])

and enc_u_slot__str (#num #flt: eqtype) (x: u_slot__str num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__u_slot__str__Fixed f0 ->
    JObj (("$type", JStr "Fixed") :: ("value", JStr f0) :: [])
  | C__u_slot__str__Ref f0 ->
    JObj (("$type", JStr "Ref") :: ("name", JStr f0) :: [])

and enc_u_text (#num #flt: eqtype) (x: u_text num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__u_text__Inline f0 ->
    JObj (("$type", JStr "Inline") :: ("text", JStr f0) :: [])
  | C__u_text__Lookup f0 f1 ->
    JObj (("$type", JStr "Lookup") :: (match f0 with | None -> ("key", JStr f1) :: [] | Some w -> ("args", JObj (enc_entries_m_str w)) :: ("key", JStr f1) :: []))

and enc_entries_m_json (#num #flt: eqtype) (es: list (string & jval num flt)) : Tot (list (string & jval num flt)) (decreases es) =
  match es with
  | [] -> []
  | (k, v) :: t -> (k, v) :: enc_entries_m_json t

and enc_items_l_node (#num #flt: eqtype) (xs: list (node num flt)) : Tot (list (jval num flt)) (decreases xs) =
  match xs with
  | [] -> []
  | y :: t -> enc_node y :: enc_items_l_node t

and enc_entries_m_str (#num #flt: eqtype) (es: list (string & string)) : Tot (list (string & jval num flt)) (decreases es) =
  match es with
  | [] -> []
  | (k, v) :: t -> (k, JStr v) :: enc_entries_m_str t

and enc_items_l_tp2_tp2_int_bool_str (#num #flt: eqtype) (xs: list (((num & bool) & string))) : Tot (list (jval num flt)) (decreases xs) =
  match xs with
  | [] -> []
  | y :: t -> enc_tp2_tp2_int_bool_str y :: enc_items_l_tp2_tp2_int_bool_str t

and enc_items_l_tp2_e_level_t_duration (#num #flt: eqtype) (xs: list ((e_level & t_duration))) : Tot (list (jval num flt)) (decreases xs) =
  match xs with
  | [] -> []
  | y :: t -> enc_tp2_e_level_t_duration y :: enc_items_l_tp2_e_level_t_duration t

and enc_items_l_str (#num #flt: eqtype) (xs: list (string)) : Tot (list (jval num flt)) (decreases xs) =
  match xs with
  | [] -> []
  | y :: t -> JStr y :: enc_items_l_str t

and enc_opt_bool (#num #flt: eqtype) (o: option (bool)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (JBool w)

and enc_opt_str (#num #flt: eqtype) (o: option (string)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (JStr w)

and enc_opt_r_content_hash (#num #flt: eqtype) (o: option (r_content_hash num flt)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (enc_r_content_hash w)

and enc_opt_m_json (#num #flt: eqtype) (o: option (list (string & jval num flt))) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (JObj (enc_entries_m_json w))

and enc_opt_t_time_of_day (#num #flt: eqtype) (o: option (t_time_of_day)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (enc_t_time_of_day w)

and enc_opt_t_bytes (#num #flt: eqtype) (o: option (t_bytes)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (enc_t_bytes w)

(* ======================================================================================
   4. The tag-dispatch decoder. Every cross-type call goes through `get_prop`, whose
      RETURN-TYPE refinement (`jsize (Ok?.v r) < jsize el`) is the termination argument:
      a decoder that descends by NAME into a value it looked up has no syntactic one.
      Value decoders sit at tier 0 on `jsize`, walkers at tier 1 on `jsizes` / `fsize`.
   ====================================================================================== *)

let rec dec_node (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (node num flt)) (decreases %[(jsize el <: nat); 0]) =
  let oid : outcome string = str_field "id" el in
  let ok : outcome (vkind num flt) = (match get_prop "kind" el with | Error e -> Error e | Ok v -> dec_vkind v) in
  let o0 : outcome (option (bool)) = rd_node__Node__hidden #num #flt el in
  let o1 : outcome (option (string)) = rd_node__Node__label #num #flt el in
  (match oid with | Error e -> Error e | Ok i -> (match ok with | Error e -> Error e | Ok k -> (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__node__Node i k f0 f1)))))

and dec_vkind (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (vkind num flt)) (decreases %[(jsize el <: nat); 0]) =
  match str_field "$type" el with
  | Error e -> Error e
  | Ok tag ->
    if tag = "Embed" then
      let o0 : outcome (string) = (match get_prop "componentId" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      let o1 : outcome (option (r_content_hash num flt)) = (match get_prop "contentHash" el with | Error _ -> Ok None | Ok v -> (match dec_r_content_hash v with | Error e -> Error e | Ok w -> Ok (Some w))) in
      let o2 : outcome (string) = (match get_prop "moduleId" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      let o3 : outcome (option (list (string & jval num flt))) = (match get_prop "props" el with | Error _ -> Ok None | Ok v -> (match v with | JObj fs -> (match dec_entries_m_json [] fs with | Error e -> Error e | Ok w -> Ok (Some w)) | other -> Error ("expected object, got " ^ kind_name other))) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> Ok (C__vkind__Embed f0 f1 f2 f3)))))
    else
    if tag = "Group" then
      let o0 : outcome (list (node num flt)) = (match get_prop "children" el with | Error e -> Error e | Ok v -> (match v with | JArr ys -> (match dec_items_l_node [] ys with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected array, got " ^ kind_name other))) in
      let o1 : outcome (e_layout_kind) = (match get_prop "layout" el with | Error _ -> Ok C__e_layout_kind__Stack | Ok v -> (match dec_e_layout_kind v with | Error e -> Error e | Ok w -> Ok w)) in
      let o2 : outcome (unit) = (match get_prop "onSelect" el with | Error e -> Error e | Ok v -> (let _ = v in let w = () in Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> Ok (C__vkind__Group f0 f1 f2))))
    else
    if tag = "Link" then
      let o0 : outcome (u_slot__str num flt) = (match get_prop "href" el with | Error e -> Error e | Ok v -> (match dec_u_slot__str v with | Error e -> Error e | Ok w -> Ok w)) in
      let o1 : outcome (u_text num flt) = (match get_prop "label" el with | Error e -> Error e | Ok v -> (match dec_u_text v with | Error e -> Error e | Ok w -> Ok w)) in
      let o2 : outcome (unit) = (match get_prop "onClick" el with | Error e -> Error e | Ok v -> (let _ = v in let w = () in Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> Ok (C__vkind__Link f0 f1 f2))))
    else
    if tag = "Note" then
      let o0 : outcome (u_text num flt) = (match get_prop "body" el with | Error e -> Error e | Ok v -> (match dec_u_text v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__vkind__Note f0))
    else
    if tag = "Tally" then
      let o0 : outcome (t_decimal) = (match get_prop "amount" el with | Error e -> Error e | Ok v -> (match dec_t_decimal v with | Error e -> Error e | Ok w -> Ok w)) in
      let o1 : outcome (option (t_time_of_day)) = rd_vkind__Tally__at #num #flt el in
      let o2 : outcome (t_int64) = (match get_prop "count" el with | Error e -> Error e | Ok v -> (match dec_t_int64 v with | Error e -> Error e | Ok w -> Ok w)) in
      let o3 : outcome (option (t_bytes)) = rd_vkind__Tally__digest #num #flt el in
      let o4 : outcome (list (((num & bool) & string))) = (match get_prop "grid" el with | Error e -> Error e | Ok v -> (match v with | JArr ys -> (match dec_items_l_tp2_tp2_int_bool_str [] ys with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected array, got " ^ kind_name other))) in
      let o5 : outcome (list ((e_level & t_duration))) = (match get_prop "levels" el with | Error e -> Error e | Ok v -> (match v with | JArr ys -> (match dec_items_l_tp2_e_level_t_duration [] ys with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected array, got " ^ kind_name other))) in
      let o6 : outcome ((t_int64 & (string & flt))) = (match get_prop "pair" el with | Error e -> Error e | Ok v -> (match dec_tp2_t_int64_tp2_str_flt v with | Error e -> Error e | Ok w -> Ok w)) in
      let o7 : outcome (t_duration) = (match get_prop "span" el with | Error e -> Error e | Ok v -> (match dec_t_duration v with | Error e -> Error e | Ok w -> Ok w)) in
      let o8 : outcome (list (string)) = (match get_prop "tags" el with | Error e -> Error e | Ok v -> (match v with | JArr ys -> (match dec_items_l_str [] ys with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected array, got " ^ kind_name other))) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> (match o4 with | Error e -> Error e | Ok f4 -> (match o5 with | Error e -> Error e | Ok f5 -> (match o6 with | Error e -> Error e | Ok f6 -> (match o7 with | Error e -> Error e | Ok f7 -> (match o8 with | Error e -> Error e | Ok f8 -> Ok (C__vkind__Tally f0 f1 f2 f3 f4 f5 f6 f7 f8))))))))))
    else
    Error ("unknown kind: " ^ tag)

and dec_r_content_hash (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (r_content_hash num flt)) (decreases %[(jsize el <: nat); 0]) =
  let o0 : outcome (string) = (match get_prop "hash" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
  let o1 : outcome (e_strictness) = (match get_prop "strictness" el with | Error e -> Error e | Ok v -> (match dec_e_strictness v with | Error e -> Error e | Ok w -> Ok w)) in
  (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__r_content_hash__Mk f0 f1)))

and dec_u_slot__str (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (u_slot__str num flt)) (decreases %[(jsize el <: nat); 0]) =
  match str_field "$type" el with
  | Error e -> Error e
  | Ok tag ->
    if tag = "Fixed" then
      let o0 : outcome (string) = (match get_prop "value" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__u_slot__str__Fixed f0))
    else
    if tag = "Ref" then
      let o0 : outcome (string) = (match get_prop "name" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__u_slot__str__Ref f0))
    else
    Error ("unknown u_slot__str case: " ^ tag)

and dec_u_text (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (u_text num flt)) (decreases %[(jsize el <: nat); 0]) =
  match str_field "$type" el with
  | Error e -> Error e
  | Ok tag ->
    if tag = "Inline" then
      let o0 : outcome (string) = (match get_prop "text" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> Ok (C__u_text__Inline f0))
    else
    if tag = "Lookup" then
      let o0 : outcome (option (list (string & string))) = (match get_prop "args" el with | Error _ -> Ok None | Ok v -> (match v with | JObj fs -> (match dec_entries_m_str [] fs with | Error e -> Error e | Ok w -> Ok (Some w)) | other -> Error ("expected object, got " ^ kind_name other))) in
      let o1 : outcome (string) = (match get_prop "key" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__u_text__Lookup f0 f1)))
    else
    Error ("unknown u_text case: " ^ tag)

and dec_entries_m_json (#num #flt: eqtype) (acc: list (string & jval num flt)) (fs: list (string & jval num flt)) : Tot (outcome (list (string & jval num flt))) (decreases %[(fsize fs <: nat); 1]) =
  match fs with
  | [] -> Ok (rev acc)
  | (k, v) :: rest ->
    (match Ok v with
     | Ok w -> dec_entries_m_json ((k, w) :: acc) rest
     | Error e -> Error e)

and dec_items_l_node (#num #flt: eqtype) (acc: list (node num flt)) (ys: list (jval num flt)) : Tot (outcome (list (node num flt))) (decreases %[(jsizes ys <: nat); 1]) =
  match ys with
  | [] -> Ok (rev acc)
  | y :: rest ->
    (match dec_node y with
     | Ok w -> dec_items_l_node (w :: acc) rest
     | Error e -> Error e)

and dec_entries_m_str (#num #flt: eqtype) (acc: list (string & string)) (fs: list (string & jval num flt)) : Tot (outcome (list (string & string))) (decreases %[(fsize fs <: nat); 1]) =
  match fs with
  | [] -> Ok (rev acc)
  | (k, v) :: rest ->
    (match as_string v with
     | Ok w -> dec_entries_m_str ((k, w) :: acc) rest
     | Error e -> Error e)

and dec_items_l_tp2_tp2_int_bool_str (#num #flt: eqtype) (acc: list (((num & bool) & string))) (ys: list (jval num flt)) : Tot (outcome (list (((num & bool) & string)))) (decreases %[(jsizes ys <: nat); 1]) =
  match ys with
  | [] -> Ok (rev acc)
  | y :: rest ->
    (match dec_tp2_tp2_int_bool_str y with
     | Ok w -> dec_items_l_tp2_tp2_int_bool_str (w :: acc) rest
     | Error e -> Error e)

and dec_items_l_tp2_e_level_t_duration (#num #flt: eqtype) (acc: list ((e_level & t_duration))) (ys: list (jval num flt)) : Tot (outcome (list ((e_level & t_duration)))) (decreases %[(jsizes ys <: nat); 1]) =
  match ys with
  | [] -> Ok (rev acc)
  | y :: rest ->
    (match dec_tp2_e_level_t_duration y with
     | Ok w -> dec_items_l_tp2_e_level_t_duration (w :: acc) rest
     | Error e -> Error e)

and dec_items_l_str (#num #flt: eqtype) (acc: list (string)) (ys: list (jval num flt)) : Tot (outcome (list (string))) (decreases %[(jsizes ys <: nat); 1]) =
  match ys with
  | [] -> Ok (rev acc)
  | y :: rest ->
    (match as_string y with
     | Ok w -> dec_items_l_str (w :: acc) rest
     | Error e -> Error e)

