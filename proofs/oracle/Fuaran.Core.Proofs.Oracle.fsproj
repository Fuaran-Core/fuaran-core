<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="WarningsAsErrors">
  <!-- Phase 131 — the ORACLE: the F* model of the DAG fold (../DagFold.fst), extracted to F# by
       F*'s F# code generator, compiled as an ordinary assembly so the Expecto suite can run it
       beside the production `Dag.reconcileMany` over the same lane sets. Never packed: nothing
       extracted enters the shipped kernel. DagFold.fs is GENERATED — regenerate it with
       `pwsh ../check.ps1 -Extract`; the proof leg fails when the committed file and a fresh
       extraction differ, which is what makes "the oracle IS the model" a checked claim. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- The extracted code is not this repository's style: generated, and formatted by the
         extractor. Fantomas does not run over proofs/, and the warnings the extraction style
         raises (unused pattern variables, less-generic constructs) are the extractor's to keep. -->
    <NoWarn>$(NoWarn);FS0058;FS0064;FS1182</NoWarn>
    <!-- FS0025 (incomplete matches) is an ERROR everywhere else in this repository
         (Directory.Build.props, Phase 294) and is switched off HERE, for this project only. The
         extractor emits one projector per field of a union case (`__proj__SAppend__item__parent`
         and the like) as a `match` over that single case, partial by construction, and the model's
         own proof is what discharges the other cases; F# cannot see that proof. Silenced rather than
         demoted to a warning: the compiler lets a warn-as-error win over a NoWarn, so the code is
         taken out of WarningsAsErrors as well, and `TreatAsLocalProperty` on the root element lets
         that edit stand against a command-line `-p:WarningsAsErrors=...`, which would otherwise be a
         global property no project file can override. The soundness of those sites is the model's, checked by the proof leg; nothing hand-written
         in this project may rely on the silence. -->
    <NoWarn>$(NoWarn);FS0025</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors.Replace('FS0025', ''))</WarningsAsErrors>
    <!-- The F# backend emits pre-F#-8 layout (match arms at column 1 inside a parenthesised
         lambda), which F# 10's strict indentation rejects outright. Relaxed for THIS project only;
         the finding is recorded in ../README.md. -->
    <!-- WHAT THIS FLAG DOES NOT COVER (Phase 169, ../README.md finding 7). The backend also emits
         a mutual TYPE group with the `and` one space in, and F# rejects THAT with FS0010 whether
         or not this relaxation is in force — so an extraction carrying a mutual type group would
         not compile here however far the flag were pushed. It is handled a step earlier instead:
         the leg's EXTRACT stage runs ../kit/extraction-post-pass.ps1 over each fresh extraction
         before the byte diff, so the committed oracles are text this project can build. Nothing
         below is affected today (no model here has a mutual type group), and the pass is the
         identity on every file in this directory — ../kit/extraction-post-pass.tests.ps1 checks
         that, and carries the condition under which the pass is retired. -->
    <OtherFlags>$(OtherFlags) --strict-indentation-</OtherFlags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Prims.fs" />
    <!-- Phase 133 — the other half of the hand-written runtime floor: F*'s `option`, which the
         backend emits as `FStar_Pervasives_Native` and the release does not ship either. Like
         Prims.fs it is NOT generated and NOT diffed by the leg. -->
    <Compile Include="FStar_Pervasives_Native.fs" />
    <!-- roster:begin - GENERATED from ../modules.json by the tool's `render oracle-project` (tools/Fuaran.Core.Tools): every extracted and shared module, in check order. Do not hand-edit. -->
    <Compile Include="Twin.fs" />
    <Compile Include="ListAlgebra.fs" />
    <Compile Include="DagFold.fs" />
    <Compile Include="DagClosure.fs" />
    <Compile Include="WireDecode.fs" />
    <Compile Include="TreeOps.fs" />
    <Compile Include="Skeleton.fs" />
    <Compile Include="Chain.fs" />
    <Compile Include="JsonParse.fs" />
    <Compile Include="Preservation.fs" />
    <Compile Include="TreeDiff.fs" />
    <Compile Include="Limits.fs" />
    <Compile Include="WireCanon.fs" />
    <Compile Include="WireVersioning.fs" />
    <Compile Include="Unit.fs" />
    <Compile Include="Temporal.fs" />
    <Compile Include="WireColumn.fs" />
    <Compile Include="Relation.fs" />
    <Compile Include="Propagation.fs" />
    <Compile Include="Capability.fs" />
    <Compile Include="Query.fs" />
    <Compile Include="Arbitrate.fs" />
    <Compile Include="DecimalText.fs" />
    <Compile Include="Normalize.fs" />
    <Compile Include="ColumnRefinement.fs" />
    <Compile Include="DecodeLayer.fs" />
    <Compile Include="OpStreamLoad.fs" />
    <Compile Include="DagPrimitives.fs" />
    <!-- roster:end -->
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
