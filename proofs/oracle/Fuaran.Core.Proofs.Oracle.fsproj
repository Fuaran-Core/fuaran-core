<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- Phase 131 — the ORACLE: the F* model of the DAG fold (../DagFold.fst), extracted to F# by
       F*'s F# code generator, compiled as an ordinary assembly so the Expecto suite can run it
       beside the production `Dag.reconcileMany` over the same lane sets. Never packed: nothing
       extracted enters the shipped kernel. DagFold.fs is GENERATED — regenerate it with
       `pwsh ../check.ps1 -Extract`; the proof leg fails when the committed file and a fresh
       extraction differ, which is what makes "the oracle IS the model" a checked claim. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- The extracted code is not this repository's style: generated, and formatted by the
         extractor. Fantomas does not run over proofs/, and the warnings the extraction style
         raises (unused pattern variables, less-generic constructs) are the extractor's to keep. -->
    <NoWarn>$(NoWarn);FS0058;FS0064;FS1182</NoWarn>
    <!-- The F# backend emits pre-F#-8 layout (match arms at column 1 inside a parenthesised
         lambda), which F# 10's strict indentation rejects outright. Relaxed for THIS project only;
         the finding is recorded in ../README.md. -->
    <!-- WHAT THIS FLAG DOES NOT COVER (Phase 169, ../README.md finding 7). The backend also emits
         a mutual TYPE group with the `and` one space in, and F# rejects THAT with FS0010 whether
         or not this relaxation is in force — so an extraction carrying a mutual type group would
         not compile here however far the flag were pushed. It is handled a step earlier instead:
         the leg's EXTRACT stage runs ../kit/extraction-post-pass.ps1 over each fresh extraction
         before the byte diff, so the committed oracles are text this project can build. Nothing
         below is affected today (no model here has a mutual type group), and the pass is the
         identity on every file in this directory — ../kit/extraction-post-pass.tests.ps1 checks
         that, and carries the condition under which the pass is retired. -->
    <OtherFlags>$(OtherFlags) --strict-indentation-</OtherFlags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Prims.fs" />
    <!-- Phase 133 — the other half of the hand-written runtime floor: F*'s `option`, which the
         backend emits as `FStar_Pervasives_Native` and the release does not ship either. Like
         Prims.fs it is NOT generated and NOT diffed by the leg. -->
    <Compile Include="FStar_Pervasives_Native.fs" />
    <Compile Include="DagFold.fs" />
    <!-- Phase 135 — the model of the wire DECODE combinators (../WireDecode.fst). GENERATED
         by the same extractor, regenerated by the same `pwsh ../check.ps1 -Extract`, held to a
         fresh extraction by the same leg. Appended after DagFold.fs: the two models share
         nothing but Prims.fs above. -->
    <Compile Include="WireDecode.fs" />
    <!-- Phase 133 — the model of the skeleton-op TREE ALGEBRA (../TreeOps.fst) and the composite
         fold theorem over it (../Skeleton.fst). GENERATED by the same extractor, regenerated by
         the same `pwsh ../check.ps1 -Extract`, held to a fresh extraction by the same leg.
         Appended in dependency order: TreeOps opens DagFold, Skeleton opens both. Unlike the two
         models above these do NOT share only Prims.fs — that is the point, since the composite
         theorem is an instantiation of DagFold's rather than a second model beside it. -->
    <Compile Include="TreeOps.fs" />
    <Compile Include="Skeleton.fs" />
    <!-- Phase 136 — the model of the two INTEGRITY WALKERS (../Chain.fst): the content-addressed
         DAG's `Dag.firstBreak` and the linear chain's `OpStream.firstChainBreak`, with tamper
         detection proved under a named injective-hash premise. GENERATED by the same extractor,
         regenerated by the same `pwsh ../check.ps1 -Extract`, held to a fresh extraction by the
         same leg. Appended last, and independent: it opens nothing and shares nothing with the
         models above but Prims.fs. -->
    <Compile Include="Chain.fs" />
    <!-- Phase 146 — the model of the recursive-descent JSON PARSER (../JsonParse.fst): the depth
         bound, the int53 token guard and the exhaustiveness of the error classification, which is
         the boundary Phase 135's theorem 1 named. GENERATED by the same extractor, regenerated by
         the same `pwsh ../check.ps1 -Extract`, held to a fresh extraction by the same leg.
         Independent: it opens nothing and shares nothing with the models above but Prims.fs. -->
    <Compile Include="JsonParse.fs" />
    <!-- Phase 138 — the model of the APPLY ENGINE's preservation theorem (../Preservation.fst):
         `Ops.apply`'s totality and rejection characterisation, all-or-nothing rejection, id
         uniqueness preserved by every accepted operation, `Ops.canApply` agreeing with `apply`,
         and `Ops.invert`'s round trip. GENERATED by the same extractor, regenerated by the same
         `pwsh ../check.ps1 -Extract`, held to a fresh extraction by the same leg. It opens
         TreeOps (and through it DagFold), so it follows both. -->
    <Compile Include="Preservation.fs" />
    <!-- Phase 141 — the model of the DIFF (../TreeDiff.fst): `Diff.toOps`'s two refusals characterised
         exactly (so a pair it refuses is one no skeleton script could express), the four-pass
         emission order, what each pass guarantees about the block it emits, and
         `Diff.toOpsContained`'s pre-emptive container refusal. GENERATED by the same extractor,
         regenerated by the same `pwsh ../check.ps1 -Extract`, held to a fresh extraction by the
         same leg. It opens TreeOps (and through it DagFold), so it follows both; it is independent
         of Preservation and sits after it only because that is the order the models were cut. -->
    <Compile Include="TreeDiff.fs" />
    <!-- Phase 149 — the WIRE_FORMAT section-21 resource limits as named premises (../Limits.fst),
         and the model of the CANONICAL ENCODER (../WireCanon.fst): `Canon.escape`,
         `Canon.canonicalFloat` and `Canon.render` clause for clause, a reader for exactly the
         grammar they emit, and the canonical form proved in both directions. GENERATED by the same
         extractor, regenerated by the same `pwsh ../check.ps1 -Extract`, held to a fresh extraction
         by the same leg. Limits.fs precedes WireCanon.fs because WireCanon opens it; neither shares
         anything with the models above but Prims.fs. -->
    <Compile Include="Limits.fs" />
    <Compile Include="WireCanon.fs" />
    <!-- Phase 151 — the model of the EVOLUTION POLICY (../WireVersioning.fst): WIRE_FORMAT §15.4's
         table as theorems about the IDL diff — `Versioning.classify` / `bump` / `negotiate` /
         `decodeTolerant` / `reencode` clause for clause, with the classifier proved sound, an
         additive step proved unobservable to a document that predates it, must-ignore-but-preserve
         proved at the bytes, and the transport-only `Unknown` proved un-constructible from an
         encoder. GENERATED by the same extractor, regenerated by the same
         `pwsh ../check.ps1 -Extract`, held to a fresh extraction by the same leg. It opens
         WireCanon — a tag is a value read out of a `jval`, and the byte claim is stated against
         that module's renderer rather than a second one — so it follows it. -->
    <Compile Include="WireVersioning.fs" />
    <!-- Phase 176 — the model of the COMPUTE strand's op algebra (../ColumnOps.fst):
         `ColumnOps.apply` / `canApply` / `invert` / `Diff.toOps` over a table with a validity
         mask, clause for clause, with totality and its rejection characterisation, all-or-nothing
         rejection, the dry run's agreement, well-formedness preserved by every accepted structural
         operation, `invert`'s round trip (and its partial cases characterised), and `Diff.toOps`'s
         script proved to reconstruct its target. GENERATED by the same extractor, regenerated by
         the same `pwsh ../check.ps1 -Extract`, held to a fresh extraction by the same leg.
         Independent: it opens nothing and shares nothing with the models above but Prims.fs —
         whose `int` alias it is the first to need (a signed row index). -->
    <Compile Include="ColumnOps.fs" />
    <!-- Phase 177 — the model of the FUNCTION SEAM (../Capability.fst): the effect lattice, the
         value spaces, `Function.signature` / `apply` / `curry` / `compose` / `auditEffect` over an
         abstract witness, and `Capability.validateArgs` / `invoke` with `Registry.register` /
         `enumerate` / `dispatch`, clause for clause — default-deny dispatch, validation before
         invocation, enumeration equal to the registry, and the three function laws proved.
         GENERATED by the same extractor, regenerated by the same `pwsh ../check.ps1 -Extract`,
         held to a fresh extraction by the same leg. Independent: it opens nothing and shares
         nothing with the models above but Prims.fs and the option shim; its witness and its
         scalar readers are records of functions the host supplies. -->
    <Compile Include="Capability.fs" />
    <!-- Phase 186 — the model of the INCREMENTAL PROMISE (../Propagation.fst): `dependents`,
         `dirtyFromChangedIds` and its frontier loop, `staleSet`, and the `walk` / `eval` /
         `evalFrom` driver over an abstract node evaluator, clause for clause — the dirty set
         sound and least, incremental evaluation equal to full evaluation under the stated
         evaluator contract, reuse minimal, an unknown change refused. GENERATED by the same
         extractor, regenerated by the same `pwsh ../check.ps1 -Extract`, held to a fresh
         extraction by the same leg. Independent: it opens nothing and shares nothing with the
         models above but Prims.fs and the option shim; the evaluator and the walked order are
         arguments the host supplies. -->
    <Compile Include="Propagation.fs" />
    <!-- Phase 187 — the model of the DATA-ACQUISITION SEAM (../Query.fst): `Query.validateParams` /
         `invoke` / `invocationKey` with `QueryRegistry.register` / `enumerate` / `dispatch`, clause
         for clause over an abstract resolver — default-deny dispatch, validation before resolution,
         enumeration equal to the registry and the capture key's determinism proved. GENERATED by
         the same extractor, regenerated by the same `pwsh ../check.ps1 -Extract`, held to a fresh
         extraction by the same leg. Independent: it opens nothing and shares nothing with the
         models above but Prims.fs and the option shim; the resolver and the four renderers the
         capture key is written through are arguments the host supplies. -->
    <Compile Include="Query.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
