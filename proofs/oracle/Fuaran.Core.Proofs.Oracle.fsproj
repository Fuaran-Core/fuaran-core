<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- Phase 131 — the ORACLE: the F* model of the DAG fold (../DagFold.fst), extracted to F# by
       F*'s F# code generator, compiled as an ordinary assembly so the Expecto suite can run it
       beside the production `Dag.reconcileMany` over the same lane sets. Never packed: nothing
       extracted enters the shipped kernel. DagFold.fs is GENERATED — regenerate it with
       `pwsh ../check.ps1 -Extract`; the proof leg fails when the committed file and a fresh
       extraction differ, which is what makes "the oracle IS the model" a checked claim. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- The extracted code is not this repository's style: generated, and formatted by the
         extractor. Fantomas does not run over proofs/, and the warnings the extraction style
         raises (unused pattern variables, less-generic constructs) are the extractor's to keep. -->
    <NoWarn>$(NoWarn);FS0058;FS0064;FS1182</NoWarn>
    <!-- The F# backend emits pre-F#-8 layout (match arms at column 1 inside a parenthesised
         lambda), which F# 10's strict indentation rejects outright. Relaxed for THIS project only;
         the finding is recorded in ../README.md. -->
    <OtherFlags>$(OtherFlags) --strict-indentation-</OtherFlags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Prims.fs" />
    <!-- Phase 133 — the other half of the hand-written runtime floor: F*'s `option`, which the
         backend emits as `FStar_Pervasives_Native` and the release does not ship either. Like
         Prims.fs it is NOT generated and NOT diffed by the leg. -->
    <Compile Include="FStar_Pervasives_Native.fs" />
    <Compile Include="DagFold.fs" />
    <!-- Phase 135 — the model of the wire DECODE combinators (../WireDecode.fst). GENERATED
         by the same extractor, regenerated by the same `pwsh ../check.ps1 -Extract`, held to a
         fresh extraction by the same leg. Appended after DagFold.fs: the two models share
         nothing but Prims.fs above. -->
    <Compile Include="WireDecode.fs" />
    <!-- Phase 133 — the model of the skeleton-op TREE ALGEBRA (../TreeOps.fst) and the composite
         fold theorem over it (../Skeleton.fst). GENERATED by the same extractor, regenerated by
         the same `pwsh ../check.ps1 -Extract`, held to a fresh extraction by the same leg.
         Appended in dependency order: TreeOps opens DagFold, Skeleton opens both. Unlike the two
         models above these do NOT share only Prims.fs — that is the point, since the composite
         theorem is an instantiation of DagFold's rather than a second model beside it. -->
    <Compile Include="TreeOps.fs" />
    <Compile Include="Skeleton.fs" />
    <!-- Phase 136 — the model of the two INTEGRITY WALKERS (../Chain.fst): the content-addressed
         DAG's `Dag.firstBreak` and the linear chain's `OpStream.firstChainBreak`, with tamper
         detection proved under a named injective-hash premise. GENERATED by the same extractor,
         regenerated by the same `pwsh ../check.ps1 -Extract`, held to a fresh extraction by the
         same leg. Appended last, and independent: it opens nothing and shares nothing with the
         models above but Prims.fs. -->
    <Compile Include="Chain.fs" />
    <!-- Phase 146 — the model of the recursive-descent JSON PARSER (../JsonParse.fst): the depth
         bound, the int53 token guard and the exhaustiveness of the error classification, which is
         the boundary Phase 135's theorem 1 named. GENERATED by the same extractor, regenerated by
         the same `pwsh ../check.ps1 -Extract`, held to a fresh extraction by the same leg.
         Appended last, and independent: it opens nothing and shares nothing with the models above
         but Prims.fs. -->
    <Compile Include="JsonParse.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
