let sfx_vkind__Place__mark (#num #flt: eqtype) (e: option (jval num flt)) (rest: list (string & jval num flt)) : Tot (list (string & jval num flt)) =
  match e with | None -> rest | Some v -> ("mark", v) :: rest

(* The member READERS — one per conditional member of a suffixed constructor whose read calls
   nothing in the decoder family, applied by the decoder below rather than inlined into it.
   Opaque to the solver: only the per-reader value lemmas of the proof script look inside. *)

[@@"opaque_to_smt"]
let rd_vkind__Grid__cols (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (option (num))) =
  (match get_prop "cols" el with | Error _ -> Ok None | Ok v -> (match as_int v with | Error e -> Error e | Ok w -> Ok (Some w)))

[@@"opaque_to_smt"]
let rd_vkind__Grid__template (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (option (string))) =
  (match get_prop "template" el with | Error _ -> Ok None | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok (Some w)))

[@@"opaque_to_smt"]
let rd_vkind__Select__multiple (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (bool)) =
  (match get_prop "multiple" el with | Error _ -> Ok false | Ok v -> (match as_bool v with | Error e -> Error e | Ok w -> Ok w))

[@@"opaque_to_smt"]
let rd_vkind__Select__value (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (option (string))) =
  (match get_prop "value" el with | Error _ -> Ok None | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok (Some w)))

[@@"opaque_to_smt"]
let rd_vkind__Notify__heading (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (option (string))) =
  (match (match get_prop "heading" el with | Ok v -> Ok v | Error e -> (match get_prop "title" el with | Ok v -> Ok v | Error _ -> Error e)) with | Error _ -> Ok None | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok (Some w)))

[@@"opaque_to_smt"]
let rd_vkind__Notify__payload (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (jval num flt)) =
  (match get_prop "payload" el with | Error _ -> Ok (JObj []) | Ok v -> (let w = v in Ok w))

[@@"opaque_to_smt"]
let rd_vkind__Notify__tone (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (e_tone)) =
  (match get_prop "tone" el with | Error _ -> Ok C__e_tone__Default | Ok v -> (match dec_e_tone v with | Error e -> Error e | Ok w -> Ok w))

let rec enc_node (#num #flt: eqtype) (x: node num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__node__Node i k  ->
    JObj (("id", JStr i) :: ("kind", enc_vkind k) :: [])

and enc_vkind (#num #flt: eqtype) (x: vkind num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__vkind__Grid f0 f1 ->
    JObj ((let s1 = sfx_vkind__Grid__template #num #flt (enc_opt_str #num #flt f1) ([]) in let s0 = sfx_vkind__Grid__cols #num #flt (enc_opt_int #num #flt f0) (s1) in ("$type", JStr "Grid") :: s0))
  | C__vkind__Select f0 f1 f2 f3 ->
    JObj ((let s3 = sfx_vkind__Select__values #num #flt (enc_opt_l_str #num #flt f3) ([]) in let s2 = sfx_vkind__Select__value #num #flt (enc_opt_str #num #flt f2) (s3) in let s1 = sfx_vkind__Select__options #num #flt (enc_dflt_l_str #num #flt ([]) f1 (JArr (enc_items_l_str f1))) (s2) in let s0 = sfx_vkind__Select__multiple #num #flt (enc_dflt_bool #num #flt (false) f0) (s1) in ("$type", JStr "Select") :: s0))
  | C__vkind__Notify f0 f1 f2 f3 ->
    JObj ((let s3 = sfx_vkind__Notify__tone #num #flt (enc_dflt_e_tone #num #flt (C__e_tone__Default) f3) ([]) in let s2 = sfx_vkind__Notify__payload #num #flt (enc_dflt_json #num #flt ((JObj [])) f2) (s3) in let s1 = sfx_vkind__Notify__heading #num #flt (enc_opt_str #num #flt f1) (s2) in let s0 = sfx_vkind__Notify__args #num #flt (enc_dflt_m_str #num #flt ([]) f0 (JObj (enc_entries_m_str f0))) (s1) in ("$type", JStr "Notify") :: s0))
  | C__vkind__Place f0 f1 ->
    JObj ((let s1 = sfx_vkind__Place__mark #num #flt (enc_opt_u_mark #num #flt f1) ([]) in let s0 = sfx_vkind__Place__at #num #flt (enc_opt_r_point #num #flt f0) (s1) in ("$type", JStr "Place") :: s0))

and enc_r_point (#num #flt: eqtype) (x: r_point num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__r_point__Mk f0 f1 -> JObj (("x", JInt f0) :: ("y", JInt f1) :: [])

and enc_u_mark (#num #flt: eqtype) (x: u_mark num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__u_mark__Pin f0 f1 ->
    JObj (("$type", JStr "Pin") :: (match f0 with | None -> ("label", JStr f1) :: [] | Some w -> ("at", enc_r_point w) :: ("label", JStr f1) :: []))
  | C__u_mark__Dot  ->
    JObj (("$type", JStr "Dot") :: [])

and enc_items_l_str (#num #flt: eqtype) (xs: list (string)) : Tot (list (jval num flt)) (decreases xs) =
  match xs with
  | [] -> []
  | y :: t -> JStr y :: enc_items_l_str t

and enc_entries_m_str (#num #flt: eqtype) (es: list (string & string)) : Tot (list (string & jval num flt)) (decreases es) =
  match es with
  | [] -> []
  | (k, v) :: t -> (k, JStr v) :: enc_entries_m_str t

and enc_opt_int (#num #flt: eqtype) (o: option (num)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (JInt w)

and enc_opt_str (#num #flt: eqtype) (o: option (string)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (JStr w)

and enc_dflt_bool (#num #flt: eqtype) (d: bool) (v: bool) : Tot (option (jval num flt)) (decreases v) =
  if v = d then None else Some (JBool v)

and enc_dflt_l_str (#num #flt: eqtype) (d: list (string)) (v: list (string)) (e: jval num flt) : Tot (option (jval num flt)) (decreases v) =
  if v = d then None else Some e

and enc_opt_l_str (#num #flt: eqtype) (o: option (list (string))) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (JArr (enc_items_l_str w))

and enc_dflt_m_str (#num #flt: eqtype) (d: list (string & string)) (v: list (string & string)) (e: jval num flt) : Tot (option (jval num flt)) (decreases v) =
  if v = d then None else Some e

and enc_dflt_json (#num #flt: eqtype) (d: jval num flt) (v: jval num flt) : Tot (option (jval num flt)) (decreases v) =
  if v = d then None else Some (v)

and enc_dflt_e_tone (#num #flt: eqtype) (d: e_tone) (v: e_tone) : Tot (option (jval num flt)) (decreases v) =
  if v = d then None else Some (enc_e_tone v)

and enc_opt_r_point (#num #flt: eqtype) (o: option (r_point num flt)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (enc_r_point w)

and enc_opt_u_mark (#num #flt: eqtype) (o: option (u_mark num flt)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (enc_u_mark w)

(* ======================================================================================
   4. The tag-dispatch decoder. Every cross-type call goes through `get_prop`, whose
      RETURN-TYPE refinement (`jsize (Ok?.v r) < jsize el`) is the termination argument:
      a decoder that descends by NAME into a value it looked up has no syntactic one.
      Value decoders sit at tier 0 on `jsize`, walkers at tier 1 on `jsizes` / `fsize`.
   ====================================================================================== *)

let rec dec_node (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (node num flt)) (decreases %[(jsize el <: nat); 0]) =
  let oid : outcome string = str_field "id" el in
  let ok : outcome (vkind num flt) = (match get_prop "kind" el with | Error e -> Error e | Ok v -> dec_vkind v) in
  (match oid with | Error e -> Error e | Ok i -> (match ok with | Error e -> Error e | Ok k -> Ok (C__node__Node i k)))

and dec_vkind (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (vkind num flt)) (decreases %[(jsize el <: nat); 0]) =
  match str_field "$type" el with
  | Error e -> Error e
  | Ok tag ->
    if tag = "Grid" then
      let o1 : outcome (option (string)) = rd_vkind__Grid__template #num #flt el in
      let o0 : outcome (option (num)) = (match o1 with | Error e -> Error e | Ok sv -> if None? sv then rd_vkind__Grid__cols #num #flt el else Ok (None)) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__vkind__Grid f0 f1)))
    else
    if tag = "Select" then
      let o0 : outcome (bool) = rd_vkind__Select__multiple #num #flt el in
      let o1 : outcome (list (string)) = (match (match get_prop "options" el with | Ok v -> Ok v | Error e -> (match get_prop "source" el with | Ok v -> Ok v | Error _ -> (match get_prop "suggestions" el with | Ok v -> Ok v | Error _ -> Error e))) with | Error _ -> Ok [] | Ok v -> (match v with | JArr ys -> (match dec_items_l_str [] ys with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected array, got " ^ kind_name other))) in
      let o2 : outcome (option (string)) = (match o0 with | Error e -> Error e | Ok sv -> if sv = false then rd_vkind__Select__value #num #flt el else Ok (None)) in
      let o3 : outcome (option (list (string))) = (match o0 with | Error e -> Error e | Ok sv -> if sv = true then (match get_prop "values" el with | Error _ -> Ok None | Ok v -> (match v with | JArr ys -> (match dec_items_l_str [] ys with | Error e -> Error e | Ok w -> Ok (Some w)) | other -> Error ("expected array, got " ^ kind_name other))) else Ok (None)) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> Ok (C__vkind__Select f0 f1 f2 f3)))))
    else
    if tag = "Notify" then
      let o0 : outcome (list (string & string)) = (match get_prop "args" el with | Error _ -> Ok [] | Ok v -> (match v with | JObj fs -> (match dec_entries_m_str [] fs with | Error e -> Error e | Ok w -> Ok w) | other -> Error ("expected object, got " ^ kind_name other))) in
      let o1 : outcome (option (string)) = rd_vkind__Notify__heading #num #flt el in
      let o2 : outcome (jval num flt) = rd_vkind__Notify__payload #num #flt el in
      let o3 : outcome (e_tone) = rd_vkind__Notify__tone #num #flt el in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> Ok (C__vkind__Notify f0 f1 f2 f3)))))
    else
    if tag = "Place" then
      let o0 : outcome (option (r_point num flt)) = (match (match get_prop "at" el with | Ok v -> Ok v | Error e -> (match get_prop "position" el with | Ok v -> Ok v | Error _ -> Error e)) with | Error _ -> Ok None | Ok v -> (match dec_r_point v with | Error e -> Error e | Ok w -> Ok (Some w))) in
      let o1 : outcome (option (u_mark num flt)) = (match get_prop "mark" el with | Error _ -> Ok None | Ok v -> (match dec_u_mark v with | Error e -> Error e | Ok w -> Ok (Some w))) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__vkind__Place f0 f1)))
    else
    Error ("unknown kind: " ^ tag)

and dec_r_point (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (r_point num flt)) (decreases %[(jsize el <: nat); 0]) =
  let o0 : outcome (num) = (match (match get_prop "x" el with | Ok v -> Ok v | Error e -> (match get_prop "left" el with | Ok v -> Ok v | Error _ -> Error e)) with | Error e -> Error e | Ok v -> (match as_int v with | Error e -> Error e | Ok w -> Ok w)) in
  let o1 : outcome (num) = (match get_prop "y" el with | Error e -> Error e | Ok v -> (match as_int v with | Error e -> Error e | Ok w -> Ok w)) in
  (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__r_point__Mk f0 f1)))

and dec_u_mark (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (u_mark num flt)) (decreases %[(jsize el <: nat); 0]) =
  match str_field "$type" el with
  | Error e -> Error e
  | Ok tag ->
    if tag = "Pin" then
      let o0 : outcome (option (r_point num flt)) = (match (match get_prop "at" el with | Ok v -> Ok v | Error e -> (match get_prop "where" el with | Ok v -> Ok v | Error _ -> Error e)) with | Error _ -> Ok None | Ok v -> (match dec_r_point v with | Error e -> Error e | Ok w -> Ok (Some w))) in
      let o1 : outcome (string) = (match (match get_prop "label" el with | Ok v -> Ok v | Error e -> (match get_prop "text" el with | Ok v -> Ok v | Error _ -> Error e)) with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__u_mark__Pin f0 f1)))
    else
    if tag = "Dot" then
      Ok C__u_mark__Dot
    else
    Error ("unknown u_mark case: " ^ tag)

and dec_items_l_str (#num #flt: eqtype) (acc: list (string)) (ys: list (jval num flt)) : Tot (outcome (list (string))) (decreases %[(jsizes ys <: nat); 1]) =
  match ys with
  | [] -> Ok (rev acc)
  | y :: rest ->
    (match as_string y with
     | Ok w -> dec_items_l_str (w :: acc) rest
     | Error e -> Error e)

and dec_entries_m_str (#num #flt: eqtype) (acc: list (string & string)) (fs: list (string & jval num flt)) : Tot (outcome (list (string & string))) (decreases %[(fsize fs <: nat); 1]) =
  match fs with
  | [] -> Ok (rev acc)
  | (k, v) :: rest ->
    (match as_string v with
     | Ok w -> dec_entries_m_str ((k, w) :: acc) rest
     | Error e -> Error e)

