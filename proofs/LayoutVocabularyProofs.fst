and rt_u_field__Check (#num #flt: eqtype) (x: u_field num flt) : Lemma (requires (C__u_field__Check? x)) (ensures dec_u_field (enc_u_field #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_field__Check f0 f1 -> ()

and rt_items_l_str (#num #flt: eqtype) (acc: list (string)) (xs: list (string)) : Lemma (ensures dec_items_l_str acc (enc_items_l_str #num #flt xs) == Ok (rev_app acc xs)) (decreases %[xs; 2]) =
  match xs with
  | [] -> ()
  | y :: t -> rt_items_l_str #num #flt (y :: acc) t

and rt_items_l_l_str (#num #flt: eqtype) (acc: list (list (string))) (xs: list (list (string))) : Lemma (ensures dec_items_l_l_str acc (enc_items_l_l_str #num #flt xs) == Ok (rev_app acc xs)) (decreases %[xs; 2]) =
  match xs with
  | [] -> ()
  | y :: t -> rt_items_l_str #num #flt [] y; rt_items_l_l_str #num #flt (y :: acc) t

(* ======================================================================================
   3a. THE READING DECIDES. For EVERY input, a decoder answers a constructor holding a
       case of a presence-keyed union only where that union's reading of the input's own
       keys (D220.3) picked that case, and every member the case SYNTHESISES is present at
       its declared value. Two cases left is the answer of no constructor, and neither is
       none left where the union is required: such a document is REFUSED, and no document
       is read as two constructors of one holder.
   ====================================================================================== *)

let dec_vkind_reads (#num #flt: eqtype) (el: jval num flt)
  : Lemma (ensures (match dec_vkind #num #flt el with
                    | Ok (C__vkind__Grid__NoRowIdentity__Source _ _ _ _ _) -> pick_u_row_identity #num #flt el == PN__u_row_identity /\ pick_u_grid_rows #num #flt el == PK__u_grid_rows__Source
                    | Ok (C__vkind__Grid__NoRowIdentity__StaticRows _ _ _ _ _ _) -> pick_u_row_identity #num #flt el == PN__u_row_identity /\ pick_u_grid_rows #num #flt el == PK__u_grid_rows__StaticRows /\ get_prop "source" el == Ok (JObj [("$type", (JStr "Static")); ("value", (JArr []))])
                    | Ok (C__vkind__Grid__RowKey__Source _ _ _ _ _ _) -> pick_u_row_identity #num #flt el == PK__u_row_identity__RowKey /\ pick_u_grid_rows #num #flt el == PK__u_grid_rows__Source
                    | Ok (C__vkind__Grid__RowKey__StaticRows _ _ _ _ _ _ _) -> pick_u_row_identity #num #flt el == PK__u_row_identity__RowKey /\ pick_u_grid_rows #num #flt el == PK__u_grid_rows__StaticRows /\ get_prop "source" el == Ok (JObj [("$type", (JStr "Static")); ("value", (JArr []))])
                    | Ok (C__vkind__Grid__RowKeyField__Source _ _ _ _ _ _) -> pick_u_row_identity #num #flt el == PK__u_row_identity__RowKeyField /\ pick_u_grid_rows #num #flt el == PK__u_grid_rows__Source
                    | Ok (C__vkind__Grid__RowKeyField__StaticRows _ _ _ _ _ _ _) -> pick_u_row_identity #num #flt el == PK__u_row_identity__RowKeyField /\ pick_u_grid_rows #num #flt el == PK__u_grid_rows__StaticRows /\ get_prop "source" el == Ok (JObj [("$type", (JStr "Static")); ("value", (JArr []))])
                    | _ -> True))
  = ()

(* ======================================================================================
   4. TOTALITY. That the decoders type-check at `Tot` is the termination proof; what the
      lemma adds is that the outcome is exactly one of the two, for EVERY input — the
      failure classification is exhaustive rather than merely non-empty.
   ====================================================================================== *)

let dec_node_total (#num #flt: eqtype) (el: jval num flt)
  : Lemma (ensures (Ok? (dec_node el) \/ Error? (dec_node el)) /\
                   ~(Ok? (dec_node el) /\ Error? (dec_node el)))
  = ()

