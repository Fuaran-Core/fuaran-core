(* ======================================================================================
   3. THE ROUND TRIP. One mutual induction over the whole family, recursing on the MODEL
      value — F*'s subterm order spans a mutual inductive family, so each case needs only
      the sub-lemmas of the members it carries. ONE LEMMA PER CONSTRUCTOR: a wide one is
      proved by citing section 2's lookups, a member at a time, rather than by carrying
      its object shapes into this query.
   ====================================================================================== *)

let rec rt_node (#num #flt: eqtype) (x: node num flt) : Lemma (ensures dec_node (enc_node #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__node__Node i k -> rt_vkind #num #flt k

and rt_vkind (#num #flt: eqtype) (x: vkind num flt) : Lemma (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__vkind__Grid__NoRowIdentity__Source _ _ _ _ _ -> rt_vkind__Grid__NoRowIdentity__Source #num #flt x
  | C__vkind__Grid__NoRowIdentity__StaticRows _ _ _ _ _ _ -> rt_vkind__Grid__NoRowIdentity__StaticRows #num #flt x
  | C__vkind__Grid__RowKey__Source _ _ _ _ _ _ -> rt_vkind__Grid__RowKey__Source #num #flt x
  | C__vkind__Grid__RowKey__StaticRows _ _ _ _ _ _ _ -> rt_vkind__Grid__RowKey__StaticRows #num #flt x
  | C__vkind__Grid__RowKeyField__Source _ _ _ _ _ _ -> rt_vkind__Grid__RowKeyField__Source #num #flt x
  | C__vkind__Grid__RowKeyField__StaticRows _ _ _ _ _ _ _ -> rt_vkind__Grid__RowKeyField__StaticRows #num #flt x
  | C__vkind__Form _ -> rt_vkind__Form #num #flt x

and rt_vkind__Grid__NoRowIdentity__Source (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__Grid__NoRowIdentity__Source? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__Grid__NoRowIdentity__Source f0 f1 f2 f3 f4 ->
    rv_vkind__Grid__NoRowIdentity__Source__caption #num #flt x;
    lk_vkind__Grid__NoRowIdentity__Source__columns #num #flt x;
    rv_vkind__Grid__NoRowIdentity__Source__page_size #num #flt x;
    rv_vkind__Grid__NoRowIdentity__Source__page_state_key #num #flt x;
    lk_vkind__Grid__NoRowIdentity__Source__source #num #flt x;
    pk_vkind__Grid__NoRowIdentity__Source__identity #num #flt x; pk_vkind__Grid__NoRowIdentity__Source__rows #num #flt x; rt_items_l_str #num #flt [] f1; rt_u_feed #num #flt f4

and rt_vkind__Grid__NoRowIdentity__StaticRows (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__Grid__NoRowIdentity__StaticRows? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__Grid__NoRowIdentity__StaticRows f0 f1 f2 f3 f4 f5 ->
    rv_vkind__Grid__NoRowIdentity__StaticRows__caption #num #flt x;
    lk_vkind__Grid__NoRowIdentity__StaticRows__columns #num #flt x;
    rv_vkind__Grid__NoRowIdentity__StaticRows__page_size #num #flt x;
    rv_vkind__Grid__NoRowIdentity__StaticRows__page_state_key #num #flt x;
    lk_vkind__Grid__NoRowIdentity__StaticRows__source #num #flt x;
    lk_vkind__Grid__NoRowIdentity__StaticRows__static_rows #num #flt x;
    pk_vkind__Grid__NoRowIdentity__StaticRows__identity #num #flt x; pk_vkind__Grid__NoRowIdentity__StaticRows__rows #num #flt x; rt_items_l_str #num #flt [] f1; rt_r_static_table #num #flt f5

and rt_vkind__Grid__RowKey__Source (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__Grid__RowKey__Source? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__Grid__RowKey__Source f0 f1 f2 f3 f4 f5 ->
    rv_vkind__Grid__RowKey__Source__caption #num #flt x;
    lk_vkind__Grid__RowKey__Source__columns #num #flt x;
    rv_vkind__Grid__RowKey__Source__page_size #num #flt x;
    rv_vkind__Grid__RowKey__Source__page_state_key #num #flt x;
    lk_vkind__Grid__RowKey__Source__row_key #num #flt x;
    lk_vkind__Grid__RowKey__Source__source #num #flt x;
    pk_vkind__Grid__RowKey__Source__identity #num #flt x; pk_vkind__Grid__RowKey__Source__rows #num #flt x; rt_items_l_str #num #flt [] f1; rt_u_feed #num #flt f5

and rt_vkind__Grid__RowKey__StaticRows (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__Grid__RowKey__StaticRows? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__Grid__RowKey__StaticRows f0 f1 f2 f3 f4 f5 f6 ->
    rv_vkind__Grid__RowKey__StaticRows__caption #num #flt x;
    lk_vkind__Grid__RowKey__StaticRows__columns #num #flt x;
    rv_vkind__Grid__RowKey__StaticRows__page_size #num #flt x;
    rv_vkind__Grid__RowKey__StaticRows__page_state_key #num #flt x;
    lk_vkind__Grid__RowKey__StaticRows__row_key #num #flt x;
    lk_vkind__Grid__RowKey__StaticRows__source #num #flt x;
    lk_vkind__Grid__RowKey__StaticRows__static_rows #num #flt x;
    pk_vkind__Grid__RowKey__StaticRows__identity #num #flt x; pk_vkind__Grid__RowKey__StaticRows__rows #num #flt x; rt_items_l_str #num #flt [] f1; rt_r_static_table #num #flt f6

and rt_vkind__Grid__RowKeyField__Source (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__Grid__RowKeyField__Source? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__Grid__RowKeyField__Source f0 f1 f2 f3 f4 f5 ->
    rv_vkind__Grid__RowKeyField__Source__caption #num #flt x;
    lk_vkind__Grid__RowKeyField__Source__columns #num #flt x;
    rv_vkind__Grid__RowKeyField__Source__page_size #num #flt x;
    rv_vkind__Grid__RowKeyField__Source__page_state_key #num #flt x;
    lk_vkind__Grid__RowKeyField__Source__row_key_field #num #flt x;
    lk_vkind__Grid__RowKeyField__Source__source #num #flt x;
    pk_vkind__Grid__RowKeyField__Source__identity #num #flt x; pk_vkind__Grid__RowKeyField__Source__rows #num #flt x; rt_items_l_str #num #flt [] f1; rt_u_feed #num #flt f5

and rt_vkind__Grid__RowKeyField__StaticRows (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__Grid__RowKeyField__StaticRows? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__Grid__RowKeyField__StaticRows f0 f1 f2 f3 f4 f5 f6 ->
    rv_vkind__Grid__RowKeyField__StaticRows__caption #num #flt x;
    lk_vkind__Grid__RowKeyField__StaticRows__columns #num #flt x;
    rv_vkind__Grid__RowKeyField__StaticRows__page_size #num #flt x;
    rv_vkind__Grid__RowKeyField__StaticRows__page_state_key #num #flt x;
    lk_vkind__Grid__RowKeyField__StaticRows__row_key_field #num #flt x;
    lk_vkind__Grid__RowKeyField__StaticRows__source #num #flt x;
    lk_vkind__Grid__RowKeyField__StaticRows__static_rows #num #flt x;
    pk_vkind__Grid__RowKeyField__StaticRows__identity #num #flt x; pk_vkind__Grid__RowKeyField__StaticRows__rows #num #flt x; rt_items_l_str #num #flt [] f1; rt_r_static_table #num #flt f6

and rt_vkind__Form (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__Form? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__Form f0 -> rt_u_field #num #flt f0

and rt_u_feed (#num #flt: eqtype) (x: u_feed num flt) : Lemma (ensures dec_u_feed (enc_u_feed #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__u_feed__Static _ -> rt_u_feed__Static #num #flt x
  | C__u_feed__State _ -> rt_u_feed__State #num #flt x

and rt_u_feed__Static (#num #flt: eqtype) (x: u_feed num flt) : Lemma (requires (C__u_feed__Static? x)) (ensures dec_u_feed (enc_u_feed #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_feed__Static f0 -> ()

and rt_u_feed__State (#num #flt: eqtype) (x: u_feed num flt) : Lemma (requires (C__u_feed__State? x)) (ensures dec_u_feed (enc_u_feed #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_feed__State f0 -> ()

and rt_r_static_table (#num #flt: eqtype) (x: r_static_table num flt) : Lemma (ensures dec_r_static_table (enc_r_static_table #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__r_static_table__Mk f0 f1 -> rt_items_l_str #num #flt [] f0; rt_items_l_l_str #num #flt [] f1

and rt_u_field (#num #flt: eqtype) (x: u_field num flt) : Lemma (ensures dec_u_field (enc_u_field #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__u_field__Text _ _ -> rt_u_field__Text #num #flt x
  | C__u_field__Check _ _ -> rt_u_field__Check #num #flt x

and rt_u_field__Text (#num #flt: eqtype) (x: u_field num flt) : Lemma (requires (C__u_field__Text? x)) (ensures dec_u_field (enc_u_field #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
