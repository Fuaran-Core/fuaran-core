  | C__u_binding__flt__Local f0 f1 -> ()

and rt_u_binding__flt__Bounded (#num #flt: eqtype) (x: u_binding__flt num flt) : Lemma (requires (C__u_binding__flt__Bounded? x)) (ensures dec_u_binding__flt (enc_u_binding__flt #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_binding__flt__Bounded f0 -> rt_r_ranged__flt #num #flt f0

and rt_u_shape (#num #flt: eqtype) (x: u_shape num flt) : Lemma (ensures dec_u_shape (enc_u_shape #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__u_shape__Span _ -> rt_u_shape__Span #num #flt x
  | C__u_shape__Point -> rt_u_shape__Point #num #flt x

and rt_u_shape__Span (#num #flt: eqtype) (x: u_shape num flt) : Lemma (requires (C__u_shape__Span? x)) (ensures dec_u_shape (enc_u_shape #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
