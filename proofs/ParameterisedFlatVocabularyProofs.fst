  match x with
  | C__u_binding__flt__Static _ -> rt_u_binding__flt__Static #num #flt x
  | C__u_binding__flt__Local _ _ -> rt_u_binding__flt__Local #num #flt x
  | C__u_binding__flt__Bounded _ -> rt_u_binding__flt__Bounded #num #flt x

