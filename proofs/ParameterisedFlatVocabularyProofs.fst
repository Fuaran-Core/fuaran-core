(* ======================================================================================
   3. THE ROUND TRIP. One mutual induction over the whole family, recursing on the MODEL
      value — F*'s subterm order spans a mutual inductive family, so each case needs only
      the sub-lemmas of the members it carries. ONE LEMMA PER CONSTRUCTOR: a wide one is
      proved by citing section 2's lookups, a member at a time, rather than by carrying
      its object shapes into this query.
   ====================================================================================== *)

let rec rt_node (#num #flt: eqtype) (x: node num flt) : Lemma (ensures dec_node (enc_node #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__node__Slider _ _ _ _ _ -> rt_node__Slider #num #flt x
  | C__node__Stepper _ _ _ _ -> rt_node__Stepper #num #flt x
  | C__node__Grid _ _ _ _ _ _ -> rt_node__Grid #num #flt x
  | C__node__Outline _ _ _ -> rt_node__Outline #num #flt x
  | C__node__Frame _ _ _ _ -> rt_node__Frame #num #flt x

and rt_node__Slider (#num #flt: eqtype) (x: node num flt) : Lemma (requires (C__node__Slider? x)) (ensures dec_node (enc_node #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__node__Slider i f0 f1 f2 f3 ->
    (match f1 with | None -> lk_node__Slider__marks__absent #num #flt x | Some _ -> lk_node__Slider__marks__present #num #flt x);
    lk_node__Slider__binding #num #flt x;
    (match f3 with | None -> lk_node__Slider__shape__absent #num #flt x | Some _ -> lk_node__Slider__shape__present #num #flt x);
    rt_r_ranged__flt #num #flt f0; (match f1 with | None -> () | Some w -> rt_items_l_r_labelled__flt #num #flt [] w); rt_u_binding__flt #num #flt f2; (match f3 with | None -> () | Some w -> rt_u_shape #num #flt w)

and rt_node__Stepper (#num #flt: eqtype) (x: node num flt) : Lemma (requires (C__node__Stepper? x)) (ensures dec_node (enc_node #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__node__Stepper i f0 f1 f2 ->
    (match f1 with | None -> lk_node__Stepper__window__absent #num #flt x | Some _ -> lk_node__Stepper__window__present #num #flt x);
    (match f2 with | None -> lk_node__Stepper__binding__absent #num #flt x | Some _ -> lk_node__Stepper__binding__present #num #flt x);
    rt_r_ranged__int #num #flt f0; (match f1 with | None -> () | Some w -> rt_r_labelled__r_ranged__int #num #flt w); (match f2 with | None -> () | Some w -> rt_u_binding__int #num #flt w)

and rt_node__Grid (#num #flt: eqtype) (x: node num flt) : Lemma (requires (C__node__Grid? x)) (ensures dec_node (enc_node #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__node__Grid i f0 f1 f2 f3 f4 ->
    rv_node__Grid__cursor #num #flt x;
    (match f2 with | None -> lk_node__Grid__title__absent #num #flt x | Some _ -> lk_node__Grid__title__present #num #flt x);
    (match f3 with | None -> lk_node__Grid__series__absent #num #flt x | Some _ -> lk_node__Grid__series__present #num #flt x);
    (match f4 with | None -> lk_node__Grid__sort__absent #num #flt x | Some _ -> lk_node__Grid__sort__present #num #flt x);
    (match f2 with | None -> () | Some w -> rt_r_labelled__str #num #flt w); (match f3 with | None -> () | Some w -> rt_r_series__flt #num #flt w); (match f4 with | None -> () | Some w -> rt_r_entry__str__e_direction #num #flt w)

and rt_node__Outline (#num #flt: eqtype) (x: node num flt) : Lemma (requires (C__node__Outline? x)) (ensures dec_node (enc_node #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__node__Outline i f0 f1 -> rt_u_tree #num #flt f0; rt_r_tagged__str #num #flt f1

and rt_node__Frame (#num #flt: eqtype) (x: node num flt) : Lemma (requires (C__node__Frame? x)) (ensures dec_node (enc_node #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__node__Frame i f0 f1 f2 -> rt_r_panel__str #num #flt f0; rt_items_l_node #num #flt [] f1

