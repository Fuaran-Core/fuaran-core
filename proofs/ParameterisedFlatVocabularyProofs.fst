and rt_u_shape__Point (#num #flt: eqtype) (x: u_shape num flt) : Lemma (requires (C__u_shape__Point? x)) (ensures dec_u_shape (enc_u_shape #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_shape__Point -> ()

and rt_r_ranged__int (#num #flt: eqtype) (x: r_ranged__int num flt) : Lemma (ensures dec_r_ranged__int (enc_r_ranged__int #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__r_ranged__int__Mk f0 f1 f2 -> (match f2 with | None -> () | Some w -> rt_items_l_int #num #flt [] w)

and rt_r_labelled__r_ranged__int (#num #flt: eqtype) (x: r_labelled__r_ranged__int num flt) : Lemma (ensures dec_r_labelled__r_ranged__int (enc_r_labelled__r_ranged__int #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__r_labelled__r_ranged__int__Mk f0 f1 -> rt_r_ranged__int #num #flt f1

and rt_u_binding__int (#num #flt: eqtype) (x: u_binding__int num flt) : Lemma (ensures dec_u_binding__int (enc_u_binding__int #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__u_binding__int__Static _ -> rt_u_binding__int__Static #num #flt x
  | C__u_binding__int__Local _ _ -> rt_u_binding__int__Local #num #flt x
  | C__u_binding__int__Bounded _ -> rt_u_binding__int__Bounded #num #flt x

and rt_u_binding__int__Static (#num #flt: eqtype) (x: u_binding__int num flt) : Lemma (requires (C__u_binding__int__Static? x)) (ensures dec_u_binding__int (enc_u_binding__int #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_binding__int__Static f0 -> ()

and rt_u_binding__int__Local (#num #flt: eqtype) (x: u_binding__int num flt) : Lemma (requires (C__u_binding__int__Local? x)) (ensures dec_u_binding__int (enc_u_binding__int #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_binding__int__Local f0 f1 -> ()

and rt_u_binding__int__Bounded (#num #flt: eqtype) (x: u_binding__int num flt) : Lemma (requires (C__u_binding__int__Bounded? x)) (ensures dec_u_binding__int (enc_u_binding__int #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_binding__int__Bounded f0 -> rt_r_ranged__int #num #flt f0

and rt_r_labelled__str (#num #flt: eqtype) (x: r_labelled__str num flt) : Lemma (ensures dec_r_labelled__str (enc_r_labelled__str #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__r_labelled__str__Mk f0 f1 -> ()

and rt_r_series__flt (#num #flt: eqtype) (x: r_series__flt num flt) : Lemma (ensures dec_r_series__flt (enc_r_series__flt #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__r_series__flt__Mk f0 -> rt_items_l_r_labelled__flt #num #flt [] f0

and rt_r_entry__str__e_direction (#num #flt: eqtype) (x: r_entry__str__e_direction num flt) : Lemma (ensures dec_r_entry__str__e_direction (enc_r_entry__str__e_direction #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__r_entry__str__e_direction__Mk f0 f1 -> (match f1 with | None -> () | Some w -> rt_e_direction #num #flt w)

and rt_u_tree (#num #flt: eqtype) (x: u_tree num flt) : Lemma (ensures dec_u_tree (enc_u_tree #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__u_tree__Leaf _ -> rt_u_tree__Leaf #num #flt x
  | C__u_tree__Branch _ _ -> rt_u_tree__Branch #num #flt x

and rt_u_tree__Leaf (#num #flt: eqtype) (x: u_tree num flt) : Lemma (requires (C__u_tree__Leaf? x)) (ensures dec_u_tree (enc_u_tree #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_tree__Leaf f0 -> ()

and rt_u_tree__Branch (#num #flt: eqtype) (x: u_tree num flt) : Lemma (requires (C__u_tree__Branch? x)) (ensures dec_u_tree (enc_u_tree #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_tree__Branch f0 f1 -> rt_items_l_r_kid__u_tree #num #flt [] f0; (match f1 with | None -> () | Some w -> rt_r_tagged__u_tree #num #flt w)

and rt_r_kid__u_tree (#num #flt: eqtype) (x: r_kid__u_tree num flt) : Lemma (ensures dec_r_kid__u_tree (enc_r_kid__u_tree #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__r_kid__u_tree__Mk f0 f1 -> rt_u_tree #num #flt f1

and rt_r_tagged__u_tree (#num #flt: eqtype) (x: r_tagged__u_tree num flt) : Lemma (ensures dec_r_tagged__u_tree (enc_r_tagged__u_tree #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__r_tagged__u_tree__Mk f0 f1 f2 ->
    rv_r_tagged__u_tree__Mk__tag #num #flt x;
    (if f1 = [] then lk_r_tagged__u_tree__Mk__items__absent #num #flt x else lk_r_tagged__u_tree__Mk__items__present #num #flt x);
    rv_r_tagged__u_tree__Mk__note #num #flt x;
    rt_items_l_u_tree #num #flt [] f1

and rt_r_tagged__str (#num #flt: eqtype) (x: r_tagged__str num flt) : Lemma (ensures dec_r_tagged__str (enc_r_tagged__str #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__r_tagged__str__Mk f0 f1 f2 ->
    rv_r_tagged__str__Mk__tag #num #flt x;
    (if f1 = [] then lk_r_tagged__str__Mk__items__absent #num #flt x else lk_r_tagged__str__Mk__items__present #num #flt x);
    rv_r_tagged__str__Mk__note #num #flt x;
    rt_items_l_str #num #flt [] f1

and rt_r_panel__str (#num #flt: eqtype) (x: r_panel__str num flt) : Lemma (ensures dec_r_panel__str (enc_r_panel__str #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__r_panel__str__Mk f0 f1 -> rt_node #num #flt f0

and rt_items_l_flt (#num #flt: eqtype) (acc: list (flt)) (xs: list (flt)) : Lemma (ensures dec_items_l_flt acc (enc_items_l_flt #num #flt xs) == Ok (rev_app acc xs)) (decreases %[xs; 2]) =
  match xs with
  | [] -> ()
  | y :: t -> rt_items_l_flt #num #flt (y :: acc) t

and rt_items_l_r_labelled__flt (#num #flt: eqtype) (acc: list (r_labelled__flt num flt)) (xs: list (r_labelled__flt num flt)) : Lemma (ensures dec_items_l_r_labelled__flt acc (enc_items_l_r_labelled__flt #num #flt xs) == Ok (rev_app acc xs)) (decreases %[xs; 2]) =
  match xs with
  | [] -> ()
  | y :: t -> rt_r_labelled__flt #num #flt y; rt_items_l_r_labelled__flt #num #flt (y :: acc) t

and rt_items_l_int (#num #flt: eqtype) (acc: list (num)) (xs: list (num)) : Lemma (ensures dec_items_l_int acc (enc_items_l_int #num #flt xs) == Ok (rev_app acc xs)) (decreases %[xs; 2]) =
  match xs with
  | [] -> ()
  | y :: t -> rt_items_l_int #num #flt (y :: acc) t

and rt_items_l_r_kid__u_tree (#num #flt: eqtype) (acc: list (r_kid__u_tree num flt)) (xs: list (r_kid__u_tree num flt)) : Lemma (ensures dec_items_l_r_kid__u_tree acc (enc_items_l_r_kid__u_tree #num #flt xs) == Ok (rev_app acc xs)) (decreases %[xs; 2]) =
  match xs with
  | [] -> ()
  | y :: t -> rt_r_kid__u_tree #num #flt y; rt_items_l_r_kid__u_tree #num #flt (y :: acc) t

and rt_items_l_u_tree (#num #flt: eqtype) (acc: list (u_tree num flt)) (xs: list (u_tree num flt)) : Lemma (ensures dec_items_l_u_tree acc (enc_items_l_u_tree #num #flt xs) == Ok (rev_app acc xs)) (decreases %[xs; 2]) =
  match xs with
  | [] -> ()
  | y :: t -> rt_u_tree #num #flt y; rt_items_l_u_tree #num #flt (y :: acc) t

and rt_items_l_str (#num #flt: eqtype) (acc: list (string)) (xs: list (string)) : Lemma (ensures dec_items_l_str acc (enc_items_l_str #num #flt xs) == Ok (rev_app acc xs)) (decreases %[xs; 2]) =
  match xs with
  | [] -> ()
  | y :: t -> rt_items_l_str #num #flt (y :: acc) t

and rt_items_l_node (#num #flt: eqtype) (acc: list (node num flt)) (xs: list (node num flt)) : Lemma (ensures dec_items_l_node acc (enc_items_l_node #num #flt xs) == Ok (rev_app acc xs)) (decreases %[xs; 2]) =
  match xs with
  | [] -> ()
  | y :: t -> rt_node #num #flt y; rt_items_l_node #num #flt (y :: acc) t

(* ======================================================================================
   4. TOTALITY. That the decoders type-check at `Tot` is the termination proof; what the
      lemma adds is that the outcome is exactly one of the two, for EVERY input — the
      failure classification is exhaustive rather than merely non-empty.
   ====================================================================================== *)

let dec_node_total (#num #flt: eqtype) (el: jval num flt)
  : Lemma (ensures (Ok? (dec_node el) \/ Error? (dec_node el)) /\
                   ~(Ok? (dec_node el) /\ Error? (dec_node el)))
  = ()

