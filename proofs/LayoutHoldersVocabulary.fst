      let o1 : outcome (string) = (match get_prop "ka" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      let o2 : outcome (unit) = (match get_prop "p" el with | Error e -> Error e | Ok v -> (if v = (JStr "2") then (let w = () in Ok w) else Error "a synthesised member at another value: p")) in
      let o3 : outcome (string) = (match get_prop "r" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      let o4 : outcome (option (string)) = rd_vkind__G__A__R__s #num #flt el in
      let o5 : outcome (option (string)) = rd_vkind__G__A__R__shared #num #flt el in
      let o6 : outcome (string) = rd_vkind__G__A__R__zi #num #flt el in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> (match o4 with | Error e -> Error e | Ok f4 -> (match o5 with | Error e -> Error e | Ok f5 -> (match o6 with | Error e -> Error e | Ok f6 -> Ok (C__vkind__G__A__R f0 f1 f2 f3 f4 f5 f6))))))))
    else
