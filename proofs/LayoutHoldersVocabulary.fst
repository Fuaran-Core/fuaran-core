    JObj ((let s1 = sfx_vkind__G__C__P__zi #num #flt (enc_dflt_str #num #flt ("five") f6) ([]) in let s0 = sfx_vkind__G__C__P__s #num #flt (enc_opt_str #num #flt f4) (("x", (JStr "sx")) :: s1) in ("$type", JStr "G") :: ("ab", JBool f0) :: ("kb", (JStr "seven")) :: ("kc", JBool f2) :: ("p", JStr f3) :: s0))
  | C__vkind__G__C__Q f0 f1 f2 f3 f4 f5 f6 f7 ->
    JObj ((let s1 = sfx_vkind__G__C__Q__zi #num #flt (enc_dflt_str #num #flt ("five") f7) ([]) in let s0 = sfx_vkind__G__C__Q__s #num #flt (enc_opt_str #num #flt f5) (("x", (JStr "sx")) :: s1) in ("$type", JStr "G") :: ("ab", JBool f0) :: ("kb", (JStr "seven")) :: ("kc", JBool f2) :: ("p", (JStr "1")) :: ("q", JStr f4) :: s0))
  | C__vkind__G__C__R f0 f1 f2 f3 f4 f5 f6 f7 ->
    JObj ((let s1 = sfx_vkind__G__C__R__zi #num #flt (enc_dflt_str #num #flt ("five") f7) ([]) in let s0 = sfx_vkind__G__C__R__s #num #flt (enc_opt_str #num #flt f5) (("x", (JStr "sx")) :: s1) in ("$type", JStr "G") :: ("ab", JBool f0) :: ("kb", (JStr "seven")) :: ("kc", JBool f2) :: ("p", (JStr "2")) :: ("r", JStr f4) :: s0))
  | C__vkind__G__C__S f0 f1 f2 f3 f4 f5 f6 ->
    JObj ((let s1 = sfx_vkind__G__C__S__zi #num #flt (enc_dflt_str #num #flt ("five") f6) ([]) in let s0 = sfx_vkind__G__C__S__s #num #flt (enc_opt_str #num #flt f3) (("sk", JStr f4) :: ("x", (JStr "sx")) :: s1) in ("$type", JStr "G") :: ("ab", JBool f0) :: ("kb", (JStr "seven")) :: ("kc", JBool f2) :: s0))
  | C__vkind__H f0 f1 ->
    JObj (("$type", JStr "H") :: (match f0 with | None -> ("t", enc_u_t f1) :: [] | Some w -> ("rec", enc_r_r2 w) :: ("t", enc_u_t f1) :: []))
  | C__vkind__I f0 ->
    JObj (("$type", JStr "I") :: ("b", enc_u_box__str f0) :: [])

and enc_u_t (#num #flt: eqtype) (x: u_t num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__u_t__One f0 f1 f2 ->
    JObj ((let s1 = sfx_u_t__One__zi #num #flt (enc_dflt_str #num #flt ("five") f2) ([]) in let s0 = sfx_u_t__One__s #num #flt (enc_opt_str #num #flt f1) (s1) in ("$type", JStr "One") :: ("ab", JBool f0) :: s0))
  | C__u_t__Two__NoK3 f0 ->
    JObj (("$type", JStr "Two") :: ("n", JStr f0) :: [])
  | C__u_t__Two__P f0 f1 ->
    JObj (("$type", JStr "Two") :: ("n", JStr f0) :: ("p", JStr f1) :: [])
  | C__u_t__Two__Q f0 f1 f2 ->
    JObj (("$type", JStr "Two") :: ("n", JStr f0) :: ("p", (JStr "1")) :: ("q", JStr f2) :: [])
  | C__u_t__Two__R f0 f1 f2 ->
    JObj (("$type", JStr "Two") :: ("n", JStr f0) :: ("p", (JStr "2")) :: ("r", JStr f2) :: [])
  | C__u_t__Two__S f0 f1 ->
    JObj (("$type", JStr "Two") :: ("n", JStr f0) :: ("sk", JStr f1) :: [])

and enc_r_r2 (#num #flt: eqtype) (x: r_r2 num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__r_r2__Mk__A f0 f1 f2 f3 f4 f5 -> JObj ((let s3 = sfx_r_r2__Mk__A__zi #num #flt (enc_dflt_str #num #flt ("five") f5) ([]) in let s2 = sfx_r_r2__Mk__A__tail #num #flt (enc_opt_str #num #flt f4) (s3) in let s1 = sfx_r_r2__Mk__A__shared #num #flt (enc_opt_str #num #flt f3) (s2) in let s0 = sfx_r_r2__Mk__A__s #num #flt (enc_opt_str #num #flt f2) (s1) in ("ab", JBool f0) :: ("ka", JStr f1) :: s0))
  | C__r_r2__Mk__B f0 f1 f2 f3 f4 f5 f6 -> JObj ((let s3 = sfx_r_r2__Mk__B__zi #num #flt (enc_dflt_str #num #flt ("five") f6) ([]) in let s2 = sfx_r_r2__Mk__B__tail #num #flt (enc_opt_str #num #flt f4) (("x", JStr f5) :: s3) in let s1 = sfx_r_r2__Mk__B__shared #num #flt (enc_opt_str #num #flt f3) (s2) in let s0 = sfx_r_r2__Mk__B__s #num #flt (enc_opt_str #num #flt f2) (s1) in ("ab", JBool f0) :: ("kb", JStr f1) :: s0))
  | C__r_r2__Mk__C f0 f1 f2 f3 f4 f5 f6 -> JObj ((let s2 = sfx_r_r2__Mk__C__zi #num #flt (enc_dflt_str #num #flt ("five") f6) ([]) in let s1 = sfx_r_r2__Mk__C__tail #num #flt (enc_opt_str #num #flt f4) (("x", (JStr "sx")) :: s2) in let s0 = sfx_r_r2__Mk__C__s #num #flt (enc_opt_str #num #flt f3) (s1) in ("ab", JBool f0) :: ("kb", (JStr "seven")) :: ("kc", JBool f2) :: s0))

and enc_u_box__str (#num #flt: eqtype) (x: u_box__str num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__u_box__str__Full__NoK3 f0 ->
    JObj (("$type", JStr "Full") :: ("item", JStr f0) :: [])
  | C__u_box__str__Full__P f0 f1 ->
    JObj (("$type", JStr "Full") :: ("item", JStr f0) :: ("p", JStr f1) :: [])
  | C__u_box__str__Full__Q f0 f1 f2 ->
    JObj (("$type", JStr "Full") :: ("item", JStr f0) :: ("p", (JStr "1")) :: ("q", JStr f2) :: [])
  | C__u_box__str__Full__R f0 f1 f2 ->
    JObj (("$type", JStr "Full") :: ("item", JStr f0) :: ("p", (JStr "2")) :: ("r", JStr f2) :: [])
  | C__u_box__str__Full__S f0 f1 ->
    JObj (("$type", JStr "Full") :: ("item", JStr f0) :: ("sk", JStr f1) :: [])
  | C__u_box__str__Empty  ->
    JObj (("$type", JStr "Empty") :: [])

and enc_opt_str (#num #flt: eqtype) (o: option (string)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (JStr w)

and enc_dflt_str (#num #flt: eqtype) (d: string) (v: string) : Tot (option (jval num flt)) (decreases v) =
  if v = d then None else Some (JStr v)

(* ======================================================================================
   4. The tag-dispatch decoder. Every cross-type call goes through `get_prop`, whose
      RETURN-TYPE refinement (`jsize (Ok?.v r) < jsize el`) is the termination argument:
      a decoder that descends by NAME into a value it looked up has no syntactic one.
      Value decoders sit at tier 0 on `jsize`, walkers at tier 1 on `jsizes` / `fsize`.
   ====================================================================================== *)

(* The READING of a presence-keyed union (D220.3): the cases whose key is present, less each
   whose key another present case synthesises. One left is that case; none is no case; two is
   the both-present refusal. A holder's decoder asks it of the holder's own object, and reads
   the picked case's members, and the members that case synthesises, off the same object. *)

type pk_u_k =
  | PK__u_k__A
  | PK__u_k__B
  | PK__u_k__C
  | PN__u_k
  | PB__u_k

[@@"opaque_to_smt"]
let pick_u_k (#num #flt: eqtype) (el: jval num flt) : Tot pk_u_k =
  let p0 = Ok? (get_prop "ka" el) in
  let p1 = Ok? (get_prop "kb" el) in
  let p2 = Ok? (get_prop "kc" el) in
  let c0 = p0 in
  let c1 = p1 && not (p2) in
  let c2 = p2 in
  if c0 then (if c1 || c2 then PB__u_k else PK__u_k__A) else
  if c1 then (if c2 then PB__u_k else PK__u_k__B) else
  if c2 then PK__u_k__C else
  PN__u_k

type pk_u_k3 =
  | PK__u_k3__P
  | PK__u_k3__Q
  | PK__u_k3__R
  | PK__u_k3__S
  | PN__u_k3
  | PB__u_k3

[@@"opaque_to_smt"]
let pick_u_k3 (#num #flt: eqtype) (el: jval num flt) : Tot pk_u_k3 =
  let p0 = Ok? (get_prop "p" el) in
  let p1 = Ok? (get_prop "q" el) in
  let p2 = Ok? (get_prop "r" el) in
  let p3 = Ok? (get_prop "sk" el) in
  let c0 = p0 && not (p1 || p2) in
  let c1 = p1 in
  let c2 = p2 in
  let c3 = p3 in
  if c0 then (if c1 || c2 || c3 then PB__u_k3 else PK__u_k3__P) else
  if c1 then (if c2 || c3 then PB__u_k3 else PK__u_k3__Q) else
  if c2 then (if c3 then PB__u_k3 else PK__u_k3__R) else
  if c3 then PK__u_k3__S else
  PN__u_k3

let rec dec_node (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (node num flt)) (decreases %[(jsize el <: nat); 0]) =
  let oid : outcome string = str_field "id" el in
  let ok : outcome (vkind num flt) = (match get_prop "kind" el with | Error e -> Error e | Ok v -> dec_vkind v) in
  (match oid with | Error e -> Error e | Ok i -> (match ok with | Error e -> Error e | Ok k -> Ok (C__node__Node i k)))

and dec_vkind (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (vkind num flt)) (decreases %[(jsize el <: nat); 0]) =
  match str_field "$type" el with
  | Error e -> Error e
  | Ok tag ->
    if tag = "G" && pick_u_k #num #flt el = PK__u_k__A && pick_u_k3 #num #flt el = PN__u_k3 then
      let o0 : outcome (bool) = (match get_prop "ab" el with | Error e -> Error e | Ok v -> (match as_bool v with | Error e -> Error e | Ok w -> Ok w)) in
      let o1 : outcome (string) = (match get_prop "ka" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      let o2 : outcome (option (string)) = rd_vkind__G__A__NoK3__s #num #flt el in
      let o3 : outcome (option (string)) = rd_vkind__G__A__NoK3__shared #num #flt el in
      let o4 : outcome (string) = rd_vkind__G__A__NoK3__zi #num #flt el in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> (match o4 with | Error e -> Error e | Ok f4 -> Ok (C__vkind__G__A__NoK3 f0 f1 f2 f3 f4))))))
    else
    if tag = "G" && pick_u_k #num #flt el = PK__u_k__A && pick_u_k3 #num #flt el = PK__u_k3__P then
      let o0 : outcome (bool) = (match get_prop "ab" el with | Error e -> Error e | Ok v -> (match as_bool v with | Error e -> Error e | Ok w -> Ok w)) in
      let o1 : outcome (string) = (match get_prop "ka" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      let o2 : outcome (string) = (match get_prop "p" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      let o3 : outcome (option (string)) = rd_vkind__G__A__P__s #num #flt el in
      let o4 : outcome (option (string)) = rd_vkind__G__A__P__shared #num #flt el in
      let o5 : outcome (string) = rd_vkind__G__A__P__zi #num #flt el in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> (match o4 with | Error e -> Error e | Ok f4 -> (match o5 with | Error e -> Error e | Ok f5 -> Ok (C__vkind__G__A__P f0 f1 f2 f3 f4 f5)))))))
    else
    if tag = "G" && pick_u_k #num #flt el = PK__u_k__A && pick_u_k3 #num #flt el = PK__u_k3__Q then
      let o0 : outcome (bool) = (match get_prop "ab" el with | Error e -> Error e | Ok v -> (match as_bool v with | Error e -> Error e | Ok w -> Ok w)) in
      let o1 : outcome (string) = (match get_prop "ka" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      let o2 : outcome (unit) = (match get_prop "p" el with | Error e -> Error e | Ok v -> (if v = (JStr "1") then (let w = () in Ok w) else Error "a synthesised member at another value: p")) in
      let o3 : outcome (string) = (match get_prop "q" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      let o4 : outcome (option (string)) = rd_vkind__G__A__Q__s #num #flt el in
      let o5 : outcome (option (string)) = rd_vkind__G__A__Q__shared #num #flt el in
      let o6 : outcome (string) = rd_vkind__G__A__Q__zi #num #flt el in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> (match o4 with | Error e -> Error e | Ok f4 -> (match o5 with | Error e -> Error e | Ok f5 -> (match o6 with | Error e -> Error e | Ok f6 -> Ok (C__vkind__G__A__Q f0 f1 f2 f3 f4 f5 f6))))))))
    else
    if tag = "G" && pick_u_k #num #flt el = PK__u_k__A && pick_u_k3 #num #flt el = PK__u_k3__R then
