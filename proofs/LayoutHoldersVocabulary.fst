      let o1 : outcome (string) = (match get_prop "kb" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      let o2 : outcome (string) = (match get_prop "p" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      let o3 : outcome (option (string)) = rd_vkind__G__B__P__s #num #flt el in
      let o4 : outcome (option (string)) = rd_vkind__G__B__P__shared #num #flt el in
      let o5 : outcome (string) = (match get_prop "x" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      let o6 : outcome (string) = rd_vkind__G__B__P__zi #num #flt el in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> (match o4 with | Error e -> Error e | Ok f4 -> (match o5 with | Error e -> Error e | Ok f5 -> (match o6 with | Error e -> Error e | Ok f6 -> Ok (C__vkind__G__B__P f0 f1 f2 f3 f4 f5 f6))))))))
    else
    if tag = "G" && pick_u_k #num #flt el = PK__u_k__B && pick_u_k3 #num #flt el = PK__u_k3__Q then
