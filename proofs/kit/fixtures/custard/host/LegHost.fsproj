<Project Sdk="Microsoft.NET.Sdk">
  <!-- The custard-leg fixture's .NET oracle host (Phase 641): it runs the extracted models through
       the project Custard generated, and its exit code is the verdict. Never packed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../proofs/oracle/Custard.fsproj" />
  </ItemGroup>
</Project>
