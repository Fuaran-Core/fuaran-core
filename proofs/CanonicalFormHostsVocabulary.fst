let rd_node__Link__ByRef__hint (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (option (string))) =
  (match get_prop "hint" el with | Error _ -> Ok None | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok (Some w)))

[@@"opaque_to_smt"]
let rd_node__Link__ByRef__hidden (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (option (bool))) =
  (match (match get_prop "hidden" el with | Ok v -> Ok v | Error e -> (match get_prop "isHidden" el with | Ok v -> Ok v | Error _ -> Error e)) with | Error _ -> Ok None | Ok v -> (match as_bool v with | Error e -> Error e | Ok w -> Ok (Some w)))

[@@"opaque_to_smt"]
let rd_node__Link__ByRef__tip (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (option (string))) =
  (match get_prop "tip" el with | Error _ -> Ok None | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok (Some w)))

[@@"opaque_to_smt"]
let rd_node__Label__hidden (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (option (bool))) =
  (match (match get_prop "hidden" el with | Ok v -> Ok v | Error e -> (match get_prop "isHidden" el with | Ok v -> Ok v | Error _ -> Error e)) with | Error _ -> Ok None | Ok v -> (match as_bool v with | Error e -> Error e | Ok w -> Ok (Some w)))

[@@"opaque_to_smt"]
let rd_node__Label__tip (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (option (string))) =
  (match get_prop "tip" el with | Error _ -> Ok None | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok (Some w)))

[@@"opaque_to_smt"]
let rd_r_spot__Mk__s (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (option (string))) =
  (match get_prop "s" el with | Error _ -> Ok None | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok (Some w)))

[@@"opaque_to_smt"]
let rd_r_spot__Mk__t (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (option (string))) =
  (match get_prop "t" el with | Error _ -> Ok None | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok (Some w)))

let rec enc_node (#num #flt: eqtype) (x: node num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__node__Gate i f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 ->
    JObj ((let s10 = sfx_node__Gate__tip #num #flt (enc_opt_str #num #flt f10) ([]) in let s9 = sfx_node__Gate__hidden #num #flt (enc_opt_bool #num #flt f9) (s10) in let s8 = sfx_node__Gate__mode #num #flt (enc_dflt_str #num #flt ("auto") f8) (s9) in let s7 = sfx_node__Gate__alert #num #flt (enc_opt_str #num #flt f7) (s8) in let s6 = sfx_node__Gate__level #num #flt (enc_dflt_e_tone #num #flt (C__e_tone__Default) f6) (s7) in let s5 = sfx_node__Gate__tags #num #flt (enc_opt_l_str #num #flt f5) (s6) in let s4 = sfx_node__Gate__fallback #num #flt (enc_opt_str #num #flt f4) (s5) in let s3 = sfx_node__Gate__note #num #flt (enc_opt_str #num #flt f3) (s4) in let s2 = sfx_node__Gate__open #num #flt (enc_opt_bool #num #flt f2) (s3) in let s1 = sfx_node__Gate__count #num #flt (enc_opt_int #num #flt f1) (s2) in let s0 = sfx_node__Gate__unit #num #flt (enc_opt_str #num #flt f0) (s1) in ("kind", JStr "Gate") :: ("id", JStr i) :: s0))
  | C__node__Place i f0 f1 f2 f3 f4 ->
    JObj ((let s4 = sfx_node__Place__tip #num #flt (enc_opt_str #num #flt f4) ([]) in let s3 = sfx_node__Place__hidden #num #flt (enc_opt_bool #num #flt f3) (s4) in let s2 = sfx_node__Place__spot #num #flt (enc_dflt_r_spot #num #flt ((C__r_spot__Mk (Some "a") (Some "b"))) f2 (enc_r_spot f2)) (s3) in let s1 = sfx_node__Place__mark #num #flt (enc_opt_u_mark #num #flt f1) (s2) in let s0 = sfx_node__Place__at #num #flt (enc_opt_r_point #num #flt f0) (s1) in ("kind", JStr "Place") :: ("id", JStr i) :: s0))
  | C__node__Link__NoSource i f0 f1 f2 f3 ->
    JObj ((let s3 = sfx_node__Link__NoSource__tip #num #flt (enc_opt_str #num #flt f3) ([]) in let s2 = sfx_node__Link__NoSource__hidden #num #flt (enc_opt_bool #num #flt f2) (s3) in let s1 = sfx_node__Link__NoSource__hint #num #flt (enc_opt_str #num #flt f1) (s2) in let s0 = sfx_node__Link__NoSource__title #num #flt (enc_opt_str #num #flt f0) (s1) in ("kind", JStr "Link") :: ("id", JStr i) :: s0))
  | C__node__Link__ByUrl i f0 f1 f2 f3 f4 ->
    JObj ((let s3 = sfx_node__Link__ByUrl__tip #num #flt (enc_opt_str #num #flt f4) ([]) in let s2 = sfx_node__Link__ByUrl__hidden #num #flt (enc_opt_bool #num #flt f3) (s3) in let s1 = sfx_node__Link__ByUrl__hint #num #flt (enc_opt_str #num #flt f1) (("url", JStr f2) :: s2) in let s0 = sfx_node__Link__ByUrl__title #num #flt (enc_opt_str #num #flt f0) (s1) in ("kind", JStr "Link") :: ("id", JStr i) :: s0))
  | C__node__Link__ByRef i f0 f1 f2 f3 f4 ->
    JObj ((let s3 = sfx_node__Link__ByRef__tip #num #flt (enc_opt_str #num #flt f4) ([]) in let s2 = sfx_node__Link__ByRef__hidden #num #flt (enc_opt_bool #num #flt f3) (s3) in let s1 = sfx_node__Link__ByRef__hint #num #flt (enc_opt_str #num #flt f1) (("ref", JStr f2) :: s2) in let s0 = sfx_node__Link__ByRef__title #num #flt (enc_opt_str #num #flt f0) (s1) in ("kind", JStr "Link") :: ("id", JStr i) :: s0))
  | C__node__Label i f0 f1 f2 ->
    JObj ((let s1 = sfx_node__Label__tip #num #flt (enc_opt_str #num #flt f2) ([]) in let s0 = sfx_node__Label__hidden #num #flt (enc_opt_bool #num #flt f1) (s1) in ("kind", JStr "Label") :: ("id", JStr i) :: ("name", JStr f0) :: s0))

and enc_r_point (#num #flt: eqtype) (x: r_point num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__r_point__Mk f0 f1 -> JObj (("x", JInt f0) :: ("y", JInt f1) :: [])

and enc_u_mark (#num #flt: eqtype) (x: u_mark num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__u_mark__Pin f0 f1 ->
    JObj (("kind", JStr "Pin") :: ("label", JStr f0) :: (match f1 with | None -> [] | Some w -> ("at", enc_r_point w) :: []))
  | C__u_mark__Dot  ->
    JObj (("kind", JStr "Dot") :: [])

and enc_r_spot (#num #flt: eqtype) (x: r_spot num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__r_spot__Mk f0 f1 -> JObj ((let s1 = sfx_r_spot__Mk__t #num #flt (enc_opt_str #num #flt f1) ([]) in let s0 = sfx_r_spot__Mk__s #num #flt (enc_opt_str #num #flt f0) (s1) in s0))

and enc_items_l_str (#num #flt: eqtype) (xs: list (string)) : Tot (list (jval num flt)) (decreases xs) =
  match xs with
  | [] -> []
  | y :: t -> JStr y :: enc_items_l_str t

and enc_opt_str (#num #flt: eqtype) (o: option (string)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (JStr w)

and enc_opt_int (#num #flt: eqtype) (o: option (num)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (JInt w)

and enc_opt_bool (#num #flt: eqtype) (o: option (bool)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (JBool w)

and enc_opt_l_str (#num #flt: eqtype) (o: option (list (string))) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (JArr (enc_items_l_str w))

and enc_dflt_e_tone (#num #flt: eqtype) (d: e_tone) (v: e_tone) : Tot (option (jval num flt)) (decreases v) =
  if v = d then None else Some (enc_e_tone v)

and enc_dflt_str (#num #flt: eqtype) (d: string) (v: string) : Tot (option (jval num flt)) (decreases v) =
  if v = d then None else Some (JStr v)

and enc_opt_r_point (#num #flt: eqtype) (o: option (r_point num flt)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (enc_r_point w)

and enc_opt_u_mark (#num #flt: eqtype) (o: option (u_mark num flt)) : Tot (option (jval num flt)) (decreases o) =
  match o with | None -> None | Some w -> Some (enc_u_mark w)

and enc_dflt_r_spot (#num #flt: eqtype) (d: r_spot num flt) (v: r_spot num flt) (e: jval num flt) : Tot (option (jval num flt)) (decreases v) =
  if v = d then None else Some e

(* ======================================================================================
   4. The tag-dispatch decoder. Every cross-type call goes through `get_prop`, whose
      RETURN-TYPE refinement (`jsize (Ok?.v r) < jsize el`) is the termination argument:
      a decoder that descends by NAME into a value it looked up has no syntactic one.
      Value decoders sit at tier 0 on `jsize`, walkers at tier 1 on `jsizes` / `fsize`.
   ====================================================================================== *)

(* The READING of a presence-keyed union (D220.3): the cases whose key is present, less each
   whose key another present case synthesises. One left is that case; none is no case; two is
   the both-present refusal. A holder's decoder asks it of the holder's own object, and reads
   the picked case's members, and the members that case synthesises, off the same object. *)

type pk_u_source =
  | PK__u_source__ByUrl
  | PK__u_source__ByRef
  | PN__u_source
  | PB__u_source

[@@"opaque_to_smt"]
let pick_u_source (#num #flt: eqtype) (el: jval num flt) : Tot pk_u_source =
  let p0 = Ok? (get_prop "url" el) in
  let p1 = Ok? (get_prop "ref" el) in
  let c0 = p0 in
  let c1 = p1 in
  if c0 then (if c1 then PB__u_source else PK__u_source__ByUrl) else
  if c1 then PK__u_source__ByRef else
  PN__u_source

let rec dec_node (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (node num flt)) (decreases %[(jsize el <: nat); 0]) =
  let oid : outcome string = str_field "id" el in
  match str_field "kind" el with
  | Error e -> Error e
  | Ok tag ->
    if tag = "Gate" then
      let o1 : outcome (option (num)) = rd_node__Gate__count #num #flt el in
      let o2 : outcome (option (bool)) = rd_node__Gate__open #num #flt el in
      let o5 : outcome (option (list (string))) = (match (match (match get_prop "tags" el with | Ok v -> Ok v | Error e -> (match get_prop "labels" el with | Ok v -> Ok v | Error _ -> Error e)) with | Error _ -> Ok None | Ok v -> (match v with | JArr ys -> (match dec_items_l_str [] ys with | Error e -> Error e | Ok w -> Ok (Some w)) | other -> Error ("expected array, got " ^ kind_name other))) with | Ok (Some []) -> Ok None | r -> r) in
      let o6 : outcome (e_tone) = rd_node__Gate__level #num #flt el in
      let o9 : outcome (option (bool)) = rd_node__Gate__hidden #num #flt el in
      let o0 : outcome (option (string)) = (match o2 with | Error e -> Error e | Ok sv -> if sv = (Some true) then rd_node__Gate__unit #num #flt el else Ok (None)) in
      let o3 : outcome (option (string)) = (match o2 with | Error e -> Error e | Ok sv -> if Some? sv then rd_node__Gate__note #num #flt el else Ok (None)) in
      let o4 : outcome (option (string)) = (match o2 with | Error e -> Error e | Ok sv -> if None? sv then rd_node__Gate__fallback #num #flt el else Ok (None)) in
      let o7 : outcome (option (string)) = (match o6 with | Error e -> Error e | Ok sv -> if sv = C__e_tone__Critical then rd_node__Gate__alert #num #flt el else Ok (None)) in
      let o8 : outcome (string) = (match o1 with | Error e -> Error e | Ok sv -> if Some? sv then rd_node__Gate__mode #num #flt el else Ok ("auto")) in
      let o10 : outcome (option (string)) = (match o9 with | Error e -> Error e | Ok sv -> if Some? sv then rd_node__Gate__tip #num #flt el else Ok (None)) in
      (match oid with | Error e -> Error e | Ok i -> (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> (match o4 with | Error e -> Error e | Ok f4 -> (match o5 with | Error e -> Error e | Ok f5 -> (match o6 with | Error e -> Error e | Ok f6 -> (match o7 with | Error e -> Error e | Ok f7 -> (match o8 with | Error e -> Error e | Ok f8 -> (match o9 with | Error e -> Error e | Ok f9 -> (match o10 with | Error e -> Error e | Ok f10 -> Ok (C__node__Gate i f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10)))))))))))))
    else
    if tag = "Place" then
      let o0 : outcome (option (r_point num flt)) = (match (match get_prop "at" el with | Ok v -> Ok v | Error e -> (match get_prop "position" el with | Ok v -> Ok v | Error _ -> Error e)) with | Error _ -> Ok None | Ok v -> (match dec_r_point v with | Error e -> Error e | Ok w -> Ok (Some w))) in
      let o1 : outcome (option (u_mark num flt)) = (match get_prop "mark" el with | Error _ -> Ok None | Ok v -> (match dec_u_mark v with | Error e -> Error e | Ok w -> Ok (Some w))) in
      let o2 : outcome (r_spot num flt) = (match get_prop "spot" el with | Error _ -> Ok (C__r_spot__Mk (Some "a") (Some "b")) | Ok v -> (match dec_r_spot v with | Error e -> Error e | Ok w -> Ok w)) in
      let o3 : outcome (option (bool)) = rd_node__Place__hidden #num #flt el in
      let o4 : outcome (option (string)) = (match o3 with | Error e -> Error e | Ok sv -> if Some? sv then rd_node__Place__tip #num #flt el else Ok (None)) in
      (match oid with | Error e -> Error e | Ok i -> (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> (match o4 with | Error e -> Error e | Ok f4 -> Ok (C__node__Place i f0 f1 f2 f3 f4)))))))
    else
    if tag = "Link" && pick_u_source #num #flt el = PN__u_source then
      let o0 : outcome (option (string)) = rd_node__Link__NoSource__title #num #flt el in
      let o2 : outcome (option (bool)) = rd_node__Link__NoSource__hidden #num #flt el in
      let o1 : outcome (option (string)) = (match o0 with | Error e -> Error e | Ok sv -> if Some? sv then rd_node__Link__NoSource__hint #num #flt el else Ok (None)) in
      let o3 : outcome (option (string)) = (match o2 with | Error e -> Error e | Ok sv -> if Some? sv then rd_node__Link__NoSource__tip #num #flt el else Ok (None)) in
      (match oid with | Error e -> Error e | Ok i -> (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> Ok (C__node__Link__NoSource i f0 f1 f2 f3))))))
    else
    if tag = "Link" && pick_u_source #num #flt el = PK__u_source__ByUrl then
      let o0 : outcome (option (string)) = rd_node__Link__ByUrl__title #num #flt el in
      let o2 : outcome (string) = (match get_prop "url" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      let o3 : outcome (option (bool)) = rd_node__Link__ByUrl__hidden #num #flt el in
      let o1 : outcome (option (string)) = (match o0 with | Error e -> Error e | Ok sv -> if Some? sv then rd_node__Link__ByUrl__hint #num #flt el else Ok (None)) in
      let o4 : outcome (option (string)) = (match o3 with | Error e -> Error e | Ok sv -> if Some? sv then rd_node__Link__ByUrl__tip #num #flt el else Ok (None)) in
      (match oid with | Error e -> Error e | Ok i -> (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> (match o4 with | Error e -> Error e | Ok f4 -> Ok (C__node__Link__ByUrl i f0 f1 f2 f3 f4)))))))
    else
    if tag = "Link" && pick_u_source #num #flt el = PK__u_source__ByRef then
      let o0 : outcome (option (string)) = rd_node__Link__ByRef__title #num #flt el in
      let o2 : outcome (string) = (match get_prop "ref" el with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      let o3 : outcome (option (bool)) = rd_node__Link__ByRef__hidden #num #flt el in
      let o1 : outcome (option (string)) = (match o0 with | Error e -> Error e | Ok sv -> if Some? sv then rd_node__Link__ByRef__hint #num #flt el else Ok (None)) in
      let o4 : outcome (option (string)) = (match o3 with | Error e -> Error e | Ok sv -> if Some? sv then rd_node__Link__ByRef__tip #num #flt el else Ok (None)) in
      (match oid with | Error e -> Error e | Ok i -> (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> (match o3 with | Error e -> Error e | Ok f3 -> (match o4 with | Error e -> Error e | Ok f4 -> Ok (C__node__Link__ByRef i f0 f1 f2 f3 f4)))))))
    else
    if tag = "Label" then
      let o0 : outcome (string) = (match (match get_prop "name" el with | Ok v -> Ok v | Error e -> (match get_prop "caption" el with | Ok v -> Ok v | Error _ -> Error e)) with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      let o1 : outcome (option (bool)) = rd_node__Label__hidden #num #flt el in
      let o2 : outcome (option (string)) = (match o1 with | Error e -> Error e | Ok sv -> if Some? sv then rd_node__Label__tip #num #flt el else Ok (None)) in
      (match oid with | Error e -> Error e | Ok i -> (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> (match o2 with | Error e -> Error e | Ok f2 -> Ok (C__node__Label i f0 f1 f2)))))
    else
    Error ("unknown kind, or no case of a presence-keyed union it holds: " ^ tag)

and dec_r_point (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (r_point num flt)) (decreases %[(jsize el <: nat); 0]) =
  let o0 : outcome (num) = (match (match get_prop "x" el with | Ok v -> Ok v | Error e -> (match get_prop "left" el with | Ok v -> Ok v | Error _ -> Error e)) with | Error e -> Error e | Ok v -> (match as_int v with | Error e -> Error e | Ok w -> Ok w)) in
  let o1 : outcome (num) = (match get_prop "y" el with | Error e -> Error e | Ok v -> (match as_int v with | Error e -> Error e | Ok w -> Ok w)) in
  (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__r_point__Mk f0 f1)))

and dec_u_mark (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (u_mark num flt)) (decreases %[(jsize el <: nat); 0]) =
  match str_field "kind" el with
  | Error e -> Error e
  | Ok tag ->
    if tag = "Pin" then
      let o0 : outcome (string) = (match (match get_prop "label" el with | Ok v -> Ok v | Error e -> (match get_prop "text" el with | Ok v -> Ok v | Error _ -> Error e)) with | Error e -> Error e | Ok v -> (match as_string v with | Error e -> Error e | Ok w -> Ok w)) in
      let o1 : outcome (option (r_point num flt)) = (match (match get_prop "at" el with | Ok v -> Ok v | Error e -> (match get_prop "where" el with | Ok v -> Ok v | Error _ -> Error e)) with | Error _ -> Ok None | Ok v -> (match dec_r_point v with | Error e -> Error e | Ok w -> Ok (Some w))) in
      (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__u_mark__Pin f0 f1)))
    else
    if tag = "Dot" then
      Ok C__u_mark__Dot
    else
    Error ("unknown u_mark case: " ^ tag)

and dec_r_spot (#num #flt: eqtype) (el: jval num flt) : Tot (outcome (r_spot num flt)) (decreases %[(jsize el <: nat); 0]) =
  let o0 : outcome (option (string)) = rd_r_spot__Mk__s #num #flt el in
  let o1 : outcome (option (string)) = (match o0 with | Error e -> Error e | Ok sv -> if Some? sv then rd_r_spot__Mk__t #num #flt el else Ok (None)) in
  (match o0 with | Error e -> Error e | Ok f0 -> (match o1 with | Error e -> Error e | Ok f1 -> Ok (C__r_spot__Mk f0 f1)))

and dec_items_l_str (#num #flt: eqtype) (acc: list (string)) (ys: list (jval num flt)) : Tot (outcome (list (string))) (decreases %[(jsizes ys <: nat); 1]) =
  match ys with
  | [] -> Ok (rev acc)
  | y :: rest ->
    (match as_string y with
     | Ok w -> dec_items_l_str (w :: acc) rest
     | Error e -> Error e)

