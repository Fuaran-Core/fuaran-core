module CanonicalFormHostsVocabulary

open WireDecode

#set-options "--ext context_pruning"

(* ======================================================================================
   1. The closed string sets (`TEnum`) — a bare wire string, not an object.
   ====================================================================================== *)

type e_tone =
  | C__e_tone__Default
  | C__e_tone__Success
  | C__e_tone__Critical

let enc_e_tone (#num #flt: eqtype) (x: e_tone) : Tot (jval num flt) =
  match x with
  | C__e_tone__Default -> JStr "Default"
  | C__e_tone__Success -> JStr "Success"
  | C__e_tone__Critical -> JStr "Critical"

let dec_e_tone (#num #flt: eqtype) (el: jval num flt) : Tot (outcome e_tone) =
  match as_string el with
  | Error e -> Error e
  | Ok s ->
    if s = "Default" then Ok C__e_tone__Default else
    if s = "Success" then Ok C__e_tone__Success else
    if s = "Critical" then Ok C__e_tone__Critical else
    if s = "Positive" then Ok C__e_tone__Success else
    if s = "Danger" then Ok C__e_tone__Critical else
    Error ("unknown Tone: " ^ s)

(* ======================================================================================
   2. The vocabulary's types — one mutual group, because a record may hold a union, a
      union a node, and a node a list of nodes. Records are single-constructor types
      rather than F* records so that two objects declaring a `label` cannot collide.
   ====================================================================================== *)

type node (num flt: eqtype) =
  | C__node__Gate : id:string -> unit_:(option (string)) -> count:(option (num)) -> open_:(option (bool)){(open_ = (Some true) || None? unit_)} -> note:(option (string)){(Some? open_ || None? note)} -> fallback:(option (string)){(None? open_ || None? fallback)} -> tags:(option (list (string))){(match tags with | Some [] -> false | _ -> true)} -> level:(e_tone) -> alert:(option (string)){(level = C__e_tone__Critical || None? alert)} -> mode:(string){(Some? count || mode = "auto")} -> hidden:(option (bool)) -> tip:(option (string)){(Some? hidden || None? tip)} -> node num flt
  | C__node__Place : id:string -> at:(option (r_point num flt)) -> mark:(option (u_mark num flt)) -> spot:(r_spot num flt) -> hidden:(option (bool)) -> tip:(option (string)){(Some? hidden || None? tip)} -> node num flt
  | C__node__Link__NoSource : id:string -> title:(option (string)) -> hint:(option (string)){(Some? title || None? hint)} -> hidden:(option (bool)) -> tip:(option (string)){(Some? hidden || None? tip)} -> node num flt
  | C__node__Link__ByUrl : id:string -> title:(option (string)) -> hint:(option (string)){(Some? title || None? hint)} -> url:(string) -> hidden:(option (bool)) -> tip:(option (string)){(Some? hidden || None? tip)} -> node num flt
  | C__node__Link__ByRef : id:string -> title:(option (string)) -> hint:(option (string)){(Some? title || None? hint)} -> ref:(string) -> hidden:(option (bool)) -> tip:(option (string)){(Some? hidden || None? tip)} -> node num flt
  | C__node__Label : id:string -> name:(string) -> hidden:(option (bool)) -> tip:(option (string)){(Some? hidden || None? tip)} -> node num flt

and r_point (num flt: eqtype) =
  | C__r_point__Mk : x:(num) -> y:(num) -> r_point num flt

and u_mark (num flt: eqtype) =
  | C__u_mark__Pin : label:(string) -> at:(option (r_point num flt)) -> u_mark num flt
  | C__u_mark__Dot : u_mark num flt

and r_spot (num flt: eqtype) =
  | C__r_spot__Mk : s:(option (string)) -> t:(option (string)){(Some? s || None? t)} -> r_spot num flt

