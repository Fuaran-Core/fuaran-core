  match x with
  | C__u_box__str__Full__NoK3 f0 -> pk_u_box__str__Full__NoK3__pick #num #flt x

and rt_u_box__str__Full__P (#num #flt: eqtype) (x: u_box__str num flt) : Lemma (requires (C__u_box__str__Full__P? x)) (ensures dec_u_box__str (enc_u_box__str #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_box__str__Full__P f0 f1 -> pk_u_box__str__Full__P__pick #num #flt x

and rt_u_box__str__Full__Q (#num #flt: eqtype) (x: u_box__str num flt) : Lemma (requires (C__u_box__str__Full__Q? x)) (ensures dec_u_box__str (enc_u_box__str #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_box__str__Full__Q f0 f1 f2 -> pk_u_box__str__Full__Q__pick #num #flt x

and rt_u_box__str__Full__R (#num #flt: eqtype) (x: u_box__str num flt) : Lemma (requires (C__u_box__str__Full__R? x)) (ensures dec_u_box__str (enc_u_box__str #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_box__str__Full__R f0 f1 f2 -> pk_u_box__str__Full__R__pick #num #flt x

and rt_u_box__str__Full__S (#num #flt: eqtype) (x: u_box__str num flt) : Lemma (requires (C__u_box__str__Full__S? x)) (ensures dec_u_box__str (enc_u_box__str #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_box__str__Full__S f0 f1 -> pk_u_box__str__Full__S__pick #num #flt x

and rt_u_box__str__Empty (#num #flt: eqtype) (x: u_box__str num flt) : Lemma (requires (C__u_box__str__Empty? x)) (ensures dec_u_box__str (enc_u_box__str #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__u_box__str__Empty -> ()

(* ======================================================================================
   4. TOTALITY. That the decoders type-check at `Tot` is the termination proof; what the
      lemma adds is that the outcome is exactly one of the two, for EVERY input — the
      failure classification is exhaustive rather than merely non-empty.
   ====================================================================================== *)

let dec_node_total (#num #flt: eqtype) (el: jval num flt)
  : Lemma (ensures (Ok? (dec_node el) \/ Error? (dec_node el)) /\
                   ~(Ok? (dec_node el) /\ Error? (dec_node el)))
  = ()

