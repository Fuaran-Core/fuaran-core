let pk_u_box__str__Full__P__pick (#num #flt: eqtype) (x: u_box__str num flt) : Lemma (requires (C__u_box__str__Full__P? x)) (ensures (match x with | C__u_box__str__Full__P f0 f1 -> pick_u_k3 #num #flt (enc_u_box__str #num #flt x) == PK__u_k3__P | _ -> True)) =
  reveal_opaque (`%pick_u_k3) (pick_u_k3 #num #flt (enc_u_box__str #num #flt x));
  match x with
  | C__u_box__str__Full__P f0 f1 -> ()
  | _ -> ()
#pop-options

