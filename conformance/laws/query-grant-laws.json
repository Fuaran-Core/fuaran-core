{
  "family": "queryGrantLaws",
  "kitVersion": "0.45.0",
  "description": "The query registry's grant (Phase 651, DECISIONS.md D261): the identity a grant for a read is bound to, and whether a presented grant covers a read. Authored inputs, each `expected` computed by calling the pinned kit; no seed. `registry` holds the queries the vectors read, each a canonical declaration as a JSON string. A binding is `{name, cell}`, a cell `{kind, text}` with no text for a null (a float's text is its shortest round-trip form, a boolean's `true` or `false`). `invocationIdentity` vectors expect the identity: the fields id; then, when the declaration declares a filter, the three fields \"\", `w` and the canonical text of its `where` member, and when it declares an order, \"\", `o` and the canonical text of its `orderBy` member, filter first; then for each binding, sorted by name (ordinal), its name, its kind's tag (`i` int, `f` float, `b` bool, `s` string, `d` date, `t` timestamp, `m` decimal, `n` null) and its payload (an integer's decimal digits, a float's shortest round-trip text, `1` or `0` for a boolean, a string, date, timestamp or decimal as given, empty for a null); each field written with every U+0010 and U+0001 it holds preceded by U+0010, then terminated by U+0001; no hash is taken. A cell is identified by its kind, so an integer bound to a float parameter and the float of the same value are two reads. `grantCovers` vectors expect whether a presented grant (the `grant` member, an identity; absent when none is presented) is for exactly this read: it is when the two identities are equal as strings. A `pageToken` member names the page the read is dispatched for: it is in neither identity, so a grant for a read covers every page of it, and a page's capture key is no grant. The gate's decision and dispatch are the gate family's (capability-gate-laws.json): one function decides at both registries.",
  "registry": ["{\"$type\":\"query\",\"effect\":{\"determinism\":\"network\",\"host\":\"readsHost\"},\"id\":\"every\",\"pageSize\":50,\"params\":[{\"name\":\"a\",\"required\":false,\"type\":\"int\"},{\"name\":\"b\",\"required\":false,\"type\":\"float\"},{\"name\":\"c\",\"required\":false,\"type\":\"bool\"},{\"name\":\"d\",\"required\":false,\"type\":\"string\"},{\"name\":\"e\",\"required\":false,\"type\":\"date\"},{\"name\":\"f\",\"required\":false,\"type\":\"timestamp_ms\"},{\"name\":\"g\",\"required\":false,\"type\":\"decimal\"}],\"resultSchema\":[{\"name\":\"n\",\"type\":\"int\"},{\"name\":\"region\",\"type\":\"string\"}],\"source\":{\"ref\":\"every\",\"schema\":[]}}", "{\"$type\":\"query\",\"effect\":{\"determinism\":\"network\",\"host\":\"readsHost\"},\"id\":\"ledger\",\"pageSize\":50,\"params\":[{\"name\":\"n\",\"required\":true,\"type\":\"int\"}],\"resultSchema\":[{\"name\":\"n\",\"type\":\"int\"},{\"name\":\"region\",\"type\":\"string\"}],\"source\":{\"ref\":\"ledger\",\"schema\":[]}}", "{\"$type\":\"query\",\"effect\":{\"determinism\":\"network\",\"host\":\"readsHost\"},\"id\":\"shaped\",\"orderBy\":[{\"column\":\"n\",\"direction\":\"descending\"}],\"pageSize\":50,\"params\":[{\"name\":\"n\",\"required\":true,\"type\":\"int\"}],\"resultSchema\":[{\"name\":\"n\",\"type\":\"int\"},{\"name\":\"region\",\"type\":\"string\"}],\"source\":{\"ref\":\"shaped\",\"schema\":[]},\"where\":[{\"$type\":\"contains\",\"column\":\"region\",\"text\":\"eu\"},{\"$type\":\"atLeast\",\"column\":\"n\",\"type\":\"int\",\"value\":2}]}", "{\"$type\":\"query\",\"effect\":{\"determinism\":\"network\",\"host\":\"readsHost\"},\"id\":\"summary\",\"pageSize\":50,\"params\":[{\"name\":\"n\",\"required\":true,\"type\":\"int\"}],\"resultSchema\":[{\"name\":\"n\",\"type\":\"int\"},{\"name\":\"region\",\"type\":\"string\"}],\"source\":{\"ref\":\"summary\",\"schema\":[]}}"],
  "vectors": [
    { "id": "query-identity-ledger", "case": "invocationIdentity", "input": { "query": "ledger", "args": [{ "name": "n", "cell": { "kind": "int", "text": "5" } }] }, "expected": { "identity": "ledger\u0001n\u0001i\u00015\u0001" }, "answeredBy": ["reference","model:Query"] },
    { "id": "query-identity-other-query", "case": "invocationIdentity", "input": { "query": "summary", "args": [{ "name": "n", "cell": { "kind": "int", "text": "5" } }] }, "expected": { "identity": "summary\u0001n\u0001i\u00015\u0001" }, "answeredBy": ["reference","model:Query"] },
    { "id": "query-identity-every-kind", "case": "invocationIdentity", "input": { "query": "every", "args": [{ "name": "a", "cell": { "kind": "int", "text": "-7" } }, { "name": "b", "cell": { "kind": "float", "text": "1.5" } }, { "name": "c", "cell": { "kind": "bool", "text": "true" } }, { "name": "d", "cell": { "kind": "string", "text": "eu-west" } }, { "name": "e", "cell": { "kind": "date", "text": "2026-11-15" } }, { "name": "f", "cell": { "kind": "timestamp", "text": "2026-11-15T09:30:00.250Z" } }, { "name": "g", "cell": { "kind": "decimal", "text": "12.50" } }] }, "expected": { "identity": "every\u0001a\u0001i\u0001-7\u0001b\u0001f\u00011.5\u0001c\u0001b\u00011\u0001d\u0001s\u0001eu-west\u0001e\u0001d\u00012026-11-15\u0001f\u0001t\u00012026-11-15T09:30:00.250Z\u0001g\u0001m\u000112.50\u0001" }, "answeredBy": ["reference","model:Query"] },
    { "id": "query-identity-out-of-name-order", "case": "invocationIdentity", "input": { "query": "every", "args": [{ "name": "g", "cell": { "kind": "decimal", "text": "12.50" } }, { "name": "f", "cell": { "kind": "timestamp", "text": "2026-11-15T09:30:00.250Z" } }, { "name": "e", "cell": { "kind": "date", "text": "2026-11-15" } }, { "name": "d", "cell": { "kind": "string", "text": "eu-west" } }, { "name": "c", "cell": { "kind": "bool", "text": "true" } }, { "name": "b", "cell": { "kind": "float", "text": "1.5" } }, { "name": "a", "cell": { "kind": "int", "text": "-7" } }] }, "expected": { "identity": "every\u0001a\u0001i\u0001-7\u0001b\u0001f\u00011.5\u0001c\u0001b\u00011\u0001d\u0001s\u0001eu-west\u0001e\u0001d\u00012026-11-15\u0001f\u0001t\u00012026-11-15T09:30:00.250Z\u0001g\u0001m\u000112.50\u0001" }, "answeredBy": ["reference","model:Query"] },
