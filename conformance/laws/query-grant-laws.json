    { "id": "query-identity-a-float-for-a-float", "case": "invocationIdentity", "input": { "query": "every", "args": [{ "name": "b", "cell": { "kind": "float", "text": "5" } }] }, "expected": { "identity": "every\u0001b\u0001f\u00015\u0001" }, "answeredBy": ["reference","model:Query"] },
    { "id": "query-identity-shaped", "case": "invocationIdentity", "input": { "query": "shaped", "args": [{ "name": "n", "cell": { "kind": "int", "text": "5" } }] }, "expected": { "identity": "shaped\u0001\u0001w\u0001[{\"$type\":\"contains\",\"column\":\"region\",\"text\":\"eu\"},{\"$type\":\"atLeast\",\"column\":\"n\",\"type\":\"int\",\"value\":2}]\u0001\u0001o\u0001[{\"column\":\"n\",\"direction\":\"descending\"}]\u0001n\u0001i\u00015\u0001" }, "answeredBy": ["reference","model:Query"] },
    { "id": "query-identity-holds-the-separator", "case": "invocationIdentity", "input": { "query": "every", "args": [{ "name": "d", "cell": { "kind": "string", "text": "a\u0001b" } }] }, "expected": { "identity": "every\u0001d\u0001s\u0001a\u0010\u0001b\u0001" }, "answeredBy": ["reference","model:Query"] },
    { "id": "query-identity-holds-the-escape", "case": "invocationIdentity", "input": { "query": "every", "args": [{ "name": "d", "cell": { "kind": "string", "text": "a\u0010\u0001" } }] }, "expected": { "identity": "every\u0001d\u0001s\u0001a\u0010\u0010\u0010\u0001\u0001" }, "answeredBy": ["reference","model:Query"] },
    { "id": "query-grant-own", "case": "grantCovers", "input": { "query": "ledger", "args": [{ "name": "n", "cell": { "kind": "int", "text": "5" } }], "grant": "ledger\u0001n\u0001i\u00015\u0001" }, "expected": { "covers": true }, "answeredBy": ["reference","model:Query"] },
