{
  "family": "skeletonDiff",
  "description": "The content-aware structural diff over the skeleton witness (Phase 549): for `input.before` and `input.after` (the apply/ family's tree envelope, one id space) the skeleton-op script that turns one into the other, and the per-id classification read off the same run. A node's content is its shell, the envelope with no children, so a kind change is an UpdateNode. The verdict is `diff` with `script` (each op in the apply/ family's encoding, in emission order) and `changes` (ascending id, then added, removed, moved, kindChanged, changed, reordered), or `refuse` with the rejection in the apply/ family's projection. The script, applied to `before` by the apply engine, lands on `after`. Every expectation is computed by calling Core (Diff.toOpsWith and Diff.changes, no policy, the plain scope); there is no kitVersion stamp. A keyed scope is not exercised: the witness envelope declares no keyed position.",
  "vectors": [
    { "id": "identity", "case": "diff", "description": "A tree diffed against itself is the empty script and no change.", "input": {"after":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}","before":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}"}, "expected": {"changes":[],"script":[],"verdict":"diff"}, "answeredBy": ["reference"] },
    { "id": "add-leaf", "case": "diff", "description": "A new leaf is one InsertChild under its parent.", "input": {"after":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a3\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}","before":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}"}, "expected": {"changes":[{"id":"a3","kind":{"$type":"added"}}],"script":["{\"$type\":\"insertChild\",\"node\":{\"children\":[],\"id\":\"a3\",\"kind\":\"para\"},\"parent\":\"a\"}"],"verdict":"diff"}, "answeredBy": ["reference"] },
    { "id": "add-subtree", "case": "diff", "description": "A new subtree grafts whole, in one InsertChild; every id in it is added.", "input": {"after":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"c1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"c2\",\"kind\":\"para\"}],\"id\":\"c\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}","before":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}"}, "expected": {"changes":[{"id":"c","kind":{"$type":"added"}},{"id":"c1","kind":{"$type":"added"}},{"id":"c2","kind":{"$type":"added"}}],"script":["{\"$type\":\"insertChild\",\"node\":{\"children\":[],\"id\":\"c\",\"kind\":\"section\"},\"parent\":\"root\"}","{\"$type\":\"insertChild\",\"node\":{\"children\":[],\"id\":\"c1\",\"kind\":\"para\"},\"parent\":\"c\"}","{\"$type\":\"insertChild\",\"node\":{\"children\":[],\"id\":\"c2\",\"kind\":\"para\"},\"parent\":\"c\"}"],"verdict":"diff"}, "answeredBy": ["reference"] },
    { "id": "remove-leaf", "case": "diff", "description": "A vanished leaf is one RemoveNode.", "input": {"after":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}","before":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}"}, "expected": {"changes":[{"id":"a2","kind":{"$type":"removed"}}],"script":["{\"$type\":\"removeNode\",\"target\":\"a2\"}"],"verdict":"diff"}, "answeredBy": ["reference"] },
    { "id": "remove-subtree", "case": "diff", "description": "A vanished subtree is removed at its top; every id below it is classified removed.", "input": {"after":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}","before":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}"}, "expected": {"changes":[{"id":"b","kind":{"$type":"removed"}},{"id":"b1","kind":{"$type":"removed"}}],"script":["{\"$type\":\"removeNode\",\"target\":\"b\"}"],"verdict":"diff"}, "answeredBy": ["reference"] },
    { "id": "move", "case": "diff", "description": "A survivor under a new parent is a MoveNode.", "input": {"after":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}","before":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}"}, "expected": {"changes":[{"id":"a2","kind":{"$type":"moved","from":"a","to":"b"}}],"script":["{\"$type\":\"moveNode\",\"newParent\":\"b\",\"target\":\"a2\"}"],"verdict":"diff"}, "answeredBy": ["reference"] },
    { "id": "reorder", "case": "diff", "description": "Kept children in a new order are one ReorderChildren of their parent.", "input": {"after":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}","before":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}"}, "expected": {"changes":[{"id":"a","kind":{"$type":"reordered"}}],"script":["{\"$type\":\"reorderChildren\",\"order\":[\"a2\",\"a1\"],\"parent\":\"a\"}"],"verdict":"diff"}, "answeredBy": ["reference"] },
    { "id": "kind-change", "case": "diff", "description": "A survivor whose kind changed is an UpdateNode carrying its new shell, classified kindChanged.", "input": {"after":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"quote\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}","before":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}"}, "expected": {"changes":[{"id":"a1","kind":{"$type":"kindChanged","from":"para","to":"quote"}}],"script":["{\"$type\":\"updateNode\",\"node\":{\"children\":[],\"id\":\"a1\",\"kind\":\"quote\"}}"],"verdict":"diff"}, "answeredBy": ["reference"] },
    { "id": "move-and-kind-change", "case": "diff", "description": "A survivor that moved and changed kind carries both: the move and the update.", "input": {"after":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"quote\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}","before":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}"}, "expected": {"changes":[{"id":"a2","kind":{"$type":"moved","from":"a","to":"b"}},{"id":"a2","kind":{"$type":"kindChanged","from":"para","to":"quote"}}],"script":["{\"$type\":\"updateNode\",\"node\":{\"children\":[],\"id\":\"a2\",\"kind\":\"quote\"}}","{\"$type\":\"moveNode\",\"newParent\":\"b\",\"target\":\"a2\"}"],"verdict":"diff"}, "answeredBy": ["reference"] },
    { "id": "move-into-new-node", "case": "diff", "description": "A survivor moved under a node the after tree adds: the graft comes first, then the move.", "input": {"after":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"}],\"id\":\"c\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}","before":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}"}, "expected": {"changes":[{"id":"a1","kind":{"$type":"moved","from":"a","to":"c"}},{"id":"c","kind":{"$type":"added"}}],"script":["{\"$type\":\"insertChild\",\"node\":{\"children\":[],\"id\":\"c\",\"kind\":\"section\"},\"parent\":\"root\"}","{\"$type\":\"moveNode\",\"newParent\":\"c\",\"target\":\"a1\"}"],"verdict":"diff"}, "answeredBy": ["reference"] },
    { "id": "insert-before-kept", "case": "diff", "description": "A child added before a kept one: the graft appends, so a reorder restates the order.", "input": {"after":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"n\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}","before":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}"}, "expected": {"changes":[{"id":"n","kind":{"$type":"added"}}],"script":["{\"$type\":\"insertChild\",\"node\":{\"children\":[],\"id\":\"n\",\"kind\":\"para\"},\"parent\":\"a\"}","{\"$type\":\"reorderChildren\",\"order\":[\"n\",\"a1\",\"a2\"],\"parent\":\"a\"}"],"verdict":"diff"}, "answeredBy": ["reference"] },
    { "id": "combined", "case": "diff", "description": "An add, a removal, a move and a kind change in one diff.", "input": {"after":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"},{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"group\"},{\"children\":[{\"children\":[],\"id\":\"x\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}","before":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}"}, "expected": {"changes":[{"id":"a","kind":{"$type":"kindChanged","from":"section","to":"group"}},{"id":"a1","kind":{"$type":"removed"}},{"id":"b1","kind":{"$type":"moved","from":"b","to":"a"}},{"id":"x","kind":{"$type":"added"}}],"script":["{\"$type\":\"updateNode\",\"node\":{\"children\":[{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"},{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"group\"}}","{\"$type\":\"insertChild\",\"node\":{\"children\":[],\"id\":\"x\",\"kind\":\"para\"},\"parent\":\"b\"}","{\"$type\":\"moveNode\",\"newParent\":\"a\",\"target\":\"b1\"}","{\"$type\":\"removeNode\",\"target\":\"a1\"}"],"verdict":"diff"}, "answeredBy": ["reference"] },
    { "id": "refuse-root-id", "case": "diff", "description": "Two trees whose roots differ share no id space at the root: refused.", "input": {"after":"{\"children\":[],\"id\":\"other\",\"kind\":\"doc\"}","before":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}"}, "expected": {"rejection":"{\"$type\":\"rootIdMismatch\",\"after\":\"other\",\"before\":\"root\"}","verdict":"refuse"}, "answeredBy": ["reference"] },
    { "id": "refuse-duplicate-id", "case": "diff", "description": "An after tree holding an id twice is not a tree: refused.", "input": {"after":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}","before":"{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}"}, "expected": {"rejection":"{\"$type\":\"duplicateId\",\"id\":\"a1\"}","verdict":"refuse"}, "answeredBy": ["reference"] }
  ]
