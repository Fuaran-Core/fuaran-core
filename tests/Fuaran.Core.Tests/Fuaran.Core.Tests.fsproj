<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Reference.fs" />
    <Compile Include="Reference2.fs" />
    <!-- The `Hash` pin suite — the FIPS 180-4 known-answer vectors and platform byte-equality for
         SHA-256, plus the pinned FNV-1a values. First: everything below folds through one or the
         other, so a digest defect should surface as itself rather than as a downstream mismatch. -->
    <Compile Include="HashTests.fs" />
    <Compile Include="TreeTests.fs" />
    <Compile Include="TreeExtTests.fs" />
    <Compile Include="OpsTests.fs" />
    <Compile Include="CanApplyTests.fs" />
    <Compile Include="ContainedOpsTests.fs" />
    <Compile Include="InvertTests.fs" />
    <Compile Include="DiffTests.fs" />
    <Compile Include="OpStreamTests.fs" />
    <Compile Include="IdempotentAppendTests.fs" />
    <Compile Include="SnapshotTests.fs" />
    <Compile Include="WireTests.fs" />
    <Compile Include="DecodeTests.fs" />
    <Compile Include="ValidatorTests.fs" />
    <Compile Include="ObserverTests.fs" />
    <Compile Include="FunctionTests.fs" />
    <Compile Include="EffectAuditTests.fs" />
    <Compile Include="SchemaTests.fs" />
    <Compile Include="ConformanceTests.fs" />
    <Compile Include="FootprintTests.fs" />
    <Compile Include="ConcurrencyTests.fs" />
    <Compile Include="WitnessLawTests.fs" />
    <Compile Include="WitnessSurfaceTests.fs" />
    <Compile Include="ReducerTests.fs" />
    <Compile Include="DagTests.fs" />
    <Compile Include="ProvenanceTests.fs" />
    <Compile Include="ColumnTests.fs" />
    <Compile Include="DataFrameTests.fs" />
    <Compile Include="ColumnOpsTests.fs" />
    <!-- Phase 98 — the column layer's typed delta: the algebra laws, the wire, and the
         reference identity witness. After the columnar suites it builds on. -->
    <Compile Include="DeltaTests.fs" />
    <!-- Phase 99 — the incremental evaluation seam: the generated equivalence family, the
         measured footprints, and one case per way out of the incremental path. -->
    <Compile Include="IncrementalTests.fs" />
    <Compile Include="QueryTests.fs" />
    <Compile Include="Snapshots.fs" />
    <!-- Pins the UTF-8 decoding of a redirected child's stdout, so the cross-host
         suites below do not depend on the console code page the runner inherited.
         Before its first consumer; it references nothing here. -->
    <Compile Include="ChildProcess.fs" />
    <!-- Phase 172 — where the conformance families THIS repository emits live (the committed
         conformance/ directory) and the registry's fingerprint equality their published copies
         are held to. Reads Snapshots.fs above for the repo-root marker and nothing else here.
         Before SiblingCorpus.fs, which is its counterpart for the corpus another repository
         owns, and before every exporter and suite that reads the owned files. -->
    <Compile Include="OwnedConformance.fs" />
    <!-- Phase 130 — the one lookup for the shared conformance corpus, anchored at the
         repository's MAIN working tree (git's own common-dir question) so a linked worktree
         resolves what the main tree resolves, and loud rather than silent when the corpus
         is absent. Phase 172 put the opt-in gate (FUARAN_CORE_CORPUS_FRESHNESS) in front of
         it: the live-corpus legs run only when asked for, and fail as before once they are.
         Before its consumers (the nodes/ drift guard below, the proof-oracle pools, the laws/
         and apply/ copy-freshness legs further down); reads ChildProcess.fs above and nothing
         else here. -->
    <Compile Include="SiblingCorpus.fs" />
    <Compile Include="IdlSpikeTests.fs" />
    <Compile Include="IdlEnumWireTests.fs" />
    <!-- Phases 108/109 - the declared wire shape (discriminator key + node envelope),
         exercised on the axes the readiness spikes do not cover. -->
    <Compile Include="IdlWireShapeTests.fs" />
    <!-- Phase 113 - declared annotations on union cases and fields: the wire is
         untouched, every other surface renders them. Appended here (append-only
         registration), after the wire-shape family it shares its fixture shape with. -->
    <Compile Include="IdlAnnotationTests.fs" />
    <Compile Include="IdlKindAnnotationTests.fs" />
    <!-- Phase 702 — the vocabulary-change proposal document and the branchless spike
         that prices it. Reads the mini IDL from Fuaran.Core.Idl.Spike, so after the
         Idl families above. -->
    <Compile Include="IdlProposalTests.fs" />
    <Compile Include="VersioningTests.fs" />
    <Compile Include="AiSurfaceTests.fs" />
    <Compile Include="ProjectionTests.fs" />
    <Compile Include="PropagationTests.fs" />
    <Compile Include="LeaseTests.fs" />
    <Compile Include="MergeTests.fs" />
    <Compile Include="ArbitrationTests.fs" />
    <!-- Phase 102 - the null-tolerant read: the conformance family plus the
         strict-parser-unchanged pins. Appended at the end of the list; it depends on
         nothing here. -->
    <Compile Include="WireNullToleranceTests.fs" />
    <!-- Phase 100 - the fold-confluence pack: N-lane arrival-order invariance over the
         reference witness, a second non-tree domain, and the order-sensitive go-red case.
         Depends on nothing here either, so it simply follows. -->
    <Compile Include="FoldConfluenceTests.fs" />
    <!-- Phase 139 — the `apply/` corpus family: the host-neutral skeleton envelope, its codec,
         and the emitter behind the `emit-apply` flag. It sits HERE rather than beside the other
         corpus exporters further down because ProofOracleTests.fs below reads its decoder, to run the
         Phase 138 preservation differential over the committed fixtures as a second host beside
         the generator. Reads Reference.fs and the kit, and nothing else here. -->
    <Compile Include="ApplyVectorExport.fs" />
    <!-- Phase 131 — the F* oracle as a corpus host: the extracted model of the DAG fold run
         beside the production Dag.reconcileMany over the Phase 100 lane generators (which it
         reads from FoldConfluenceTests.fs above) and over the wire corpus's ops/ fixtures. -->
    <Compile Include="ProofOracleTests.fs" />
    <!-- The second-vocabulary readiness spike - throwaway measurement code, kept for its
         findings. Declares a slice of a foreign vocabulary against the IDL and certifies it
         against a corpus of sample documents written in that vocabulary's wire shape,
         vendored at fixtures/second-domain/ so the legs run in any clone. Reads nothing
         here, so it simply follows. -->
    <!-- Phases 108/109 - the second-vocabulary slice's generated F# module in its
         DECLARED wire shape (kind discriminator, flat envelope). AUTO-GENERATED:
         regenerate via the regen-snapshots entry point; the drift guard in
         SecondDomainSpike.fs fails when it and the generator disagree. -->
    <Compile Include="DocGenerated.fs" />
    <Compile Include="SecondDomainSpike.fs" />
    <!-- The third-vocabulary (score-shaped) readiness spike - same posture as the second:
         throwaway measurement code, kept for its findings. Certifies a score-shaped slice
         against samples vendored at fixtures/score-domain/. -->
    <Compile Include="ScoreDomainSpike.fs" />
    <!-- Phase 114 - the engine's own domain-neutral reference VOCABULARY (the D7
         reference-witness posture applied to the IDL) plus its declared-support
         document, and the certification that runs over it and the two vendored foreign
         vocabularies. Appended at the end of the list: the certification enumerates
         which leg each neutral vocabulary carries, so it must follow both spikes. -->
    <Compile Include="ReferenceIdl.fs" />
    <Compile Include="IdlCertificationTests.fs" />
    <!-- Phase 700 — the diff classifier over two `idl.json` revisions. Named
         IdlDiffTests, not DiffTests: the latter is Phase 245's TREE diff. Moved
         here by Phase 123: its scale cases read the reference vocabulary now that
         the UI fixture has left, so it compiles after ReferenceIdl.fs. -->
    <Compile Include="IdlDiffTests.fs" />
    <!-- Phase 115 - the incremental seam run against the vendored `incremental-recompute`
         corpus vectors at fixtures/incremental-recompute/ (the control that must not move,
         and the sort vector whose class does). Reads nothing here, so it simply follows. -->
    <Compile Include="IncrementalCorpusTests.fs" />
    <Compile Include="SampleAdequacyTests.fs" />
    <!-- Phase 118 - the cross-pipeline vector table, LINKED from the Fable smoke rather than
         copied: the .NET pin and the `node` diff have to be measuring the same source, or the
         comparison certifies a coincidence. Reads nothing here, so it simply follows. -->
    <Compile Include="..\fable-smoke\ParityVectors.fs" Link="ParityVectors.fs" />
    <Compile Include="ParityVectorTests.fs" />
    <!-- The host-neutral export of the transform-parity family's reference answers, and the
         checks that keep it an oracle: the law over the declared sample, a decode-and-recompute
         pass over every rendered vector, and the comparison against the shared corpus when it is
         checked out alongside. Reads nothing here, so it simply follows. -->
    <Compile Include="LawVectorExport.fs" />
    <Compile Include="LawVectorTests.fs" />
    <!-- Phase 139 — the checks that keep the `apply/` family an oracle: a decode-and-recompute
         pass over every rendered vector, three go-reds proving the pass can fail, the sample's
         adequacy to its own description, and the byte comparison against the shared corpus.
         Reads ApplyVectorExport.fs above and SiblingCorpus.fs; appended beside the sibling
         law-vector family it mirrors. -->
    <Compile Include="ApplyVectorTests.fs" />
    <!-- Phase 126 — the construct-then-encode family over the reference witness: the authoring
         surface certified, and the go-red on a constructor that widens a field the encoder does
         not expect. Reads only Reference.fs and the kit, so it simply follows. -->
    <Compile Include="ConstructThenEncodeTests.fs" />
    <!-- Phase 129 — the generated artefact's line endings are the generator's, not those of
         whichever checkout compiled it. Reads only the spike vocabulary from the src project,
         so it simply follows. -->
    <Compile Include="IdlCodegenEolTests.fs" />
    <!-- Phase 195 — the codegen's refusals as DATA: the required node-envelope member, the
         op-vocabulary slot in each backend that meets it, the HostOnly slot with no placeholder
         and the transparent case of the wrong arity. Declares its own one-kind vocabularies and
         reads only the emitters from the src project, so it simply follows. -->
    <Compile Include="IdlCodegenRefusalTests.fs" />
    <!-- Phase 129 — the other half of the same property: the WORKING COPY's line endings,
         measured by shelling git's own tracked-file listing through ChildProcess.fs. After
         that helper, and it reads nothing else here. -->
    <Compile Include="WorkingCopyEolTests.fs" />
    <!-- Phase 127 — the one classifier entry point over an IDL pair, the F# consequence
         table beside the wire severity, and the wire-profile bump. Two legs spawn the real
         compiler over the generator's output, so it needs ChildProcess.fs above; it reads the
         committed CLI fixtures through Snapshots.repoFile. Appended here (append-only
         registration) — it depends on nothing else in this list. -->
    <Compile Include="IdlStabilityClassTests.fs" />
    <!-- Phase 130 — the corpus lookup proved from a second worktree of this repository
         (created and removed by the test), beside the go-red that shows the climb it
         replaced finding nothing from the same place. Spawns git through ChildProcess.fs
         and reads Snapshots.fs for the repository root. Appended here (append-only
         registration) — it depends on nothing else in this list. -->
    <Compile Include="SiblingCorpusTests.fs" />
    <!-- Phase 144 — the claims ladder (/proofs.json) held to the tree: the theorem a proved row
         names is a top-level declaration of the model it names, that model is one the proof leg
         checks, a tested row's cases are in the test tree, every checked module has a row, and the
         phase citations and levels are the closed forms. Reads the Proofs.Oracle test TREE for the
         case names, so it compiles after ProofOracleTests.fs, and Snapshots.fs for the repository
         root. Appended here (append-only registration) — nothing else in this list reads it. -->
    <Compile Include="ProofsLadderTests.fs" />
    <!-- Phase 150 - the F* proof-model target's refusals, its expressibility partition over
         the pinned vocabulary, and the GENERATION DIFF that holds the two committed `.fst`
         artefacts to a fresh generation from `idl.json` - the oracle's extraction diff, one
         step further up. Reads SiblingCorpus.fs for the corpus and Snapshots.fs for the
         repository root, so after both; Program.fs calls its `emit` for the `emit-fstar`
         mode, so before that. Appended (append-only registration). -->
    <Compile Include="IdlFStarTargetTests.fs" />
    <!-- Phase 178 - the hardening policy's UNDECLARED half: the per-member refusal, and the
         guard over the compat promise the flip this phase STOPPED would have broken (an
         artifact with no `harden` block reads back as the default). Reads ReferenceIdl.fs
         for the fully-declared fixture, so after it. Appended (append-only registration). -->
    <Compile Include="IdlTrustTests.fs" />
    <!-- Phase 179 - the artifact ALWAYS carries its `harden` block: the unconditional
         render, the pinned render of `Undeclared`, the round trip with the block, and the
         diff classifier run over pre-179 and post-179 bytes to measure the additive class
         rather than assert it. Reads ReferenceIdl.fs for the fixture and the diff
         classifier from Fuaran.Core.Idl.Codegen, so after both. Appended here
         (append-only registration) - nothing else in this list reads it. -->
    <Compile Include="IdlArtifactTests.fs" />
    <!-- Phase 184 — the law-family roster held to the tree: reflection over the shipped
         assembly BY RETURN TYPE, each record's witness re-derived from its own signature,
         opt-in read off the aggregates' bodies, and the discharge relation held equal to the
         claims ladder's. Here rather than beside SampleAdequacyTests because it also owns the
         two generated artefacts and their `emit-families` freshness legs; it reads nothing
         from another test module, so the position is free. -->
    <Compile Include="ConformanceFamiliesTests.fs" />
    <!-- Phase 185 — the Fable smoke's membership derived rather than remembered: every packable
         project under src/ is compiled by tests/fable-smoke or carries an exclusions.json entry
         with a reason, checked in both directions so a stale reason fails too. Reads Snapshots.fs
         for the repository root and the two smoke files off disk; it references no other test
         module, so it is appended here (append-only registration). -->
    <Compile Include="FableSmokeCompletenessTests.fs" />
    <!-- Phase 199 — the package roster held to the tree: the README table's rows equal the
         packable projects under src/, nothing packable sits outside that scope, STABILITY.md
         carries an entry header naming the standing <Version>, and no draft-slot preamble
         denies a tag the repository holds. Spawns git through ChildProcess.fs above and
         reads no other test module, so the position is free; appended at the end of the
         list (append-only registration). -->
    <Compile Include="PackageRosterTests.fs" />
    <!-- Phase 183 — the committed public-surface baseline per package: the renderer over IL
         metadata, the baseline diff, and the classifier that tells a record/union/interface
         widening from ordinary additive growth. Reads PackageRosterTests.fs above for the ONE
         derivation of "what ships" and Snapshots.fs for the repository root, so it follows
         both; appended at the end of the list (append-only registration). -->
    <Compile Include="PublicSurfaceTests.fs" />
    <!-- Phase 206 — the wall-clock scaling gate: a RATIO between two row counts for the reference
         evaluator, `Delta.diff` and the incremental refresh, plus the inequality the incremental
         seam exists to make (a restricted refresh beats the full evaluation on the clock). Reads
         no other test module — it builds its own tables — so it is appended at the end of the
         list (append-only registration). -->
    <Compile Include="ScalingTests.fs" />
    <Compile Include="IncrementalTopNTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fuaran.Core.Tree\Fuaran.Core.Tree.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Ops\Fuaran.Core.Ops.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.OpStream\Fuaran.Core.OpStream.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Wire\Fuaran.Core.Wire.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Validator\Fuaran.Core.Validator.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Observer\Fuaran.Core.Observer.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Function\Fuaran.Core.Function.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Conformance\Fuaran.Core.Conformance.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.OpStream.Dag\Fuaran.Core.OpStream.Dag.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Column\Fuaran.Core.Column.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.DataFrame\Fuaran.Core.DataFrame.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Column.Ops\Fuaran.Core.Column.Ops.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Query\Fuaran.Core.Query.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Idl\Fuaran.Core.Idl.fsproj" />
    <!-- The suite certifies BOTH halves: the model / codec / sampler / sanitisation floor
         from Fuaran.Core.Idl, and the emitters + trust boundary + diff classifier from
         Fuaran.Core.Idl.Codegen (the compiled-codegen drift guard, the schema leg, the
         cross-host fuzz). It is the one consumer that legitimately wants everything. -->
    <ProjectReference Include="..\..\src\Fuaran.Core.Idl.Codegen\Fuaran.Core.Idl.Codegen.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Idl.Spike\Fuaran.Core.Idl.Spike.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.AiSurface\Fuaran.Core.AiSurface.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Projection\Fuaran.Core.Projection.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Propagation\Fuaran.Core.Propagation.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Lease\Fuaran.Core.Lease.fsproj" />
    <!-- Phase 131 — the F*-extracted oracle (never packed; see proofs/README.md). -->
    <ProjectReference Include="..\..\proofs\oracle\Fuaran.Core.Proofs.Oracle.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Expecto" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>
</Project>
