<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Reference.fs" />
    <Compile Include="Reference2.fs" />
    <!-- The `Hash` pin suite — the FIPS 180-4 known-answer vectors and platform byte-equality for
         SHA-256, plus the pinned FNV-1a values. First: everything below folds through one or the
         other, so a digest defect should surface as itself rather than as a downstream mismatch. -->
    <Compile Include="HashTests.fs" />
    <Compile Include="TreeTests.fs" />
    <Compile Include="TreeExtTests.fs" />
    <Compile Include="OpsTests.fs" />
    <Compile Include="CanApplyTests.fs" />
    <Compile Include="ContainedOpsTests.fs" />
    <Compile Include="InvertTests.fs" />
    <Compile Include="DiffTests.fs" />
    <Compile Include="OpStreamTests.fs" />
    <Compile Include="IdempotentAppendTests.fs" />
    <Compile Include="SnapshotTests.fs" />
    <Compile Include="WireTests.fs" />
    <Compile Include="DecodeTests.fs" />
    <Compile Include="ValidatorTests.fs" />
    <Compile Include="ObserverTests.fs" />
    <Compile Include="FunctionTests.fs" />
    <Compile Include="EffectAuditTests.fs" />
    <Compile Include="SchemaTests.fs" />
    <Compile Include="ConformanceTests.fs" />
    <Compile Include="FootprintTests.fs" />
    <Compile Include="ConcurrencyTests.fs" />
    <Compile Include="WitnessLawTests.fs" />
    <Compile Include="WitnessSurfaceTests.fs" />
    <Compile Include="ReducerTests.fs" />
    <Compile Include="DagTests.fs" />
    <Compile Include="ProvenanceTests.fs" />
    <Compile Include="ColumnTests.fs" />
    <Compile Include="DataFrameTests.fs" />
    <Compile Include="ColumnOpsTests.fs" />
    <!-- Phase 98 — the column layer's typed delta: the algebra laws, the wire, and the
         reference identity witness. After the columnar suites it builds on. -->
    <Compile Include="DeltaTests.fs" />
    <!-- Phase 99 — the incremental evaluation seam: the generated equivalence family, the
         measured footprints, and one case per way out of the incremental path. -->
    <Compile Include="IncrementalTests.fs" />
    <Compile Include="QueryTests.fs" />
    <Compile Include="Snapshots.fs" />
    <Compile Include="IdlSpikeTests.fs" />
    <Compile Include="UiIdl.fs" />
    <Compile Include="IdlUiTests.fs" />
    <!-- Phase 696 — the canonical `idl.json` spec artifact: its emit leg (driven by the
         emit-idl switch in Program.fs) and the regenerate-and-byte-compare drift guard. -->
    <Compile Include="IdlArtifactTests.fs" />
    <!-- Phase 317 real-tier compiled codegen: the committed generated module (emitted by
         Fuaran.Core.Idl.Gen from uiIdl; drift-guarded) + its byte-identity test.
         UiHostPrelude.fs stubs the consuming tier's `Fuaran.UI.HostPrelude` (THosted
         slot types + codecs) so the generated module compiles here too. -->
    <Compile Include="UiHostPrelude.fs" />
    <!-- Phase 945: the declared-support record (docs / splices / the Switch host
         projection) the UI emission is generated WITH - reads Gen.GenSupport, so after
         the Idl reference, before the drift guard and the regen entry that pass it. -->
    <Compile Include="UiIdlSupport.fs" />
    <Compile Include="UiGenerated.fs" />
    <Compile Include="IdlUiGenTests.fs" />
    <Compile Include="IdlEnumWireTests.fs" />
    <Compile Include="IdlSchemaTests.fs" />
    <Compile Include="IdlOpTests.fs" />
    <!-- Phase 700 — the diff classifier over two `idl.json` revisions. Named
         IdlDiffTests, not DiffTests: the latter is Phase 245's TREE diff. -->
    <Compile Include="IdlDiffTests.fs" />
    <Compile Include="VersioningTests.fs" />
    <Compile Include="AiSurfaceTests.fs" />
    <Compile Include="ProjectionTests.fs" />
    <Compile Include="PropagationTests.fs" />
    <Compile Include="LeaseTests.fs" />
    <Compile Include="MergeTests.fs" />
    <Compile Include="ArbitrationTests.fs" />
    <!-- Phase 698 - the full-vocabulary generative cross-host fuzz (interpreter vs
         generated F# vs generated TypeScript). Appended at the end of the list: it
         reads UiIdl.fs + UiGenerated.fs, so it must compile after both. -->
    <Compile Include="IdlFullVocabularyFuzzTests.fs" />
    <!-- Phase 102 - the null-tolerant read: the conformance family plus the
         strict-parser-unchanged pins. Appended at the end of the list; it depends on
         nothing here. -->
    <Compile Include="WireNullToleranceTests.fs" />
    <!-- Phase 100 - the fold-confluence pack: N-lane arrival-order invariance over the
         reference witness, a second non-tree domain, and the order-sensitive go-red case.
         Depends on nothing here either, so it simply follows. -->
    <Compile Include="FoldConfluenceTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fuaran.Core.Tree\Fuaran.Core.Tree.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Ops\Fuaran.Core.Ops.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.OpStream\Fuaran.Core.OpStream.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Wire\Fuaran.Core.Wire.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Validator\Fuaran.Core.Validator.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Observer\Fuaran.Core.Observer.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Function\Fuaran.Core.Function.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Conformance\Fuaran.Core.Conformance.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.OpStream.Dag\Fuaran.Core.OpStream.Dag.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Column\Fuaran.Core.Column.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.DataFrame\Fuaran.Core.DataFrame.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Column.Ops\Fuaran.Core.Column.Ops.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Query\Fuaran.Core.Query.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Idl\Fuaran.Core.Idl.fsproj" />
    <!-- The suite certifies BOTH halves: the model / codec / sampler / sanitisation floor
         from Fuaran.Core.Idl, and the emitters + trust boundary + diff classifier from
         Fuaran.Core.Idl.Codegen (the compiled-codegen drift guard, the schema leg, the
         cross-host fuzz). It is the one consumer that legitimately wants everything. -->
    <ProjectReference Include="..\..\src\Fuaran.Core.Idl.Codegen\Fuaran.Core.Idl.Codegen.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Idl.Spike\Fuaran.Core.Idl.Spike.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.AiSurface\Fuaran.Core.AiSurface.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Projection\Fuaran.Core.Projection.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Propagation\Fuaran.Core.Propagation.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Lease\Fuaran.Core.Lease.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Expecto" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>
</Project>
