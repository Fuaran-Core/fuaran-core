<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Phase 255 - an XML doc comment that does not parse fails this build (the generated
         DocAnnotatedGenerated.fs is the subject); Directory.Build.props already turns 3390 on. -->
    <WarningsAsErrors>$(WarningsAsErrors);FS3390</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Phase 396 - the ONE reading of the approval switches (CORE_APPROVE_*, FUARAN_REGEN). Registered first:
         every family below that regenerates a committed artefact reads it, and it reads nothing here. -->
    <Compile Include="Approval.fs" />
    <Compile Include="Reference.fs" />
    <Compile Include="Reference2.fs" />
    <!-- Phase 257 — the law-family roster as the suite reads it (one share since Phase 258 moved
         the dataframe share out). Early, because every roster and census check below reads it. -->
    <Compile Include="KitRoster.fs" />
    <!-- The `Hash` pin suite — the FIPS 180-4 known-answer vectors and platform byte-equality for
         SHA-256, plus the pinned FNV-1a values. First: everything below folds through one or the
         other, so a digest defect should surface as itself rather than as a downstream mismatch. -->
    <Compile Include="HashTests.fs" />
    <Compile Include="TreeTests.fs" />
    <Compile Include="TreeExtTests.fs" />
    <Compile Include="OpsTests.fs" />
    <Compile Include="CanApplyTests.fs" />
    <Compile Include="ContainedOpsTests.fs" />
    <Compile Include="InvertTests.fs" />
    <Compile Include="DiffTests.fs" />
    <Compile Include="ContentDiffTests.fs" />
    <Compile Include="OpStreamTests.fs" />
    <Compile Include="IdempotentAppendTests.fs" />
    <Compile Include="SnapshotTests.fs" />
    <Compile Include="WireTests.fs" />
    <Compile Include="DecodeTests.fs" />
    <Compile Include="ValidatorTests.fs" />
    <Compile Include="ObserverTests.fs" />
    <Compile Include="FunctionTests.fs" />
    <Compile Include="EffectAuditTests.fs" />
    <Compile Include="SchemaTests.fs" />
    <Compile Include="ConformanceTests.fs" />
    <Compile Include="TreeLawsTests.fs" />
    <Compile Include="PlacementTests.fs" />
    <Compile Include="KeyedApplyTests.fs" />
    <Compile Include="StreamLawsTests.fs" />
    <Compile Include="IntegrityLawsTests.fs" />
    <Compile Include="FootprintTests.fs" />
    <Compile Include="ConcurrencyTests.fs" />
    <Compile Include="SeamLawsTests.fs" />
    <Compile Include="FunctionLawsTests.fs" />
    <Compile Include="PropagationLawsTests.fs" />
    <Compile Include="SurfaceLawsTests.fs" />
    <Compile Include="WitnessLawTests.fs" />
    <Compile Include="WitnessSurfaceTests.fs" />
    <Compile Include="ReducerTests.fs" />
    <Compile Include="DagTests.fs" />
    <Compile Include="ReachTests.fs" />
    <Compile Include="CheckpointTests.fs" />
    <Compile Include="LaneTests.fs" />
    <Compile Include="ProvenanceTests.fs" />
    <Compile Include="ColumnTests.fs" />
    <Compile Include="QueryTests.fs" />
    <Compile Include="RegistryLifecycleTests.fs" />
    <Compile Include="SeamModelTests.fs" />
    <Compile Include="Snapshots.fs" />
    <!-- Phase 396 - the sweep holding every approval site to Approval.fs. Reads Snapshots.fs for the repository root. -->
    <Compile Include="ApprovalTests.fs" />
    <!-- Pins the UTF-8 decoding of a redirected child's stdout, so the cross-host
         suites below do not depend on the console code page the runner inherited.
         Before its first consumer; it references nothing here. -->
    <Compile Include="ChildProcess.fs" />
    <!-- Phase 172 — where the conformance families THIS repository emits live (the committed
         conformance/ directory) and the registry's fingerprint equality their published copies
         are held to. Reads Snapshots.fs above for the repo-root marker and nothing else here.
         Before SiblingCorpus.fs, which is its counterpart for the corpus another repository
         owns, and before every exporter and suite that reads the owned files. -->
    <Compile Include="OwnedConformance.fs" />
    <!-- Phase 130 — the one lookup for the shared conformance corpus, anchored at the
         repository's MAIN working tree (git's own common-dir question) so a linked worktree
         resolves what the main tree resolves, and loud rather than silent when the corpus
         is absent. Phase 172 put the opt-in gate (FUARAN_CORE_CORPUS_FRESHNESS) in front of
         it: the live-corpus legs run only when asked for, and fail as before once they are.
         Before its consumers (the nodes/ drift guard below, the proof-oracle pools, the laws/
         and apply/ copy-freshness legs further down); reads ChildProcess.fs above and nothing
         else here. -->
    <Compile Include="SiblingCorpus.fs" />
    <!-- Phase 230 — the mini IDL and the F# emitted from it, carried here when the spike
         project left `src/`. They are the fixtures IdlSpikeTests, IdlProposalTests and the
         certification and end-of-line families read, so they sit before every one of them. -->
    <Compile Include="MiniIdl.fs" />
    <Compile Include="MiniGenerated.fs" />
    <Compile Include="IdlSpikeTests.fs" />
    <Compile Include="IdlEnumWireTests.fs" />
    <!-- Phases 108/109 - the declared wire shape (discriminator key + node envelope),
         exercised on the axes the readiness spikes do not cover. -->
    <Compile Include="IdlWireShapeTests.fs" />
    <!-- Phase 113 - declared annotations on union cases and fields: the wire is
         untouched, every other surface renders them. Appended here (append-only
         registration), after the wire-shape family it shares its fixture shape with. -->
    <Compile Include="IdlAnnotationTests.fs" />
    <Compile Include="IdlKindAnnotationTests.fs" />
    <!-- Phase 255 - the authored doc annotation. DocAnnotatedGenerated.fs is the F# emitted
         from IdlDocAnnotationTests' vocabulary, committed and compiled here so that FS3390 (an
         invalid XML doc comment) is an ERROR against it; the test file holds its drift guard. -->
    <Compile Include="DocAnnotatedGenerated.fs" />
    <Compile Include="IdlDocAnnotationTests.fs" />
    <!-- Phase 702 — the vocabulary-change proposal document and the branchless spike
         that prices it (the harness lives in Fuaran.Core.Idl.Cli since Phase 230). Reads
         MiniIdl.fs, so after the Idl families above. -->
    <Compile Include="IdlProposalTests.fs" />
    <Compile Include="VersioningTests.fs" />
    <Compile Include="AiSurfaceTests.fs" />
    <Compile Include="PolicyGateTests.fs" />
    <Compile Include="ProjectionTests.fs" />
    <Compile Include="DigestTests.fs" />
    <Compile Include="SmallSeamsTests.fs" />
    <Compile Include="PropagationTests.fs" />
    <Compile Include="PropagationContractTests.fs" />
    <Compile Include="PropagationCompositionTests.fs" />
    <!-- Phase 317 — the remaining algebra symmetries: Schema.patch, propagation pull, the index carried through an edit. -->
    <Compile Include="AlgebraSymmetryTests.fs" />
    <Compile Include="MergeTests.fs" />
    <Compile Include="ArbitrationTests.fs" />
    <Compile Include="KeyedArbitrationTests.fs" />
    <Compile Include="KeyedSlotFoldTests.fs" />
    <Compile Include="SlotFootprintTests.fs" />
    <Compile Include="LightSetTests.fs" />
    <!-- Phase 102 - the null-tolerant read: the conformance family plus the
         strict-parser-unchanged pins. Appended at the end of the list; it depends on
         nothing here. -->
    <Compile Include="WireNullToleranceTests.fs" />
    <!-- Phase 287 — one string escaping on the spine: the StringEscapeVectors family, its go-red,
         the acceptance bytes, and the legacyEscapeConfig chain migration. Depends on nothing here. -->
    <Compile Include="StringEscapeTests.fs" />
    <!-- Phase 366 — the string parser reads by runs: an exhaustive run-boundary sweep against the
         one-unit-at-a-time reader, every refusal's kind, message and position pinned, and a go-red.
         Depends on nothing here. -->
    <Compile Include="StringParseRunTests.fs" />
    <!-- Phase 100 - the fold-confluence pack: N-lane arrival-order invariance over the
         reference witness, a second non-tree domain, and the order-sensitive go-red case.
         Depends on nothing here either, so it simply follows. -->
    <Compile Include="FoldConfluenceTests.fs" />
    <Compile Include="ReconcileShapeTests.fs" />
    <!-- Phase 249 — footprintLawsAt at a domain's own ops (the keyed reference and the plan domain)
         and FoldConfluence.laneDag. Reads ConformanceTests' keyed reference and FoldConfluenceTests'
         plan domain, so it follows both. -->
    <Compile Include="FootprintLawsAtTests.fs" />
    <!-- Phase 139 — the `apply/` corpus family: the host-neutral skeleton envelope, its codec,
         and the emitter behind the `emit-apply` flag. It sits HERE rather than beside the other
         corpus exporters further down because ProofOracleTests.fs below reads its decoder, to run the
         Phase 138 preservation differential over the committed fixtures as a second host beside
         the generator. Reads Reference.fs and the kit, and nothing else here. -->
    <Compile Include="ApplyVectorExport.fs" />
    <!-- Phase 131 — the F* oracle as a corpus host: the extracted model of the DAG fold run
         beside the production Dag.reconcileMany over the Phase 100 lane generators (which it
         reads from FoldConfluenceTests.fs above) and over the wire corpus's ops/ fixtures. -->
    <Compile Include="ProofOracleTests.fs" />
    <!-- Phase 301 — the bridge for Chain.fst sections 7b/7c (the compacted stream, the capture journal);
         ProofsLadderTests.fs below reads its case names. -->
    <Compile Include="ProofOracleCompactedTests.fs" />
    <!-- The second-vocabulary readiness spike - throwaway measurement code, kept for its
         findings. Declares a slice of a foreign vocabulary against the IDL and certifies it
         against a corpus of sample documents written in that vocabulary's wire shape,
         vendored at fixtures/second-domain/ so the legs run in any clone. Reads nothing
         here, so it simply follows. -->
    <!-- Phases 108/109 - the second-vocabulary slice's generated F# module in its
         DECLARED wire shape (kind discriminator, flat envelope). AUTO-GENERATED:
         regenerate via the regen-snapshots entry point; the drift guard in
         SecondDomainSpike.fs fails when it and the generator disagree. -->
    <Compile Include="DocGenerated.fs" />
    <Compile Include="SecondDomainSpike.fs" />
    <!-- The third-vocabulary (score-shaped) readiness spike - same posture as the second:
         throwaway measurement code, kept for its findings. Certifies a score-shaped slice
         against samples vendored at fixtures/score-domain/. -->
    <Compile Include="ScoreDomainSpike.fs" />
    <!-- Phase 114 - the engine's own domain-neutral reference VOCABULARY (the D7
         reference-witness posture applied to the IDL) plus its declared-support
         document, and the certification that runs over it and the two vendored foreign
         vocabularies. Appended at the end of the list: the certification enumerates
         which leg each neutral vocabulary carries, so it must follow both spikes. -->
    <Compile Include="ReferenceIdl.fs" />
    <Compile Include="IdlCertificationTests.fs" />
    <!-- Phase 700 — the diff classifier over two `idl.json` revisions. Named
         IdlDiffTests, not DiffTests: the latter is Phase 245's TREE diff. Moved
         here by Phase 123: its scale cases read the reference vocabulary now that
         the UI fixture has left, so it compiles after ReferenceIdl.fs. -->
    <Compile Include="IdlDiffTests.fs" />
    <Compile Include="SampleAdequacyTests.fs" />
    <!-- Phase 118 - the .NET pin of the cross-pipeline vector table. The table itself is public in
         Fuaran.Core.Conformance since Phase 217 (`ParityVectors`), so this pins the very module a
         Fable consumer runs on both pipelines. Reads nothing here, so it simply follows. -->
    <Compile Include="ParityVectorTests.fs" />
    <!-- The host-neutral export of the transform-parity family's reference answers, and the
         checks that keep it an oracle: the law over the declared sample, a decode-and-recompute
         pass over every rendered vector, and the comparison against the shared corpus when it is
         checked out alongside. Reads nothing here, so it simply follows. -->
    <Compile Include="LawVectorExport.fs" />
    <Compile Include="LawVectorTests.fs" />
    <!-- Phase 139 — the checks that keep the `apply/` family an oracle: a decode-and-recompute
         pass over every rendered vector, three go-reds proving the pass can fail, the sample's
         adequacy to its own description, and the byte comparison against the shared corpus.
         Reads ApplyVectorExport.fs above and SiblingCorpus.fs; appended beside the sibling
         law-vector family it mirrors. -->
    <Compile Include="ApplyVectorTests.fs" />
    <!-- Phase 126 — the construct-then-encode family over the reference witness: the authoring
         surface certified, and the go-red on a constructor that widens a field the encoder does
         not expect. Reads only Reference.fs and the kit, so it simply follows. -->
    <Compile Include="ConstructThenEncodeTests.fs" />
    <!-- Phase 129 — the generated artefact's line endings are the generator's, not those of
         whichever checkout compiled it. Reads only the spike vocabulary from the src project,
         so it simply follows. -->
    <Compile Include="IdlCodegenEolTests.fs" />
    <!-- Phase 195 — the codegen's refusals as DATA: the required node-envelope member, the
         op-vocabulary slot in each backend that meets it, the HostOnly slot with no placeholder
         and the transparent case of the wrong arity. Declares its own one-kind vocabularies and
         reads only the emitters from the src project, so it simply follows. -->
    <Compile Include="IdlCodegenRefusalTests.fs" />
    <!-- Phase 129 — the other half of the same property: the WORKING COPY's line endings,
         measured by shelling git's own tracked-file listing through ChildProcess.fs. After
         that helper, and it reads nothing else here. -->
    <Compile Include="WorkingCopyEolTests.fs" />
    <!-- Phase 127 — the one classifier entry point over an IDL pair, the F# consequence
         table beside the wire severity, and the wire-profile bump. Two legs spawn the real
         compiler over the generator's output, so it needs ChildProcess.fs above; it reads the
         committed CLI fixtures through Snapshots.repoFile. Appended here (append-only
         registration) — it depends on nothing else in this list. -->
    <Compile Include="IdlStabilityClassTests.fs" />
    <!-- Phase 130 — the corpus lookup proved from a second worktree of this repository
         (created and removed by the test), beside the go-red that shows the climb it
         replaced finding nothing from the same place. Spawns git through ChildProcess.fs
         and reads Snapshots.fs for the repository root. Appended here (append-only
         registration) — it depends on nothing else in this list. -->
    <Compile Include="SiblingCorpusTests.fs" />
    <!-- Phase 144 — the claims ladder (/proofs.json) held to the tree: the theorem a proved row
         names is a top-level declaration of the model it names, that model is one the proof leg
         checks, a tested row's cases are in the test tree, every checked module has a row, and the
         phase citations and levels are the closed forms. Reads the Proofs.Oracle test TREE for the
         case names, so it compiles after ProofOracleTests.fs, and Snapshots.fs for the repository
         root. Appended here (append-only registration) — nothing else in this list reads it. -->
    <Compile Include="ProofsLadderTests.fs" />
    <!-- Phase 150 - the F* proof-model target's refusals, its expressibility partition over
         the pinned vocabulary, and the GENERATION DIFF that holds the two committed `.fst`
         artefacts to a fresh generation from `idl.json` - the oracle's extraction diff, one
         step further up. Reads SiblingCorpus.fs for the corpus and Snapshots.fs for the
         repository root, so after both; Program.fs calls its `emit` for the `emit-fstar`
         mode, so before that. Appended (append-only registration). -->
    <Compile Include="IdlFStarTargetTests.fs" />
    <!-- Phase 178 - the hardening policy's UNDECLARED half: the per-member refusal, and the
         guard over the compat promise the flip this phase STOPPED would have broken (an
         artifact with no `harden` block reads back as the default). Reads ReferenceIdl.fs
         for the fully-declared fixture, so after it. Appended (append-only registration). -->
    <Compile Include="IdlTrustTests.fs" />
    <!-- Phase 179 - the artifact ALWAYS carries its `harden` block: the unconditional
         render, the pinned render of `Undeclared`, the round trip with the block, and the
         diff classifier run over pre-179 and post-179 bytes to measure the additive class
         rather than assert it. Reads ReferenceIdl.fs for the fixture and the diff
         classifier from Fuaran.Core.Idl.Codegen, so after both. Appended here
         (append-only registration) - nothing else in this list reads it. -->
    <Compile Include="IdlArtifactTests.fs" />
    <!-- Phase 184 — the law-family roster held to the tree: reflection over the shipped
         assembly BY RETURN TYPE, each record's witness re-derived from its own signature,
         opt-in read off the aggregates' bodies, and the discharge relation held equal to the
         claims ladder's. Here rather than beside SampleAdequacyTests because it also owns the
         two generated artefacts and their `emit-families` freshness legs; it reads nothing
         from another test module, so the position is free. -->
    <!-- Phase 196 — every law family run once at the reference witness, with the measurement
         kept, so the roster's `cases` column is a run rather than a declaration. BEFORE
         ConformanceFamiliesTests.fs, which renders the generated artefacts from it, and after
         every test module whose witnesses and fixtures it reuses rather than duplicates. -->
    <!-- Phase 246 — the witness-taking families, their planted defects, and the reference seam
         witnesses the census below runs them over. BEFORE ConformanceVacuityTests.fs, which reuses
         those witnesses. -->
    <Compile Include="WitnessTakingFamiliesTests.fs" />
    <!-- Phase 313 — the structural-integrity strand and its reference grammar / reference
         witnesses, which the census below runs the two families over. -->
    <Compile Include="StructuralIntegrityTests.fs" />
    <Compile Include="ConformanceVacuityTests.fs" />
    <Compile Include="ConformanceFamiliesTests.fs" />
    <!-- Phase 185, retargeted by Phase 217 — the Fable surface's membership derived rather than
         remembered: every packable project under src/ ships the `fable/` source distribution or
         carries a `fable-exclusions.json` entry with a reason, checked in both
         directions so a stale reason fails too. The Fable COMPILE of that surface runs in the consumer that owns
         the toolchain (STABILITY.md "Fable cleanliness"). Reads Snapshots.fs for the repository
         root and the project files off disk; it references no other test module. -->
    <Compile Include="FableSmokeCompletenessTests.fs" />
    <!-- Phase 199 — the package roster held to the tree: the README table's rows equal the
         packable projects under src/, nothing packable sits outside that scope, STABILITY.md
         carries an entry header naming the standing <Version>, and no draft-slot preamble
         denies a tag the repository holds. Spawns git through ChildProcess.fs above and
         reads no other test module, so the position is free; appended at the end of the
         list (append-only registration). -->
    <Compile Include="PackageRosterTests.fs" />
    <!-- Phase 183 — the committed public-surface baseline per package: the renderer over IL
         metadata, the baseline diff, and the classifier that tells a record/union/interface
         widening from ordinary additive growth. Reads PackageRosterTests.fs above for the ONE
         derivation of "what ships" and Snapshots.fs for the repository root, so it follows
         both; appended at the end of the list (append-only registration). -->
    <Compile Include="PublicSurfaceTests.fs" />
    <!-- Phase 257, made an assertion of ABSENCE by Phase 258 — the compute boundary: no project,
         package reference or built spine assembly names DataFrame, Column.Ops or the two
         assemblies cut beside them. After PublicSurfaceTests, whose assembly locator it reuses. -->
    <Compile Include="ComputeBoundaryTests.fs" />
    <!-- Phase 201 — defaults-fill on decode stated as a LAW (fill on absence, re-encode
         ABSENT, carry a present non-default), held in every decoder leg the generator
         emits; the full `WIRE_FORMAT.md` §3.1 node envelope declared, host-only members
         included; and the regeneration proof over the three neutral vocabularies, so it
         reads ReferenceIdl.fs, SecondDomainSpike.fs and ScoreDomainSpike.fs and must
         follow all three. Appended at the end of the list (append-only registration). -->
    <Compile Include="IdlEnvelopeTests.fs" />
    <!-- Phase 292 - Declare.errors at every loading path, the SourceLit escaper, and a total
         codec and sampler. Reads MiniIdl.fs, ReferenceIdl.fs, both spikes, IdlDocAnnotationTests.fs
         and Snapshots.fs, so it follows all of them. -->
    <Compile Include="IdlValidationTests.fs" />
    <!-- Phase 203 — "exhaustively proved" as a gate predicate: every packable package is named by
         a model or carries a declared exclusion, every assumed row is accounted for by its class,
         and every differential is paired to a theorem. Reads PackageRosterTests.fs above for the
         ONE derivation of "what ships" and Snapshots.fs for the repository root, so it follows
         both; appended at the end of the list (append-only registration). -->
    <Compile Include="ProofCoverageTests.fs" />
    <!-- Phase 214 — the committed WIRE-surface baseline per wire-bearing package (api/wire/): a
         document set derived by reflection to reach every member and discriminator, its canonical
         bytes, and the classifier that states a move's class in the baseline's header. Reads
         PublicSurfaceTests.fs (the tag ordering), PackageRosterTests.fs, AiSurfaceTests.fs and
         Snapshots.fs, so it follows all four; appended at the end of the list (append-only
         registration). -->
    <Compile Include="WireSurfaceTests.fs" />
    <!-- Phase 294 — the publication boundary swept: no tracked file, source comment to workflow,
         names anything a reader outside this public repository could not look up. The vocabulary is
         DATA (publication-boundary.json beside this project), so a change to what is banned is a
         change to a list. Reads Snapshots.fs for the repository root and ChildProcess.fs to ask git
         which files are tracked, and no other test module; appended at the end of the list
         (append-only registration). -->
    <Compile Include="PublicationBoundaryTests.fs" />

    <!-- Phase 290 — the KEY ROSTER: the list above `Hash.canonicalFields` held to `src/` both ways
         (every call site is a listed key, every listed key is a call site, no bare U+0001 join
         anywhere). Reads Snapshots.fs for the repository root; appended (append-only). -->
    <Compile Include="HashRosterTests.fs" />
    <!-- No unpaired surrogate spelled in a literal under src/ (the 0.34.0 release candidate's Fable gate). -->
    <Compile Include="SourceLiteralTests.fs" />

    <!-- Phase 299 — the codec refusal corpus (`conformance/refusals/`): the authored vectors, their
         emit-refusals renderer, and the test holding the committed files to a fresh render.
         Reads OwnedConformance.fs for the committed root; appended (append-only). -->
    <Compile Include="RefusalVectorTests.fs" />
    <Compile Include="TotalityTests.fs" />

    <!-- Phase 310 — the typed decode layer: the combinators, the forwards, the codecs' typed refusals and
         the refusal law, and the decode reject family (`conformance/decode/`) with its emit-decode
         renderer. Reads RefusalVectorTests.fs for the host roster; appended (append-only). -->
    <Compile Include="DecodeLayerTests.fs" />

    <!-- Phase 254 — every package carries its XML documentation file (read from the suite's own
         output, where each referenced project's file is copied), and every README claim of a surface
         carries the version it arrived in, derived from api/ at each release tag, with the README's
         Fable line held to the pins. Read PackageRosterTests.fs, SiblingCorpus.fs, ChildProcess.fs and
         Snapshots.fs; appended (append-only). -->
    <Compile Include="PackageDocsTests.fs" />
    <Compile Include="ReadmeClaimsTests.fs" />
    <!-- Phase 392 — "released" is a gate output: every tag at or above the entry floor is headed
         `released … as v<v>` (DRAFT over a tag is red by name), every released heading has its tag,
         the untagged standing version is headed DRAFT, and every released slot from 0.31.0 names its
         receiving-gate run in a fixed grammar. Reads PackageRosterTests.fs, ChildProcess.fs and
         Snapshots.fs; appended (append-only). -->
    <Compile Include="ReleaseRecordTests.fs" />

    <!-- Phase 303 — every certification vocabulary's generated F# module is COMPILED: the score
         vocabulary's (field-less kinds emit as marker types) and the reference vocabulary's under its
         declared support document, beside the host prelude that document names. AUTO-GENERATED by
         the regen-snapshots entry point; the drift guard in IdlThreeHostTests.fs fails when a
         committed module and the generator disagree. Then the standing three-way differential
         (interpreter / compiled F# / TypeScript under node) and the schema leg's validator
         certification. Read ReferenceIdl.fs and both spikes; appended (append-only). -->
    <Compile Include="ScoreGenerated.fs" />
    <Compile Include="ReferencePrelude.fs" />
    <Compile Include="ReferenceGenerated.fs" />
    <Compile Include="IdlThreeHostTests.fs" />
    <Compile Include="IdlSchemaValidatorTests.fs" />

    <!-- Phase 337 — the generated decoders refuse with the typed decode error. The decode vectors
         (conformance/decode/) as an IDL vocabulary, its generated F# module (AUTO-GENERATED by the
         regen-snapshots entry point, with a drift guard), and the cross-host refusal law: the
         interpreter, the compiled F# host and the TypeScript host refuse one malformed document
         with one code and one path. Reads ReferenceIdl.fs, both spikes and their generated
         modules; appended (append-only). -->
    <Compile Include="DecodeVectorsIdl.fs" />
    <Compile Include="DecodeVectorsGenerated.fs" />
    <Compile Include="RefusalCornersIdl.fs" />
    <Compile Include="RefusalCornersGenerated.fs" />
    <Compile Include="IdlRefusalHostTests.fs" />

    <!-- Phase 364 — the wire layer's clock leg and the freeze of the benchmark corpus. The corpus and
         its timing module are the harness's own files (benchmarks/), compiled here so the gate
         builds them and the leg times the corpus the tables time. Appended (append-only). -->
    <Compile Include="..\..\benchmarks\Fuaran.Core.Wire.Benchmarks\Corpus.fs" Link="WireBench/Corpus.fs" />
    <Compile Include="..\..\benchmarks\Fuaran.Core.Wire.Benchmarks\Harness.fs" Link="WireBench/Harness.fs" />
    <Compile Include="WireClockLeg.fs" />
    <!-- Phase 367 — the parsed-float check narrowed under Fable: every number outcome pinned against
         the pre-367 reader (value, or refusal kind, message and position), with a go-red. Depends on
         nothing here. Appended (append-only). -->
    <Compile Include="FloatLayoutCheckTests.fs" />
    <!-- Phase 360 — encoding profiles: the 0.30.0 stores, the frozen V1 renderer and its committed
         vectors, the two-witness rehash and the stored-id family. Appended (append-only). -->
    <Compile Include="EncodingProfileTests.fs" />
    <!-- Phase 368 — Json.Reader held to parseDetailed refusal for refusal, over the codec refusal
         corpus (reads RefusalVectorTests.fs), the wire benchmark corpora (reads WireBench/Corpus.fs)
         and a generated pool. Appended (append-only). -->
    <Compile Include="JsonReaderTests.fs" />
    <!-- Phase 369 — the op-stream line decoder reads by runs: every public route to
         Jsonl.decodeString pinned against the pre-369 one-unit decoder, each skipString fault
         and its position at run boundaries, and a go-red. Depends on nothing here. Appended
         (append-only). -->
    <Compile Include="JsonlDecodeRunTests.fs" />
    <!-- Phase 372 - Json.readInt32 refuses a token past ten significant digits before the platform
         reader: pinned against the pre-372 reader verbatim over the Int32 and int53 edges, leading
         zeros and generated tokens, with two go-red references. Reads WireBench/Corpus.fs. Appended
         (append-only). -->
    <Compile Include="ReadInt32DigitCountTests.fs" />
    <!-- Phase 374 - the structural derivations. A work-plan vocabulary that is not a UI one, its
         generated F# module with every derivation requested (AUTO-GENERATED by the regen-snapshots
         entry point, with a drift guard), and the laws each derivation is held to over the compiled
         module, the keyed go-red among them. Depends on nothing here. Appended (append-only). -->
    <Compile Include="DeriveIdl.fs" />
    <Compile Include="DeriveGenerated.fs" />
    <Compile Include="IdlDeriveTests.fs" />
    <!-- Phase 377 - the collecting decoders and the public per-spec entries. The reference
         vocabulary under its support document, with the decoders requested (AUTO-GENERATED by the
         regen-snapshots entry point, with a drift guard), beside the derivations module, which
         requests them too; the tests hold the collecting form to its order, its paths and its
         first-defect agreement with the short-circuiting form. Appended (append-only). -->
    <Compile Include="SpecDecodersIdl.fs" />
    <Compile Include="SpecDecodersGenerated.fs" />
    <Compile Include="IdlSpecDecoderTests.fs" />
    <!-- Phase 379 - Canonical and Codec<'T>: the committed bytes a declaration writes under each
         profile and the positive control, the collecting order and paths, the build-time refusals,
         the schema held to an independent validator, and the stored-codec family green and red.
         Depends on nothing here. Appended (append-only). -->
    <Compile Include="CodecTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
