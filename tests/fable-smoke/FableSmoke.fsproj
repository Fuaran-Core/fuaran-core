<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Fable-compilation smoke gate (Phase 54). This project exists only to be compiled by
    `dotnet fable` in `./verify.ps1`: a successful Fable compile of every PUBLIC Fuaran.Core
    package's encode + decode surface enforces the GP3 / STABILITY.md "Fable-clean on encode
    AND decode" claim in-repo, instead of leaving it to be discovered downstream. The emitted
    JS is throwaway (output dir is git-ignored); the COMPILE is the gate.
    MEMBERSHIP IS CHECKED, NOT REMEMBERED (Phase 185). The exclusions that used to be named in
    this comment are DATA now — `exclusions.json` beside this file, one entry per packable
    project that is deliberately off the surface, each with the reason and the phase that
    decided it. `Fuaran.Core.Tests.FableSmokeCompletenessTests` walks every `src/*/*.fsproj`
    whose `IsPackable` is not `false` and fails naming any that is neither referenced below nor
    listed there — so a newly-added package cannot join the published set while quietly missing
    this gate, which is exactly how `Column.Ops` and `Idl.Cli` came to be uncovered.
    `Fuaran.Core.Idl` IS on the surface, as of Phase 97: the split moved the source emitters
    (and their non-portable constructs) into Idl.Codegen, so the model, codec, sampler and
    sanitisation floor are gated here like every other public package.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Phase 689 — the GENERATED layer's shape, not the generator. `Fuaran.Core.Idl` and
      `Idl.Spike` stay off the Fable surface (they are build-time tools), but the artefact
      the generator EMITS is Fable-compiled downstream, so its shape has to be clean here.
      Since Phase 689 that shape includes `'Msg`-generic records holding function-typed
      fields inside a mutually-recursive `and` chain — the construct the whole programme
      rests on, and cheaper to disprove now than at adoption. LINKED rather than
      project-referenced, so no generator dependency enters the Fable compilation.
    -->
    <Compile Include="..\..\src\Fuaran.Core.Idl.Spike\Generated.fs" Link="SpikeGenerated.fs" />
    <!--
      Phase 118 — the cross-pipeline VALUE table. Compiled here so the transpiled side of the
      comparison is the same source the .NET side runs; `tests/Fuaran.Core.Tests` links this very
      file and pins the .NET values, and `parity.ps1` runs it under `node` and byte-compares.
    -->
    <Compile Include="ParityVectors.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fuaran.Core.Tree\Fuaran.Core.Tree.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Ops\Fuaran.Core.Ops.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.OpStream\Fuaran.Core.OpStream.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.OpStream.Dag\Fuaran.Core.OpStream.Dag.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Wire\Fuaran.Core.Wire.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Validator\Fuaran.Core.Validator.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Function\Fuaran.Core.Function.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Column\Fuaran.Core.Column.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.DataFrame\Fuaran.Core.DataFrame.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Query\Fuaran.Core.Query.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Conformance\Fuaran.Core.Conformance.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Projection\Fuaran.Core.Projection.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.AiSurface\Fuaran.Core.AiSurface.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Propagation\Fuaran.Core.Propagation.fsproj" />
    <!-- Phase 97 — the MODEL half of the IDL engine joins the Fable surface. It could not
         before: the project held the source emitters too, and their `StringBuilder` +
         `CultureInfo.InvariantCulture` are the reason the exclusion note above existed. With
         those in Fuaran.Core.Idl.Codegen, what remains — the model, the codec, the sampler,
         the sanitisation floor — has no obstacle, so the portability claim is gated here
         rather than asserted in a comment. Codegen stays off the surface, deliberately and
         permanently: it emits source and is build-time-only. -->
    <ProjectReference Include="..\..\src\Fuaran.Core.Idl\Fuaran.Core.Idl.fsproj" />
    <!-- Phase 185 — `Column.Ops` joins the surface. It was packable and absent from this list,
         so the package whose own Description ends "FSharp.Core only, Fable-clean" was the one
         public package making that claim with nothing behind it. Nothing blocked it: the
         compile is clean on the first attempt, which is the answer the exclusion comment this
         list replaced could not have given. -->
    <ProjectReference Include="..\..\src\Fuaran.Core.Column.Ops\Fuaran.Core.Column.Ops.fsproj" />
    <!-- Phase 185 — `Observer` joins the surface, correcting the exclusion rather than
         recording it. It sat in the old comment's exclusion list under "they are build-time
         tools", which is true of `Idl.Codegen` and false of this one: it is the RUNTIME
         verification seam, and its own header says "FSharp.Core only + Fable-clean … the same
         engine drives the in-memory .NET test substrate and a Fable-compiled host". A reason
         that does not hold is not a reason, and the alternative to gating it was writing that
         sentence down as data. -->
    <ProjectReference Include="..\..\src\Fuaran.Core.Observer\Fuaran.Core.Observer.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fable.Core" />
  </ItemGroup>
</Project>
