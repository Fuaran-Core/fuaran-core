<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Cross-pipeline VALUE probe. Deliberately NOT in Fuaran.Core.slnx and NOT wired into
    ./run.ps1 or ./verify.ps1: it needs a Node runtime, and the default gate stays
    dependency-free. Run it with ./run-parity-probe.ps1.

    It exists because the Fable step in ./verify.ps1 is a COMPILE gate, and a compile cannot
    disagree about a number. `Hash.fnv1a` was divergent between the two pipelines behind a fully
    green suite until 0.6.0 — see STABILITY.md "Hash-chain integrity posture". This project is the
    only thing in the repo that can catch that class, so it is kept rather than reconstructed.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Three references, because there are three FNV-1a implementations in the spine and the probe
      has to reach all of them: the canonical `Hash.fnv1a` in Tree, and the deliberate copies in
      OpStream (standalone by DECISIONS D2) and Column (references only Wire). The copies are the
      reason this probe covers more than one module — a fix that reached only the canonical one
      would leave the op-stream CHAIN hash divergent, which is how this was found.
    -->
    <ProjectReference Include="..\..\src\Fuaran.Core.Tree\Fuaran.Core.Tree.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.OpStream\Fuaran.Core.OpStream.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Column\Fuaran.Core.Column.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fable.Core" />
  </ItemGroup>
</Project>
